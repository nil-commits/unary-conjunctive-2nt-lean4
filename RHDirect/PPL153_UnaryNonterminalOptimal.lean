    , { lhs := 0, pos := [padConst 512], neg := [] }
    , { lhs := 0, pos := [padXX (rJez 0 + rJez 2), padXX (rJez 1 + rJez 1)], neg := [] }
    , { lhs := 0, pos := [padXX (rJez 0 + rJez 0), padXX (rJez 3 + rJez 1)], neg := [] }
