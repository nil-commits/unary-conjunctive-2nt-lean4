  · refine ⟨fun α hα => by simp only [List.mem_cons, List.not_mem_nil, or_false] at hα; subst hα; rw [constCount_padConst]; decide, by simp⟩
  · refine ⟨fun α hα => by simp only [List.mem_cons, List.not_mem_nil, or_false] at hα; subst hα; rw [constCount_padConst]; decide, by simp⟩
  · refine ⟨fun α hα => by simp only [List.mem_cons, List.not_mem_nil, or_false] at hα; subst hα; rw [constCount_padConst]; decide, by simp⟩
  · refine ⟨fun α hα => by simp only [List.mem_cons, List.not_mem_nil, or_false] at hα; subst hα; rw [constCount_padConst]; decide, by simp⟩
  · refine ⟨fun α hα => by simp only [List.mem_cons, List.not_mem_nil, or_false] at hα; subst hα; rw [constCount_padConst]; decide, by simp⟩
  · refine ⟨fun α hα => ?_, by simp⟩
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
    rcases hα with rfl | rfl <;> rw [constCount_padXX] <;> decide
  · refine ⟨fun α hα => ?_, by simp⟩
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
    rcases hα with rfl | rfl <;> rw [constCount_padXX] <;> decide
  · exact jezXRules_strictlyDecreasing r hrX

/-- The intended language of the auxiliary nonterminal `X` in both `grammarFourPow` and `grammarTwoPow`. -/
def jezXSet : Set ℕ :=
  { L | ∃ i : Fin 4, ∃ n ∈ jezLang i, L = 256 * n - rJez i }

/-- Core `B_4` intersection lemma for `jezXSet`:
for any two disjoint pairs `{a, b}` and `{c, d}` in `Fin 4` and any offset `s < min(r a + r b, r c + r d)`:
`L ∈ padXX (r a + r b - s) ∩ padXX (r c + r d - s)` holds iff
`∃ n, L = 256 * n - s ∧ n ∈ (jezLang a + jezLang b) ∩ (jezLang c + jezLang d)`. -/
lemma jez_inter_iff (U : Fin 2 → Set ℕ) (hU1 : U 1 = jezXSet)
    {a b c d : Fin 4} (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d)
    (s : ℕ) (hs1 : s ≤ rJez a + rJez b) (hs2 : s ≤ rJez c + rJez d) (L : ℕ) :
    (L ∈ evalUnaryForm U (padXX (rJez a + rJez b - s)) ∧
     L ∈ evalUnaryForm U (padXX (rJez c + rJez d - s))) ↔
    ∃ n : ℕ, L + s = 256 * n ∧
      (∃ u ∈ jezLang a, ∃ v ∈ jezLang b, n = u + v) ∧
      (∃ u ∈ jezLang c, ∃ v ∈ jezLang d, n = u + v) := by
  have hpad : ∀ d₀, L ∈ evalUnaryForm U (padXX d₀) ↔
      ∃ p q : Fin 4, ∃ u ∈ jezLang p, ∃ v ∈ jezLang q,
        L + rJez p + rJez q = d₀ + 256 * (u + v) := by
    intro d₀
    rw [evalUnaryForm_padXX, hU1]
    constructor
    · rintro ⟨x, ⟨p, u, hu, rfl⟩, y, ⟨q, v, hv, rfl⟩, rfl⟩
      have hup := jezLang_pos p hu; have hvq := jezLang_pos q hv
      have hrp : rJez p ≤ 256 * u := le_trans (le_of_lt (jez_b4_valid.lt_M p)) (Nat.le_mul_of_pos_right 256 hup)
      have hrq : rJez q ≤ 256 * v := le_trans (le_of_lt (jez_b4_valid.lt_M q)) (Nat.le_mul_of_pos_right 256 hvq)
      refine ⟨p, q, u, hu, v, hv, ?_⟩
      zify [hrp, hrq]; ring
    · rintro ⟨p, q, u, hu, v, hv, heq⟩
      have hup := jezLang_pos p hu; have hvq := jezLang_pos q hv
      have hrp : rJez p ≤ 256 * u := le_trans (le_of_lt (jez_b4_valid.lt_M p)) (Nat.le_mul_of_pos_right 256 hup)
      have hrq : rJez q ≤ 256 * v := le_trans (le_of_lt (jez_b4_valid.lt_M q)) (Nat.le_mul_of_pos_right 256 hvq)
      refine ⟨256 * u - rJez p, ⟨p, u, hu, rfl⟩, 256 * v - rJez q, ⟨q, v, hv, rfl⟩, ?_⟩
      zify [hrp, hrq] at heq ⊢; linarith
  rw [hpad, hpad]
  constructor
  · rintro ⟨⟨p₁, q₁, u₁, hu₁, v₁, hv₁, heq₁⟩, ⟨p₂, q₂, u₂, hu₂, v₂, hv₂, heq₂⟩⟩
    have he1 : L + rJez p₁ + rJez q₁ + s = rJez a + rJez b + 256 * (u₁ + v₁) := by omega
    have he2 : L + rJez p₂ + rJez q₂ + s = rJez c + rJez d + 256 * (u₂ + v₂) := by omega
    have hcross : (rJez p₁ + rJez q₁ + rJez c + rJez d) + 256 * (u₂ + v₂) =
                  (rJez p₂ + rJez q₂ + rJez a + rJez b) + 256 * (u₁ + v₁) := by omega
    have hmod : (rJez p₁ + rJez q₁ + rJez c + rJez d) % 256 =
                (rJez p₂ + rJez q₂ + rJez a + rJez b) % 256 := by
      have h := congrArg (· % 256) hcross
      simpa [Nat.add_mul_mod_self_left] using h
    have ⟨hpair1, hpair2⟩ := jez_b4_valid.cancel_disjoint hac had hbc hbd hmod
    have hr1 : rJez p₁ + rJez q₁ = rJez a + rJez b := by
      simpa using congrArg (Multiset.map rJez · |>.sum) hpair1
    have hr2 : rJez p₂ + rJez q₂ = rJez c + rJez d := by
      simpa using congrArg (Multiset.map rJez · |>.sum) hpair2
    have hLs : L + s = 256 * (u₁ + v₁) := by omega
    have huv_eq : u₁ + v₁ = u₂ + v₂ := by omega
    have hpair_mem : ∀ {p q x y : Fin 4} {u v : ℕ},
        ({p, q} : Multiset (Fin 4)) = {x, y} → u ∈ jezLang p → v ∈ jezLang q →
        ∃ u' ∈ jezLang x, ∃ v' ∈ jezLang y, u + v = u' + v' := by
      intro p q x y u v hpq hu hv
      have hmem : p ∈ ({x, y} : Multiset (Fin 4)) := by rw [← hpq]; simp
      simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hmem
      rcases hmem with rfl | rfl
      · have hq : q = y := Multiset.singleton_inj.mp (add_left_cancel
          (show ({p} : Multiset _) + {q} = {p} + {y} by simpa [Multiset.insert_eq_cons] using hpq))
        subst hq; exact ⟨u, hu, v, hv, rfl⟩
      · have hq : q = x := Multiset.singleton_inj.mp (add_left_cancel
          (show ({p} : Multiset _) + {q} = {p} + {x} by
            simpa [Multiset.insert_eq_cons] using hpq.trans (Multiset.pair_comm x p)))
        subst hq; exact ⟨v, hv, u, hu, Nat.add_comm u v⟩
    refine ⟨u₁ + v₁, hLs, hpair_mem hpair1 hu₁ hv₁, ?_⟩
    rw [huv_eq]; exact hpair_mem hpair2 hu₂ hv₂
  · rintro ⟨n, hLs, ⟨u₁, hu₁, v₁, hv₁, rfl⟩, ⟨u₂, hu₂, v₂, hv₂, huv2⟩⟩
    exact ⟨⟨a, b, u₁, hu₁, v₁, hv₁, by omega⟩, ⟨c, d, u₂, hu₂, v₂, hv₂, by omega⟩⟩

/-- Shared fixed-point equation for `X` (`U 1 = jezXSet`) under `jezXRules`. -/
lemma jezX_fixed_point (U : Fin 2 → Set ℕ) (hU1 : U 1 = jezXSet) :
    ∀ L : ℕ, L ∈ jezXSet ↔ ∃ r ∈ jezXRules, r.lhs = 1 ∧ L ∈ evalUnaryRule U r := by
  intro L
  have h1 := jez_inter_iff U hU1 (a := 0) (b := 2) (c := 1) (d := 1)
    (by decide) (by decide) (by decide) (by decide) (rJez 0) (by decide) (by decide) L
  have h2 := jez_inter_iff U hU1 (a := 0) (b := 0) (c := 3) (d := 1)
    (by decide) (by decide) (by decide) (by decide) (rJez 1) (by decide) (by decide) L
  have h3 := jez_inter_iff U hU1 (a := 0) (b := 1) (c := 3) (d := 3)
    (by decide) (by decide) (by decide) (by decide) (rJez 2) (by decide) (by decide) L
  have h4 := jez_inter_iff U hU1 (a := 2) (b := 2) (c := 1) (d := 0)
    (by decide) (by decide) (by decide) (by decide) (rJez 3) (by decide) (by decide) L
  simp only [jezXRules, evalUnaryRule, List.mem_cons, List.not_mem_nil, or_false, mem_ofPred_eq]
  constructor
  · rintro ⟨i, n, hn, rfl⟩
    fin_cases i
    · rcases hn with ⟨k, rfl⟩
      cases k with
      | zero =>
        refine ⟨_, Or.inl rfl, rfl, ?_, by simp⟩
        simp [evalUnaryForm_padConst]
      | succ k =>
        refine ⟨_, Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))), rfl, ?_, by simp⟩
        have hpos : 1 ≤ 4 ^ (k + 1) := Nat.one_le_pow _ 4 (by omega)
        have hpair := h1.mpr ⟨4 ^ (k + 1), by dsimp [rJez]; omega, (jez_A1_iff _).mpr ⟨k, rfl⟩⟩
        intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
        rcases hα with rfl | rfl; exact hpair.1; exact hpair.2
    · rcases hn with ⟨k, rfl⟩
      cases k with
      | zero =>
        refine ⟨_, Or.inr (Or.inl rfl), rfl, ?_, by simp⟩
        simp [evalUnaryForm_padConst]
      | succ k =>
        refine ⟨_, Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))), rfl, ?_, by simp⟩
        have hpos : 1 ≤ 4 ^ (k + 1) := Nat.one_le_pow _ 4 (by omega)
        have hpair := h2.mpr ⟨2 * 4 ^ (k + 1), by dsimp [rJez]; omega, (jez_A2_iff _).mpr ⟨k, rfl⟩⟩
        intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
        rcases hα with rfl | rfl; exact hpair.1; exact hpair.2
    · rcases hn with ⟨k, rfl⟩
      cases k with
      | zero =>
        refine ⟨_, Or.inr (Or.inr (Or.inl rfl)), rfl, ?_, by simp⟩
        simp [evalUnaryForm_padConst]
      | succ k =>
        refine ⟨_, Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))), rfl, ?_, by simp⟩
        have hpos : 1 ≤ 4 ^ (k + 1) := Nat.one_le_pow _ 4 (by omega)
        have hpair := h3.mpr ⟨3 * 4 ^ (k + 1), by dsimp [rJez]; omega, (jez_A3_iff _).mpr ⟨k, rfl⟩⟩
        intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
        rcases hα with rfl | rfl; exact hpair.1; exact hpair.2
    · rcases hn with ⟨k, rfl⟩
      cases k with
      | zero =>
        refine ⟨_, Or.inr (Or.inr (Or.inr (Or.inl rfl))), rfl, ?_, by simp⟩
        simp [evalUnaryForm_padConst]
      | succ k =>
        refine ⟨_, Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl)))))), rfl, ?_, by simp⟩
        have hpos : 1 ≤ 4 ^ (k + 1) := Nat.one_le_pow _ 4 (by omega)
        have hpair := h4.mpr ⟨6 * 4 ^ (k + 1), by dsimp [rJez]; omega, (jez_A6_iff _).mpr ⟨k + 1, rfl⟩⟩
        intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
        rcases hα with rfl | rfl; exact hpair.1; exact hpair.2
  · rintro ⟨r, hr, _, hp, _⟩
    rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · have hL := (evalUnaryForm_padConst U (256 * 1 - rJez 0) L).mp (hp (padConst (256 * 1 - rJez 0)) (by simp))
      exact ⟨0, 1, ⟨0, by norm_num⟩, hL⟩
    · have hL := (evalUnaryForm_padConst U (256 * 2 - rJez 1) L).mp (hp (padConst (256 * 2 - rJez 1)) (by simp))
      exact ⟨1, 2, ⟨0, by norm_num⟩, hL⟩
    · have hL := (evalUnaryForm_padConst U (256 * 3 - rJez 2) L).mp (hp (padConst (256 * 3 - rJez 2)) (by simp))
      exact ⟨2, 3, ⟨0, by norm_num⟩, hL⟩
    · have hL := (evalUnaryForm_padConst U (256 * 6 - rJez 3) L).mp (hp (padConst (256 * 6 - rJez 3)) (by simp))
      exact ⟨3, 6, ⟨0, by norm_num⟩, hL⟩
    · rcases h1.mp ⟨hp (padXX _) (by simp), hp (padXX _) (by simp)⟩ with ⟨n, hLs, hn1, hn2⟩
      rcases (jez_A1_iff n).mp ⟨hn1, hn2⟩ with ⟨k, rfl⟩
      exact ⟨0, 4 ^ (k + 1), ⟨k + 1, rfl⟩, by omega⟩
    · rcases h2.mp ⟨hp (padXX _) (by simp), hp (padXX _) (by simp)⟩ with ⟨n, hLs, hn1, hn2⟩
      rcases (jez_A2_iff n).mp ⟨hn1, hn2⟩ with ⟨k, rfl⟩
      exact ⟨1, 2 * 4 ^ (k + 1), ⟨k + 1, rfl⟩, by omega⟩
    · rcases h3.mp ⟨hp (padXX _) (by simp), hp (padXX _) (by simp)⟩ with ⟨n, hLs, hn1, hn2⟩
      rcases (jez_A3_iff n).mp ⟨hn1, hn2⟩ with ⟨k, rfl⟩
      exact ⟨2, 3 * 4 ^ (k + 1), ⟨k + 1, rfl⟩, by omega⟩
    · rcases h4.mp ⟨hp (padXX _) (by simp), hp (padXX _) (by simp)⟩ with ⟨n, hLs, hn1, hn2⟩
      rcases (jez_A6_iff n).mp ⟨hn1, hn2⟩ with ⟨k, rfl⟩
      exact ⟨3, 6 * 4 ^ k, ⟨k, rfl⟩, by omega⟩

/-- **Theorem B4a:** `grammarFourPow` is a 2-nonterminal unary conjunctive grammar generating
`{ 4 ^ n | n : ℕ }` for ALL `n : ℕ` (sharpening Jeż 2007's 4-NT grammar to optimal 2)! -/
theorem grammarFourPow_generates : GeneratesUnary grammarFourPow (powLang 4) := by
  let U : Fin 2 → Set ℕ := fun | 0 => powLang 4 | 1 => jezXSet
  have hU_sol : ∀ B : Fin 2, U B = evalUnaryRHS grammarFourPow U B := by
    intro B
    fin_cases B
    · ext L
      have hS := jez_inter_iff U rfl (a := 0) (b := 2) (c := 1) (d := 1)
        (by decide) (by decide) (by decide) (by decide) 0 (by omega) (by omega) L
      simp only [Nat.sub_zero, add_zero] at hS
      simp only [U, powLang, evalUnaryRHS, grammarFourPow, evalUnaryRule,
        List.mem_append, List.mem_cons, List.not_mem_nil, or_false, mem_ofPred_eq]
      constructor
      · rintro ⟨m, rfl⟩
        rcases (show m = 0 ∨ m = 1 ∨ m = 2 ∨ m = 3 ∨ m = 4 ∨ 5 ≤ m by omega) with
          rfl | rfl | rfl | rfl | rfl | hm5
        · refine ⟨_, Or.inl (Or.inl rfl), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inl rfl)), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inl rfl))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inl rfl)))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · have hm_eq : 4 ^ m = 256 * 4 ^ ((m - 5) + 1) := by
            have : m = 4 + ((m - 5) + 1) := by omega
            conv_lhs => rw [this, pow_add]; norm_num
          have hpair := hS.mpr ⟨4 ^ ((m - 5) + 1), hm_eq, (jez_A1_iff _).mpr ⟨m - 5, rfl⟩⟩
          refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))), rfl, ?_, by simp⟩
          intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
          rcases hα with rfl | rfl; exact hpair.1; exact hpair.2
      · rintro ⟨r, hr, hlhs, hp, _⟩
        rcases hr with (rfl | rfl | rfl | rfl | rfl | rfl) | hrX
        · exact ⟨0, by simpa [evalUnaryForm_padConst] using hp (padConst 1) (by simp)⟩
        · exact ⟨1, by simpa [evalUnaryForm_padConst] using hp (padConst 4) (by simp)⟩
        · exact ⟨2, by simpa [evalUnaryForm_padConst] using hp (padConst 16) (by simp)⟩
        · exact ⟨3, by simpa [evalUnaryForm_padConst] using hp (padConst 64) (by simp)⟩
        · exact ⟨4, by simpa [evalUnaryForm_padConst] using hp (padConst 256) (by simp)⟩
        · rcases hS.mp ⟨hp (padXX _) (by simp), hp (padXX _) (by simp)⟩ with ⟨n, rfl, hn1, hn2⟩
          rcases (jez_A1_iff n).mp ⟨hn1, hn2⟩ with ⟨k, rfl⟩
          refine ⟨k + 5, ?_⟩
          have : k + 5 = 4 + (k + 1) := by omega
          rw [this, pow_add]; norm_num; ring
        · exfalso
          simp only [jezXRules, List.mem_cons, List.not_mem_nil, or_false] at hrX
          rcases hrX with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp at hlhs
    · ext L
      simp only [U, evalUnaryRHS, grammarFourPow, List.mem_append, List.mem_cons,
        List.not_mem_nil, or_false, mem_ofPred_eq]
      rw [jezX_fixed_point U rfl L]
      constructor
      · rintro ⟨r, hr, hlhs, hrule⟩
        exact ⟨r, Or.inr hr, hlhs, hrule⟩
      · rintro ⟨r, hr, hlhs, hrule⟩
        rcases hr with (rfl | rfl | rfl | rfl | rfl | rfl) | hrX
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · exact ⟨r, hrX, hlhs, hrule⟩
  exact ⟨strictlyDecreasing_hasStronglyUniqueUnarySol grammarFourPow_strictlyDecreasing hU_sol,
    U, hU_sol, rfl⟩

/-- **Theorem B4b:** `grammarTwoPow` is a 2-nonterminal unary conjunctive grammar generating
`{ 2 ^ n | n : ℕ }` for ALL `n : ℕ`! -/
theorem grammarTwoPow_generates : GeneratesUnary grammarTwoPow (powLang 2) := by
  let U : Fin 2 → Set ℕ := fun | 0 => powLang 2 | 1 => jezXSet
  have hU_sol : ∀ B : Fin 2, U B = evalUnaryRHS grammarTwoPow U B := by
    intro B
    fin_cases B
    · ext L
      have hS1 := jez_inter_iff U rfl (a := 0) (b := 2) (c := 1) (d := 1)
        (by decide) (by decide) (by decide) (by decide) 0 (by omega) (by omega) L
      have hS2 := jez_inter_iff U rfl (a := 0) (b := 0) (c := 3) (d := 1)
        (by decide) (by decide) (by decide) (by decide) 0 (by omega) (by omega) L
      simp only [Nat.sub_zero, add_zero] at hS1 hS2
      simp only [U, powLang, evalUnaryRHS, grammarTwoPow, evalUnaryRule,
        List.mem_append, List.mem_cons, List.not_mem_nil, or_false, mem_ofPred_eq]
      constructor
      · rintro ⟨m, rfl⟩
        rcases (show m = 0 ∨ m = 1 ∨ m = 2 ∨ m = 3 ∨ m = 4 ∨ m = 5 ∨ m = 6 ∨ m = 7 ∨
            m = 8 ∨ m = 9 ∨ 10 ≤ m by omega) with
          rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | hm10
        · refine ⟨_, Or.inl (Or.inl rfl), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inl rfl)), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inl rfl))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inl rfl)))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))))))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))))))), rfl, by simp [evalUnaryForm_padConst], by simp⟩
        · -- `m ≥ 10`: split by parity of `m - 10`!
          set k := (m - 10) / 2
          by_cases hpar : m % 2 = 0
          · have hm_eq : 2 ^ m = 256 * 4 ^ (k + 1) := by
              have h1 : m = 8 + 2 * (k + 1) := by omega
              rw [h1, pow_add, pow_mul]; norm_num
            have hpair := hS1.mpr ⟨4 ^ (k + 1), hm_eq, (jez_A1_iff _).mpr ⟨k, rfl⟩⟩
            refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))))))))), rfl, ?_, by simp⟩
            intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
            rcases hα with rfl | rfl; exact hpair.1; exact hpair.2
          · have hm_eq : 2 ^ m = 256 * (2 * 4 ^ (k + 1)) := by
              have h1 : m = 9 + 2 * (k + 1) := by omega
              rw [h1, pow_add, pow_mul]; norm_num; ring
            have hpair := hS2.mpr ⟨2 * 4 ^ (k + 1), hm_eq, (jez_A2_iff _).mpr ⟨k, rfl⟩⟩
            refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))))))))), rfl, ?_, by simp⟩
            intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
            rcases hα with rfl | rfl; exact hpair.1; exact hpair.2
      · rintro ⟨r, hr, hlhs, hp, _⟩
        rcases hr with (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) | hrX
        · exact ⟨0, by simpa [evalUnaryForm_padConst] using hp (padConst 1) (by simp)⟩
        · exact ⟨1, by simpa [evalUnaryForm_padConst] using hp (padConst 2) (by simp)⟩
        · exact ⟨2, by simpa [evalUnaryForm_padConst] using hp (padConst 4) (by simp)⟩
        · exact ⟨3, by simpa [evalUnaryForm_padConst] using hp (padConst 8) (by simp)⟩
        · exact ⟨4, by simpa [evalUnaryForm_padConst] using hp (padConst 16) (by simp)⟩
        · exact ⟨5, by simpa [evalUnaryForm_padConst] using hp (padConst 32) (by simp)⟩
        · exact ⟨6, by simpa [evalUnaryForm_padConst] using hp (padConst 64) (by simp)⟩
        · exact ⟨7, by simpa [evalUnaryForm_padConst] using hp (padConst 128) (by simp)⟩
        · exact ⟨8, by simpa [evalUnaryForm_padConst] using hp (padConst 256) (by simp)⟩
        · exact ⟨9, by simpa [evalUnaryForm_padConst] using hp (padConst 512) (by simp)⟩
        · rcases hS1.mp ⟨hp (padXX _) (by simp), hp (padXX _) (by simp)⟩ with ⟨n, rfl, hn1, hn2⟩
          rcases (jez_A1_iff n).mp ⟨hn1, hn2⟩ with ⟨k, rfl⟩
          refine ⟨2 * k + 10, ?_⟩
          have : 2 * k + 10 = 8 + 2 * (k + 1) := by omega
          conv_rhs => rw [this, pow_add, pow_mul]
          norm_num
        · rcases hS2.mp ⟨hp (padXX _) (by simp), hp (padXX _) (by simp)⟩ with ⟨n, rfl, hn1, hn2⟩
          rcases (jez_A2_iff n).mp ⟨hn1, hn2⟩ with ⟨k, rfl⟩
          refine ⟨2 * k + 11, ?_⟩
          have : 2 * k + 11 = 9 + 2 * (k + 1) := by omega
          conv_rhs => rw [this, pow_add, pow_mul]
          norm_num; ring
        · exfalso
          simp only [jezXRules, List.mem_cons, List.not_mem_nil, or_false] at hrX
          rcases hrX with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp at hlhs
    · ext L
      simp only [U, evalUnaryRHS, grammarTwoPow, List.mem_append, List.mem_cons,
        List.not_mem_nil, or_false, mem_ofPred_eq]
      rw [jezX_fixed_point U rfl L]
      constructor
      · rintro ⟨r, hr, hlhs, hrule⟩
        exact ⟨r, Or.inr hr, hlhs, hrule⟩
      · rintro ⟨r, hr, hlhs, hrule⟩
        rcases hr with (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) | hrX
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · simp at hlhs
        · exact ⟨r, hrX, hlhs, hrule⟩
  exact ⟨strictlyDecreasing_hasStronglyUniqueUnarySol grammarTwoPow_strictlyDecreasing hU_sol,
    U, hU_sol, rfl⟩

/-- **Headline Optimal Nonterminal Complexity Theorem (`exact_nt_complexity_two_pow_and_four_pow`):**
For both `{4^n : n ∈ ℕ}` and `{2^n : n ∈ ℕ}`, the exact nonterminal complexity in both unary
conjunctive grammars and unary Boolean grammars (under Okhotin strongly-unique semantics) is
**strictly equal to 2**:
- Both are generated by explicit **2-nonterminal unary conjunctive grammars** (zero negation),
- Neither can be generated by ANY **1-nonterminal unary Boolean grammar** (even with arbitrary
  finite rules, conjunctions, and negations). -/
theorem exact_nt_complexity_two_pow_and_four_pow :
    (∃ G : BoolGrammar Unit 2, G.IsConjunctive ∧ GeneratesUnary G (powLang 4)) ∧
    (∀ G : BoolGrammar Unit 1, ¬ GeneratesUnary G (powLang 4)) ∧
    (∃ G : BoolGrammar Unit 2, G.IsConjunctive ∧ GeneratesUnary G (powLang 2)) ∧
    (∀ G : BoolGrammar Unit 1, ¬ GeneratesUnary G (powLang 2)) :=
  ⟨⟨grammarFourPow, grammarFourPow_isConjunctive, grammarFourPow_generates⟩,
   no_one_nt_pow_language 4 (by omega),
   ⟨grammarTwoPow, grammarTwoPow_isConjunctive, grammarTwoPow_generates⟩,
   no_one_nt_pow_language 2 (by omega)⟩

/-- **Theorem B4a-LFP:** `grammarFourPow` generates `{ 4 ^ n | n : ℕ }` under standard textbook
least-fixed-point (Okhotin 2001 / Jeż 2007) conjunctive grammar semantics. -/
theorem grammarFourPow_generates_lfp : GeneratesUnaryLFP grammarFourPow (powLang 4) :=
  generatesUnaryLFP_of_generatesUnary grammarFourPow_generates

/-- **Theorem B4b-LFP:** `grammarTwoPow` generates `{ 2 ^ n | n : ℕ }` under standard textbook
least-fixed-point (Okhotin 2001 / Jeż 2007) conjunctive grammar semantics. -/
theorem grammarTwoPow_generates_lfp : GeneratesUnaryLFP grammarTwoPow (powLang 2) :=
  generatesUnaryLFP_of_generatesUnary grammarTwoPow_generates

/-- **Headline Optimal Nonterminal Complexity Theorem — Standard Textbook Conjunctive LFP Semantics
(`exact_nt_complexity_two_pow_and_four_pow_lfp`):**
For both `{4^n : n ∈ ℕ}` and `{2^n : n ∈ ℕ}`, the exact nonterminal complexity in unary
conjunctive grammars under standard textbook least-fixed-point semantics (Okhotin 2001 / Jeż 2007)
is **strictly equal to 2**:
- Both are generated by explicit **2-nonterminal unary conjunctive grammars** (`grammarFourPow`,
  `grammarTwoPow`), whose unique global fixed point is the least fixed point,
- Neither can be generated by ANY **1-nonterminal unary conjunctive grammar** under least-fixed-point
  semantics (even with arbitrary `ε`-rules and unit rules such as `S → S`). -/
theorem exact_nt_complexity_two_pow_and_four_pow_lfp :
    (∃ G : BoolGrammar Unit 2, G.IsConjunctive ∧ GeneratesUnaryLFP G (powLang 4)) ∧
    (∀ G : BoolGrammar Unit 1, G.IsConjunctive → ¬ GeneratesUnaryLFP G (powLang 4)) ∧
    (∃ G : BoolGrammar Unit 2, G.IsConjunctive ∧ GeneratesUnaryLFP G (powLang 2)) ∧
    (∀ G : BoolGrammar Unit 1, G.IsConjunctive → ¬ GeneratesUnaryLFP G (powLang 2)) :=
  ⟨⟨grammarFourPow, grammarFourPow_isConjunctive, grammarFourPow_generates_lfp⟩,
   no_one_nt_pow_language_lfp 4 (by omega),
   ⟨grammarTwoPow, grammarTwoPow_isConjunctive, grammarTwoPow_generates_lfp⟩,
   no_one_nt_pow_language_lfp 2 (by omega)⟩

