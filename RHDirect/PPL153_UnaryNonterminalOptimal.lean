lemma grammarFourPow_isConjunctive : grammarFourPow.IsConjunctive := by
  intro r hr
  simp only [grammarFourPow, jezXRules, List.mem_append, List.mem_cons, List.not_mem_nil,
    or_false] at hr
  rcases hr with (rfl | rfl | rfl | rfl | rfl | rfl) | (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) <;>
    exact ⟨rfl, by simp⟩

lemma grammarTwoPow_isConjunctive : grammarTwoPow.IsConjunctive := by
  intro r hr
  simp only [grammarTwoPow, jezXRules, List.mem_append, List.mem_cons, List.not_mem_nil,
    or_false] at hr
  rcases hr with (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) |
      (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) <;>
