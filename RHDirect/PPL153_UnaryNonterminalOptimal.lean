/-!
# PPL 153 (Okhotin · Bounded Nonterminal Complexity):
# Optimal 2-Nonterminal Unary Conjunctive & Boolean Grammar Theorems

## Honest Scope Notice
This module formalizes **original, sharp structural and optimal nonterminal-complexity theorems**
toward **PPL 153 (Alexander Okhotin · Bounded Nonterminal Complexity of Boolean Grammars, C$360)**:
*"Is there a universal constant `k` such that every Boolean-grammar language has a Boolean grammar
using at most `k` nonterminal symbols?"*

**This is NOT a full resolution of PPL 153 for arbitrary `k`.** Proving whether a universal
constant `k₀` exists for all (even unary) Boolean languages remains open. What we prove here are
four complete, self-contained, unconditional theorems advancing the problem sharply at `k = 1` vs
`k = 2` (and sharpening Jeż's 2007 4-nonterminal conjunctive grammar for `{a^{4^n}}` to optimal 2):

## Exact Formalized Results (Pure Mathlib, Zero `sorry`, Zero Custom Axioms)
1. **Faithful Okhotin Language-Equation Semantics (Both Strongly-Unique Boolean & Textbook LFP
   Conjunctive)** (`BoolGrammar`, `HasStronglyUniqueSolution`, `Generates`, `GeneratesUnary`,
   `generates_unit_iff_generatesUnary`, `strictlyDecreasing_hasStronglyUniqueUnarySol`,
   `IsUnarySol`, `IsUnaryPreFixedPoint`, `IsLeastUnarySol`, `lfpUnary`, `GeneratesUnaryLFP`,
   `lfpUnary_isLeastUnarySol`, `generatesUnaryLFP_of_generatesUnary`):
   Verbatim formalization of BOTH Okhotin's strongly unique solution modulo `Σ^{≤ ℓ}` for every
   `ℓ ≥ 0` (over arbitrary `Σ` and unary `Unit ≃ ℕ`) AND the standard textbook least-fixed-point
   (LFP) semantics for conjunctive grammars (Okhotin 2001 / Jeż 2007), together with Knaster–Tarski
   existence/uniqueness of `lfpUnary` for all conjunctive grammars and the proof that every
   strongly-unique solution is automatically the least fixed point.
2. **Theorem B1 — Unary Restriction Lemma (`unary_restriction_theorem`):**
   For any alphabet `Σ`, any `a : Σ`, and any `k`-nonterminal Boolean (resp. conjunctive) grammar
   `G` generating `K ⊆ Σ*`, the unary slice `{ n : ℕ | List.replicate n a ∈ K }` is generated by a
   `k`-nonterminal unary Boolean (resp. conjunctive) grammar `restrictToChar G a`.
3. **Theorem B2 — Unconditional 1-Nonterminal Lower Bounds (`no_one_nt_pow_language`,
   `no_one_nt_pow_language_lfp`):**
   For **every** integer base `B ≥ 2`, the language `{ B ^ n | n : ℕ }` is NOT generated by ANY
   1-nonterminal unary Boolean grammar under strongly-unique semantics (even with arbitrary finite
   rules, conjunctions, and negations), AND is NOT generated by ANY 1-nonterminal unary conjunctive
   grammar under standard textbook least-fixed-point (LFP) semantics (even with arbitrary `ε`-rules
   and dummy unit rules such as `S → S`). Proof via base-`B` digit-sum comparison of
   `B^{a_min + B - 1}` against `∑_{i < B} B^{a_min + i}` producing both a second solution modulo
   `n₁` and (for conjunctive grammars) a strictly smaller global pre-fixed point `U₀ \ {n₁}`.
4. **Theorem B3 — General 2-NT Stretched Collapse via `B_4` Sidon Sets
   (`stretched_collapse_2nt`, `exists_stretch_modulus_2nt`):**
   For ANY `m`-nonterminal `ε`-free binary-normal-form unary Boolean (resp. conjunctive) grammar
   `G : UnaryBNFGrammar m` generating `L ⊆ ℕ_{>0}` and ANY modulus `M` admitting a valid `B_4`
   Sidon set of size `m + 2` modulo `M` (explicitly always existing via `M = 5 ^ (m + 3)`,
   `r i = 5^(m+2) + 5^i`), the stretched language `M · L = { M * n | n ∈ L }` is generated by an
   explicit **2-nonterminal** unary Boolean (resp. conjunctive) grammar!
   *(Input normal-form note: `stretched_collapse_2nt` and `exists_stretch_modulus_2nt` take an
   `ε`-free `UnaryBNFGrammar m` input directly; the standard conversion of an arbitrary `ε`-free
   unary Boolean/conjunctive grammar into Binary Normal Form (Okhotin 2001, 2004) is not separately
   formalized in this file.)*
5. **Theorem B4 — Sharp Optimal Nonterminal Complexity of `{4^n}` and `{2^n}`
   (`grammarFourPow_generates`, `grammarTwoPow_generates`,
    `exact_nt_complexity_two_pow_and_four_pow`, `grammarFourPow_generates_lfp`,
    `grammarTwoPow_generates_lfp`, `exact_nt_complexity_two_pow_and_four_pow_lfp`):**
   Using the compact `B_4` Sidon set `r = [22, 23, 27, 43]` modulo `M = 256 = 4^4` and Jeż's
   4-nonterminal identities (proved for ALL `n : ℕ`), we construct explicit **2-nonterminal unary
   conjunctive grammars** (zero negation!) generating `{4^n : n ∈ ℕ}` and `{2^n : n ∈ ℕ}` for all
   `n ∈ ℕ` under BOTH strongly-unique Boolean semantics AND standard textbook LFP conjunctive
   semantics. Combined with Theorem B2, the **exact nonterminal complexity of both `{4^n}` and
   `{2^n}` is 2** under both semantics.
-/

namespace PPL153

open Set

/-! ## Section 1: General & Unary Boolean / Conjunctive Grammar Semantics -/

/-- A grammar symbol over alphabet `Alph` and `k` nonterminals `Fin k`. -/
abbrev Sym (Alph : Type*) (k : ℕ) := Sum Alph (Fin k)

/-- A sentential form is a finite list of terminal and nonterminal symbols. -/
abbrev Form (Alph : Type*) (k : ℕ) := List (Sym Alph k)

/-- A Boolean grammar rule `lhs → ⋀ pos ∧ ⋀ ¬neg`. -/
structure BoolRule (Alph : Type*) (k : ℕ) where
  lhs : Fin k
  pos : List (Form Alph k)
  neg : List (Form Alph k)

/-- A Boolean grammar with alphabet `Alph`, `k` nonterminals `Fin k`, finite rule list, and start symbol. -/
structure BoolGrammar (Alph : Type*) (k : ℕ) where
  rules : List (BoolRule Alph k)
  start : Fin k

/-- A Boolean grammar is conjunctive if every rule has no negative conjuncts and at least one
positive conjunct. -/
def BoolGrammar.IsConjunctive {Alph : Type*} {k : ℕ} (G : BoolGrammar Alph k) : Prop :=
  ∀ r ∈ G.rules, r.neg = [] ∧ r.pos ≠ []

/-- Evaluate a sentential form `α` under a language assignment `L : Fin k → Set (List Alph)`. -/
def evalForm {Alph : Type*} {k : ℕ} (L : Fin k → Set (List Alph)) : Form Alph k → Set (List Alph)
  | [] => {[]}
  | Sum.inl a :: rest => { w | ∃ v ∈ evalForm L rest, w = a :: v }
  | Sum.inr A :: rest => { w | ∃ u ∈ L A, ∃ v ∈ evalForm L rest, w = u ++ v }

/-- Evaluate a single Boolean rule under assignment `L`. -/
def evalRule {Alph : Type*} {k : ℕ} (L : Fin k → Set (List Alph)) (r : BoolRule Alph k) : Set (List Alph) :=
  { w | (∀ α ∈ r.pos, w ∈ evalForm L α) ∧ (∀ β ∈ r.neg, w ∉ evalForm L β) }

/-- Evaluate the right-hand side of all rules for nonterminal `A` in `G`. -/
def evalRHS {Alph : Type*} {k : ℕ} (G : BoolGrammar Alph k) (L : Fin k → Set (List Alph))
    (A : Fin k) : Set (List Alph) :=
  { w | ∃ r ∈ G.rules, r.lhs = A ∧ w ∈ evalRule L r }

/-- Restrict a language to strings of length at most `ℓ`. -/
def truncLang {Alph : Type*} (ℓ : ℕ) (S : Set (List Alph)) : Set (List Alph) :=
  { w ∈ S | w.length ≤ ℓ }

/-- Restrict a vector of languages to strings of length at most `ℓ`. -/
def truncVec {Alph : Type*} {k : ℕ} (ℓ : ℕ) (L : Fin k → Set (List Alph)) : Fin k → Set (List Alph) :=
  fun A => truncLang ℓ (L A)

/-- Okhotin's solution modulo `Alph^{≤ ℓ}`: each `L A ⊆ Alph^{≤ ℓ}` and `L` satisfies the equations
modulo intersection with `Alph^{≤ ℓ}`. -/
def IsSolMod {Alph : Type*} {k : ℕ} (G : BoolGrammar Alph k) (ℓ : ℕ)
    (L : Fin k → Set (List Alph)) : Prop :=
  (∀ A w, w ∈ L A → w.length ≤ ℓ) ∧ ∀ A, L A = truncLang ℓ (evalRHS G L A)

/-- Okhotin's strongly unique solution property: for every `ℓ ≥ 0`, there is a unique solution
modulo `Alph^{≤ ℓ}`. -/
def HasStronglyUniqueSolution {Alph : Type*} {k : ℕ} (G : BoolGrammar Alph k) : Prop :=
  ∀ ℓ : ℕ, ∃! L : Fin k → Set (List Alph), IsSolMod G ℓ L

/-- `G` generates `K ⊆ Alph*` if `G` has a strongly unique solution and its global solution has
start language `K`. -/
def Generates {Alph : Type*} {k : ℕ} (G : BoolGrammar Alph k) (K : Set (List Alph)) : Prop :=
  HasStronglyUniqueSolution G ∧ ∃ L : Fin k → Set (List Alph),
    (∀ A, L A = evalRHS G L A) ∧ L G.start = K

lemma evalForm_congr_le {Alph : Type*} {k : ℕ} {L₁ L₂ : Fin k → Set (List Alph)} {ℓ : ℕ}
    (h : ∀ A w, w.length ≤ ℓ → (w ∈ L₁ A ↔ w ∈ L₂ A)) :
    ∀ (α : Form Alph k) (w : List Alph), w.length ≤ ℓ → (w ∈ evalForm L₁ α ↔ w ∈ evalForm L₂ α) := by
  intro α
  induction α with
  | nil => intro w _; rfl
  | cons s rest ih =>
    intro w hw
    cases s with
    | inl a =>
      simp only [evalForm, mem_ofPred_eq]
      constructor <;> rintro ⟨v, hv, rfl⟩ <;> refine ⟨v, ?_, rfl⟩
      · exact (ih v (by simp at hw; omega)).mp hv
      · exact (ih v (by simp at hw; omega)).mpr hv
    | inr A =>
      simp only [evalForm, mem_ofPred_eq]
      constructor <;> rintro ⟨u, hu, v, hv, rfl⟩
      · have hu_len : u.length ≤ ℓ := by simp at hw; omega
        have hv_len : v.length ≤ ℓ := by simp at hw; omega
        exact ⟨u, (h A u hu_len).mp hu, v, (ih v hv_len).mp hv, rfl⟩
      · have hu_len : u.length ≤ ℓ := by simp at hw; omega
        have hv_len : v.length ≤ ℓ := by simp at hw; omega
        exact ⟨u, (h A u hu_len).mpr hu, v, (ih v hv_len).mpr hv, rfl⟩

lemma evalRule_congr_le {Alph : Type*} {k : ℕ} {L₁ L₂ : Fin k → Set (List Alph)} {ℓ : ℕ}
    (h : ∀ A w, w.length ≤ ℓ → (w ∈ L₁ A ↔ w ∈ L₂ A)) (r : BoolRule Alph k)
    {w : List Alph} (hw : w.length ≤ ℓ) :
    w ∈ evalRule L₁ r ↔ w ∈ evalRule L₂ r := by
  simp only [evalRule, mem_ofPred_eq]
  constructor
  · rintro ⟨hp, hn⟩
    exact ⟨fun α hα => (evalForm_congr_le h α w hw).mp (hp α hα),
      fun β hβ hmem => hn β hβ ((evalForm_congr_le h β w hw).mpr hmem)⟩
  · rintro ⟨hp, hn⟩
    exact ⟨fun α hα => (evalForm_congr_le h α w hw).mpr (hp α hα),
      fun β hβ hmem => hn β hβ ((evalForm_congr_le h β w hw).mp hmem)⟩

lemma evalRHS_congr_le {Alph : Type*} {k : ℕ} (G : BoolGrammar Alph k)
    {L₁ L₂ : Fin k → Set (List Alph)} {ℓ : ℕ}
    (h : ∀ A w, w.length ≤ ℓ → (w ∈ L₁ A ↔ w ∈ L₂ A))
    (A : Fin k) {w : List Alph} (hw : w.length ≤ ℓ) :
    w ∈ evalRHS G L₁ A ↔ w ∈ evalRHS G L₂ A := by
  simp only [evalRHS, mem_ofPred_eq]
  constructor
  · rintro ⟨r, hr, hlhs, hmem⟩
    exact ⟨r, hr, hlhs, (evalRule_congr_le h r hw).mp hmem⟩
  · rintro ⟨r, hr, hlhs, hmem⟩
    exact ⟨r, hr, hlhs, (evalRule_congr_le h r hw).mpr hmem⟩

lemma isSolMod_truncVec_of_global {Alph : Type*} {k : ℕ} {G : BoolGrammar Alph k}
    {L : Fin k → Set (List Alph)} (hL : ∀ A, L A = evalRHS G L A) (ℓ : ℕ) :
    IsSolMod G ℓ (truncVec ℓ L) := by
  refine ⟨fun A w hw => hw.2, fun A => ?_⟩
  ext w
  simp only [truncVec, truncLang, mem_ofPred_eq]
  constructor
  · rintro ⟨hwL, hwlen⟩
    refine ⟨?_, hwlen⟩
    have hcongr : ∀ B u, u.length ≤ ℓ → (u ∈ truncVec ℓ L B ↔ u ∈ L B) := by
      intro B u hu; simp [truncVec, truncLang, hu]
    exact (evalRHS_congr_le G hcongr A hwlen).mpr (hL A ▸ hwL)
  · rintro ⟨hwR, hwlen⟩
    refine ⟨?_, hwlen⟩
    have hcongr : ∀ B u, u.length ≤ ℓ → (u ∈ truncVec ℓ L B ↔ u ∈ L B) := by
      intro B u hu; simp [truncVec, truncLang, hu]
    rw [hL A]
    exact (evalRHS_congr_le G hcongr A hwlen).mp hwR

lemma isSolMod_truncVec_of_le {Alph : Type*} {k : ℕ} {G : BoolGrammar Alph k}
    {L : Fin k → Set (List Alph)} {ℓ₁ ℓ₂ : ℕ} (hle : ℓ₁ ≤ ℓ₂) (hL : IsSolMod G ℓ₂ L) :
    IsSolMod G ℓ₁ (truncVec ℓ₁ L) := by
  refine ⟨fun A w hw => hw.2, fun A => ?_⟩
  ext w
  simp only [truncVec, truncLang, mem_ofPred_eq]
  have hcongr : ∀ B u, u.length ≤ ℓ₁ → (u ∈ truncVec ℓ₁ L B ↔ u ∈ L B) := by
    intro B u hu; simp [truncVec, truncLang, hu]
  constructor
  · rintro ⟨hwL, hwlen⟩
    refine ⟨?_, hwlen⟩
    have hwR : w ∈ truncLang ℓ₂ (evalRHS G L A) := hL.2 A ▸ hwL
    exact (evalRHS_congr_le G hcongr A hwlen).mpr hwR.1
  · rintro ⟨hwR, hwlen⟩
    refine ⟨?_, hwlen⟩
    rw [hL.2 A]
    exact ⟨(evalRHS_congr_le G hcongr A hwlen).mp hwR, le_trans hwlen hle⟩

/-- Direct unary semantics on `ℕ` for a unary Boolean grammar `BoolGrammar Unit k`. -/
def evalUnaryForm {k : ℕ} (U : Fin k → Set ℕ) : Form Unit k → Set ℕ
  | [] => {0}
  | Sum.inl () :: rest => { n | ∃ m ∈ evalUnaryForm U rest, n = m + 1 }
  | Sum.inr A :: rest => { n | ∃ u ∈ U A, ∃ v ∈ evalUnaryForm U rest, n = u + v }

def evalUnaryRule {k : ℕ} (U : Fin k → Set ℕ) (r : BoolRule Unit k) : Set ℕ :=
  { n | (∀ α ∈ r.pos, n ∈ evalUnaryForm U α) ∧ (∀ β ∈ r.neg, n ∉ evalUnaryForm U β) }

def evalUnaryRHS {k : ℕ} (G : BoolGrammar Unit k) (U : Fin k → Set ℕ) (A : Fin k) : Set ℕ :=
  { n | ∃ r ∈ G.rules, r.lhs = A ∧ n ∈ evalUnaryRule U r }

def truncNat (ℓ : ℕ) (S : Set ℕ) : Set ℕ := { n ∈ S | n ≤ ℓ }

def truncUnaryVec {k : ℕ} (ℓ : ℕ) (U : Fin k → Set ℕ) : Fin k → Set ℕ :=
  fun A => truncNat ℓ (U A)

def IsUnarySolMod {k : ℕ} (G : BoolGrammar Unit k) (ℓ : ℕ) (U : Fin k → Set ℕ) : Prop :=
  (∀ A n, n ∈ U A → n ≤ ℓ) ∧ ∀ A, U A = truncNat ℓ (evalUnaryRHS G U A)

def HasStronglyUniqueUnarySol {k : ℕ} (G : BoolGrammar Unit k) : Prop :=
  ∀ ℓ : ℕ, ∃! U : Fin k → Set ℕ, IsUnarySolMod G ℓ U

def GeneratesUnary {k : ℕ} (G : BoolGrammar Unit k) (K : Set ℕ) : Prop :=
  HasStronglyUniqueUnarySol G ∧ ∃ U : Fin k → Set ℕ,
    (∀ A, U A = evalUnaryRHS G U A) ∧ U G.start = K

/-- Every list over `Unit` equals `List.replicate w.length ()`. -/
lemma list_unit_eq_replicate (w : List Unit) : w = List.replicate w.length () := by
  induction w with
  | nil => rfl
  | cons x xs ih =>
    cases x
    simp only [List.length_cons, List.replicate_succ]
    exact congrArg (List.cons ()) ih

lemma evalForm_unit_iff {k : ℕ} (L : Fin k → Set (List Unit)) (α : Form Unit k) (n : ℕ) :
    List.replicate n () ∈ evalForm L α ↔
      n ∈ evalUnaryForm (fun A => { m | List.replicate m () ∈ L A }) α := by
  induction α generalizing n with
  | nil =>
    simp only [evalForm, evalUnaryForm, mem_singleton_iff]
    constructor
    · intro h
      have := congrArg List.length h
      simpa using this
    · rintro rfl; rfl
  | cons s rest ih =>
    cases s with
    | inl u =>
      cases u
      simp only [evalForm, evalUnaryForm, mem_ofPred_eq]
      constructor
      · rintro ⟨v, hv, hrep⟩
        refine ⟨v.length, ?_, ?_⟩
        · rw [← ih]
          rwa [← list_unit_eq_replicate v]
        · have := congrArg List.length hrep
          simpa using this
      · rintro ⟨m, hm, rfl⟩
        exact ⟨List.replicate m (), (ih m).mpr hm, rfl⟩
    | inr A =>
      simp only [evalForm, evalUnaryForm, mem_ofPred_eq]
      constructor
      · rintro ⟨u, hu, v, hv, hrep⟩
        refine ⟨u.length, ?_, v.length, ?_, ?_⟩
        · rwa [← list_unit_eq_replicate u]
        · rw [← ih]; rwa [← list_unit_eq_replicate v]
        · have := congrArg List.length hrep
          simpa using this
      · rintro ⟨u, hu, v, hv, rfl⟩
        refine ⟨List.replicate u (), hu, List.replicate v (), (ih v).mpr hv, ?_⟩
        rw [← List.replicate_add]

lemma evalRule_unit_iff {k : ℕ} (L : Fin k → Set (List Unit)) (r : BoolRule Unit k) (n : ℕ) :
    List.replicate n () ∈ evalRule L r ↔
      n ∈ evalUnaryRule (fun A => { m | List.replicate m () ∈ L A }) r := by
  simp only [evalRule, evalUnaryRule, mem_ofPred_eq]
  constructor
  · rintro ⟨hp, hn⟩
    exact ⟨fun α hα => (evalForm_unit_iff L α n).mp (hp α hα),
      fun β hβ hmem => hn β hβ ((evalForm_unit_iff L β n).mpr hmem)⟩
  · rintro ⟨hp, hn⟩
    exact ⟨fun α hα => (evalForm_unit_iff L α n).mpr (hp α hα),
      fun β hβ hmem => hn β hβ ((evalForm_unit_iff L β n).mp hmem)⟩

lemma evalRHS_unit_iff {k : ℕ} (G : BoolGrammar Unit k) (L : Fin k → Set (List Unit))
    (A : Fin k) (n : ℕ) :
    List.replicate n () ∈ evalRHS G L A ↔
      n ∈ evalUnaryRHS G (fun B => { m | List.replicate m () ∈ L B }) A := by
  simp only [evalRHS, evalUnaryRHS, mem_ofPred_eq]
  constructor
  · rintro ⟨r, hr, hlhs, hmem⟩
    exact ⟨r, hr, hlhs, (evalRule_unit_iff L r n).mp hmem⟩
  · rintro ⟨r, hr, hlhs, hmem⟩
    exact ⟨r, hr, hlhs, (evalRule_unit_iff L r n).mpr hmem⟩

/-- Exact equivalence between `Generates` over `Alph = Unit` and `GeneratesUnary` over `ℕ`. -/
theorem generates_unit_iff_generatesUnary {k : ℕ} (G : BoolGrammar Unit k) (K : Set ℕ) :
    Generates G { w : List Unit | w.length ∈ K } ↔ GeneratesUnary G K := by
  let toU : (Fin k → Set (List Unit)) → (Fin k → Set ℕ) :=
    fun L A => { n | List.replicate n () ∈ L A }
  let toL : (Fin k → Set ℕ) → (Fin k → Set (List Unit)) :=
    fun U A => { w | w.length ∈ U A }
  have hLU : ∀ L, toL (toU L) = L := by
    intro L; funext A; ext w
    simp only [toL, toU, mem_ofPred_eq]
    rw [← list_unit_eq_replicate w]
  have hUL : ∀ U, toU (toL U) = U := by
    intro U; funext A; ext n
    simp [toL, toU]
  have hMod : ∀ ℓ L, IsSolMod G ℓ L ↔ IsUnarySolMod G ℓ (toU L) := by
    intro ℓ L
    constructor
    · rintro ⟨hb, heq⟩
      refine ⟨fun A n hn => by simpa using hb A _ hn, fun A => ?_⟩
      ext n
      simp only [toU, truncNat, mem_ofPred_eq]
      rw [heq A]
      simp only [truncLang, mem_ofPred_eq, List.length_replicate]
      rw [evalRHS_unit_iff]
    · rintro ⟨hb, heq⟩
      refine ⟨fun A w hw => ?_, fun A => ?_⟩
      · have := hb A w.length (by
          change List.replicate w.length () ∈ L A
          rw [← list_unit_eq_replicate w]; exact hw)
        exact this
      · ext w
        rw [list_unit_eq_replicate w]
        simp only [truncLang, mem_ofPred_eq, List.length_replicate]
        rw [evalRHS_unit_iff]
        have := Set.ext_iff.mp (heq A) w.length
        simpa [toU, truncNat] using this
  constructor
  · rintro ⟨huniq, L, hL, hS⟩
    refine ⟨fun ℓ => ?_, toU L, ?_, ?_⟩
    · obtain ⟨L₀, hL₀, hL₀u⟩ := huniq ℓ
      refine ⟨toU L₀, (hMod ℓ L₀).mp hL₀, fun U hU => ?_⟩
      have h1 : IsSolMod G ℓ (toL U) := (hMod ℓ (toL U)).mpr (by rwa [hUL])
      have h2 := hL₀u (toL U) h1
      rw [← hUL U, h2]
    · intro A; ext n
      simp only [toU, mem_ofPred_eq]
      rw [hL A, evalRHS_unit_iff]
    · ext n
      simp only [toU, mem_ofPred_eq]
      rw [hS]; simp
  · rintro ⟨huniq, U, hU, hS⟩
    refine ⟨fun ℓ => ?_, toL U, ?_, ?_⟩
    · obtain ⟨U₀, hU₀, hU₀u⟩ := huniq ℓ
      refine ⟨toL U₀, (hMod ℓ (toL U₀)).mpr (by rwa [hUL]), fun L hL => ?_⟩
      have h1 := hU₀u (toU L) ((hMod ℓ L).mp hL)
      rw [← hLU L, h1]
    · intro A; ext w
      rw [list_unit_eq_replicate w]
      simp only [toL, mem_ofPred_eq, List.length_replicate]
      rw [evalRHS_unit_iff]
      change w.length ∈ U A ↔ w.length ∈ evalUnaryRHS G (toU (toL U)) A
      rw [hUL U, ← hU A]
    · ext w
      simp [toL, hS]

lemma evalUnaryForm_congr_le {k : ℕ} {U₁ U₂ : Fin k → Set ℕ} {ℓ : ℕ}
    (h : ∀ A n, n ≤ ℓ → (n ∈ U₁ A ↔ n ∈ U₂ A)) :
    ∀ (α : Form Unit k) (n : ℕ), n ≤ ℓ → (n ∈ evalUnaryForm U₁ α ↔ n ∈ evalUnaryForm U₂ α) := by
  intro α
  induction α with
  | nil => intro n _; rfl
  | cons s rest ih =>
    intro n hn
    cases s with
    | inl u =>
      cases u
      simp only [evalUnaryForm, mem_ofPred_eq]
      constructor <;> rintro ⟨m, hm, rfl⟩ <;> refine ⟨m, ?_, rfl⟩
      · exact (ih m (by omega)).mp hm
      · exact (ih m (by omega)).mpr hm
    | inr A =>
      simp only [evalUnaryForm, mem_ofPred_eq]
      constructor <;> rintro ⟨u, hu, v, hv, rfl⟩
      · exact ⟨u, (h A u (by omega)).mp hu, v, (ih v (by omega)).mp hv, rfl⟩
      · exact ⟨u, (h A u (by omega)).mpr hu, v, (ih v (by omega)).mpr hv, rfl⟩

lemma evalUnaryRule_congr_le {k : ℕ} {U₁ U₂ : Fin k → Set ℕ} {ℓ : ℕ}
    (h : ∀ A n, n ≤ ℓ → (n ∈ U₁ A ↔ n ∈ U₂ A)) (r : BoolRule Unit k)
    {n : ℕ} (hn : n ≤ ℓ) :
    n ∈ evalUnaryRule U₁ r ↔ n ∈ evalUnaryRule U₂ r := by
  simp only [evalUnaryRule, mem_ofPred_eq]
  constructor
  · rintro ⟨hp, hneg⟩
    exact ⟨fun α hα => (evalUnaryForm_congr_le h α n hn).mp (hp α hα),
      fun β hβ hmem => hneg β hβ ((evalUnaryForm_congr_le h β n hn).mpr hmem)⟩
  · rintro ⟨hp, hneg⟩
    exact ⟨fun α hα => (evalUnaryForm_congr_le h α n hn).mpr (hp α hα),
      fun β hβ hmem => hneg β hβ ((evalUnaryForm_congr_le h β n hn).mp hmem)⟩

lemma evalUnaryRHS_congr_le {k : ℕ} (G : BoolGrammar Unit k)
    {U₁ U₂ : Fin k → Set ℕ} {ℓ : ℕ}
    (h : ∀ A n, n ≤ ℓ → (n ∈ U₁ A ↔ n ∈ U₂ A))
    (A : Fin k) {n : ℕ} (hn : n ≤ ℓ) :
    n ∈ evalUnaryRHS G U₁ A ↔ n ∈ evalUnaryRHS G U₂ A := by
  simp only [evalUnaryRHS, mem_ofPred_eq]
  constructor
  · rintro ⟨r, hr, hlhs, hmem⟩
    exact ⟨r, hr, hlhs, (evalUnaryRule_congr_le h r hn).mp hmem⟩
  · rintro ⟨r, hr, hlhs, hmem⟩
    exact ⟨r, hr, hlhs, (evalUnaryRule_congr_le h r hn).mpr hmem⟩

lemma isUnarySolMod_trunc_of_global {k : ℕ} {G : BoolGrammar Unit k}
    {U : Fin k → Set ℕ} (hU : ∀ A, U A = evalUnaryRHS G U A) (ℓ : ℕ) :
    IsUnarySolMod G ℓ (truncUnaryVec ℓ U) := by
  refine ⟨fun A n hn => hn.2, fun A => ?_⟩
  ext n
  simp only [truncUnaryVec, truncNat, mem_ofPred_eq]
  have hcongr : ∀ B m, m ≤ ℓ → (m ∈ truncUnaryVec ℓ U B ↔ m ∈ U B) := by
    intro B m hm; simp [truncUnaryVec, truncNat, hm]
  constructor
  · rintro ⟨hnU, hnle⟩
    exact ⟨(evalUnaryRHS_congr_le G hcongr A hnle).mpr (hU A ▸ hnU), hnle⟩
  · rintro ⟨hnR, hnle⟩
    exact ⟨hU A ▸ (evalUnaryRHS_congr_le G hcongr A hnle).mp hnR, hnle⟩

/-- Number of terminals `()` in a unary sentential form. -/
def constCount {k : ℕ} : Form Unit k → ℕ
  | [] => 0
  | Sum.inl () :: rest => 1 + constCount rest
  | Sum.inr _ :: rest => constCount rest

/-- Number of nonterminals in a unary sentential form. -/
def ntCount {k : ℕ} : Form Unit k → ℕ
  | [] => 0
  | Sum.inl () :: rest => ntCount rest
  | Sum.inr _ :: rest => ntCount rest + 1

lemma evalUnaryForm_ge_constCount {k : ℕ} (U : Fin k → Set ℕ) (α : Form Unit k)
    {n : ℕ} (hn : n ∈ evalUnaryForm U α) : constCount α ≤ n := by
  induction α generalizing n with
  | nil => simp [constCount]
  | cons s rest ih =>
    cases s with
    | inl u =>
      cases u
      rcases hn with ⟨m, hm, rfl⟩
      have := ih hm
      simp only [constCount]; omega
    | inr A =>
      rcases hn with ⟨u, _, v, hv, rfl⟩
      have := ih hv
      simp only [constCount]; omega

/-- If `constCount α ≥ 1`, then `n ∈ evalUnaryForm U α` depends ONLY on `U` at lengths `< n`! -/
lemma evalUnaryForm_congr_lt_of_pos_const {k : ℕ} {U₁ U₂ : Fin k → Set ℕ} {n : ℕ}
    (h : ∀ A m, m < n → (m ∈ U₁ A ↔ m ∈ U₂ A))
    (α : Form Unit k) (hpos : 1 ≤ constCount α) :
    n ∈ evalUnaryForm U₁ α ↔ n ∈ evalUnaryForm U₂ α := by
  induction α generalizing n with
  | nil => simp [constCount] at hpos
  | cons s rest ih =>
    cases s with
    | inl u =>
      cases u
      simp only [evalUnaryForm, mem_ofPred_eq]
      constructor <;> rintro ⟨m, hm, rfl⟩ <;> refine ⟨m, ?_, rfl⟩
      · exact (evalUnaryForm_congr_le (fun A j hj => h A j (by omega)) rest m le_rfl).mp hm
      · exact (evalUnaryForm_congr_le (fun A j hj => h A j (by omega)) rest m le_rfl).mpr hm
    | inr A =>
      simp only [constCount] at hpos
      simp only [evalUnaryForm, mem_ofPred_eq]
      constructor
      · rintro ⟨u, hu, v, hv, rfl⟩
        have hv_pos : 1 ≤ v := le_trans hpos (evalUnaryForm_ge_constCount U₁ rest hv)
        have hu_lt : u < u + v := by omega
        have hv_iff := ih (n := v) (fun B m hm => h B m (by omega)) hpos
        exact ⟨u, (h A u hu_lt).mp hu, v, hv_iff.mp hv, rfl⟩
      · rintro ⟨u, hu, v, hv, rfl⟩
        have hv_pos : 1 ≤ v := le_trans hpos (evalUnaryForm_ge_constCount U₂ rest hv)
        have hu_lt : u < u + v := by omega
        have hv_iff := ih (n := v) (fun B m hm => h B m (by omega)) hpos
        exact ⟨u, (h A u hu_lt).mpr hu, v, hv_iff.mpr hv, rfl⟩

/-- A unary grammar is strictly length-decreasing if every conjunct in every rule contains
at least one terminal `()`. -/
def IsStrictlyDecreasing {k : ℕ} (G : BoolGrammar Unit k) : Prop :=
  ∀ r ∈ G.rules, (∀ α ∈ r.pos, 1 ≤ constCount α) ∧ (∀ β ∈ r.neg, 1 ≤ constCount β)

/-- Any strictly length-decreasing unary Boolean grammar that admits a global solution `U`
automatically has a strongly unique solution (and therefore generates `U G.start`). -/
theorem strictlyDecreasing_hasStronglyUniqueUnarySol {k : ℕ} {G : BoolGrammar Unit k}
    (hdec : IsStrictlyDecreasing G) {U : Fin k → Set ℕ} (hU : ∀ A, U A = evalUnaryRHS G U A) :
    HasStronglyUniqueUnarySol G := by
  intro ℓ
  refine ⟨truncUnaryVec ℓ U, isUnarySolMod_trunc_of_global hU ℓ, ?_⟩
  intro V hV
  -- Prove by strong induction on `n ≤ ℓ` that `n ∈ V A ↔ n ∈ U A`
  have hagree : ∀ n, n ≤ ℓ → ∀ A, n ∈ V A ↔ n ∈ U A := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hn A
      have hlt : ∀ B m, m < n → (m ∈ V B ↔ m ∈ U B) := fun B m hm => ih m hm (by omega) B
      have hV_eq : n ∈ V A ↔ n ∈ evalUnaryRHS G V A := by
        have := Set.ext_iff.mp (hV.2 A) n
        simpa [truncNat, hn] using this
      rw [hV_eq, hU A]
      simp only [evalUnaryRHS, evalUnaryRule, mem_ofPred_eq]
      constructor
      · rintro ⟨r, hr, hlhs, hp, hneg⟩
        have ⟨hdp, hdn⟩ := hdec r hr
        refine ⟨r, hr, hlhs, ?_, ?_⟩
        · intro α hα
          exact (evalUnaryForm_congr_lt_of_pos_const hlt α (hdp α hα)).mp (hp α hα)
        · intro β hβ hmem
          exact hneg β hβ ((evalUnaryForm_congr_lt_of_pos_const hlt β (hdn β hβ)).mpr hmem)
      · rintro ⟨r, hr, hlhs, hp, hneg⟩
        have ⟨hdp, hdn⟩ := hdec r hr
        refine ⟨r, hr, hlhs, ?_, ?_⟩
        · intro α hα
          exact (evalUnaryForm_congr_lt_of_pos_const hlt α (hdp α hα)).mpr (hp α hα)
        · intro β hβ hmem
          exact hneg β hβ ((evalUnaryForm_congr_lt_of_pos_const hlt β (hdn β hβ)).mp hmem)
  funext A; ext n
  simp only [truncUnaryVec, truncNat, mem_ofPred_eq]
  constructor
  · intro hnV
    have hnle := hV.1 A n hnV
    exact ⟨(hagree n hnle A).mp hnV, hnle⟩
  · rintro ⟨hnU, hnle⟩
    exact (hagree n hnle A).mpr hnU

/-! ### Standard Textbook Least-Fixed-Point (LFP) Semantics for Conjunctive Grammars -/

/-- Exact global solution (fixed point) of a unary grammar's system of language equations. -/
def IsUnarySol {k : ℕ} (G : BoolGrammar Unit k) (U : Fin k → Set ℕ) : Prop :=
  ∀ A, U A = evalUnaryRHS G U A

/-- Pre-fixed point of a unary grammar's language-equation operator (`T_G(W) ⊆ W`). -/
def IsUnaryPreFixedPoint {k : ℕ} (G : BoolGrammar Unit k) (W : Fin k → Set ℕ) : Prop :=
  ∀ A, evalUnaryRHS G W A ⊆ W A

/-- Least global solution (least fixed point under componentwise inclusion `⊆`). -/
def IsLeastUnarySol {k : ℕ} (G : BoolGrammar Unit k) (U : Fin k → Set ℕ) : Prop :=
  IsUnarySol G U ∧ ∀ V : Fin k → Set ℕ, IsUnarySol G V → ∀ A, U A ⊆ V A

/-- Standard textbook least-fixed-point (LFP) conjunctive grammar semantics (Okhotin 2001 /
Jeż 2007): the grammar's language equations admit a least solution `U` with start language `K`. -/
def GeneratesUnaryLFP {k : ℕ} (G : BoolGrammar Unit k) (K : Set ℕ) : Prop :=
  ∃ U : Fin k → Set ℕ, IsLeastUnarySol G U ∧ U G.start = K

lemma evalUnaryForm_mono {k : ℕ} {U₁ U₂ : Fin k → Set ℕ} (h : ∀ A, U₁ A ⊆ U₂ A) :
    ∀ (α : Form Unit k), evalUnaryForm U₁ α ⊆ evalUnaryForm U₂ α := by
  intro α
  induction α with
  | nil => intro n hn; exact hn
  | cons s rest ih =>
    cases s with
    | inl u =>
      cases u
      rintro n ⟨m, hm, rfl⟩
      exact ⟨m, ih hm, rfl⟩
    | inr A =>
      rintro n ⟨u, hu, v, hv, rfl⟩
      exact ⟨u, h A hu, v, ih hv, rfl⟩

lemma evalUnaryRule_mono {k : ℕ} {U₁ U₂ : Fin k → Set ℕ} (h : ∀ A, U₁ A ⊆ U₂ A)
    (r : BoolRule Unit k) (hneg : r.neg = []) :
    evalUnaryRule U₁ r ⊆ evalUnaryRule U₂ r := by
  rintro n ⟨hp, _⟩
  refine ⟨fun α hα => evalUnaryForm_mono h α (hp α hα), ?_⟩
  intro β hβ
  rw [hneg] at hβ
  cases hβ

lemma evalUnaryRHS_mono {k : ℕ} {G : BoolGrammar Unit k} (hconj : G.IsConjunctive)
    {U₁ U₂ : Fin k → Set ℕ} (h : ∀ A, U₁ A ⊆ U₂ A) (A : Fin k) :
    evalUnaryRHS G U₁ A ⊆ evalUnaryRHS G U₂ A := by
  rintro n ⟨r, hr, hlhs, hrule⟩
  exact ⟨r, hr, hlhs, evalUnaryRule_mono h r (hconj r hr).1 hrule⟩

/-- Knaster–Tarski least fixed point of a unary conjunctive grammar's language equations:
the componentwise intersection of all pre-fixed points. -/
def lfpUnary {k : ℕ} (G : BoolGrammar Unit k) : Fin k → Set ℕ :=
  fun A => { n | ∀ W : Fin k → Set ℕ, IsUnaryPreFixedPoint G W → n ∈ W A }

lemma lfpUnary_le_prefixed {k : ℕ} {G : BoolGrammar Unit k} {W : Fin k → Set ℕ}
    (hW : IsUnaryPreFixedPoint G W) (A : Fin k) :
    lfpUnary G A ⊆ W A :=
  fun _ hn => hn W hW

lemma lfpUnary_isUnarySol {k : ℕ} {G : BoolGrammar Unit k} (hconj : G.IsConjunctive) :
    IsUnarySol G (lfpUnary G) := by
  have hpre : IsUnaryPreFixedPoint G (lfpUnary G) := by
    intro A n hn W hW
    exact hW A (evalUnaryRHS_mono hconj (lfpUnary_le_prefixed hW) A hn)
  have hpost : ∀ A, lfpUnary G A ⊆ evalUnaryRHS G (lfpUnary G) A := by
    apply lfpUnary_le_prefixed
    intro A
    exact evalUnaryRHS_mono hconj hpre A
  intro A
  exact Set.Subset.antisymm (hpost A) (hpre A)

/-- Every unary conjunctive grammar (allowing arbitrary `ε`-rules and unit rules such as `S → S`)
admits a least fixed point `lfpUnary G`. -/
theorem lfpUnary_isLeastUnarySol {k : ℕ} {G : BoolGrammar Unit k} (hconj : G.IsConjunctive) :
    IsLeastUnarySol G (lfpUnary G) :=
  ⟨lfpUnary_isUnarySol hconj, fun _ hV => lfpUnary_le_prefixed (fun A => (hV A).symm.subset)⟩

lemma isLeastUnarySol_unique {k : ℕ} {G : BoolGrammar Unit k} {U V : Fin k → Set ℕ}
    (hU : IsLeastUnarySol G U) (hV : IsLeastUnarySol G V) : U = V := by
  funext A
  exact Set.Subset.antisymm (hU.2 V hV.1 A) (hV.2 U hU.1 A)

lemma generatesUnaryLFP_iff_lfpUnary {k : ℕ} {G : BoolGrammar Unit k}
    (hconj : G.IsConjunctive) (K : Set ℕ) :
    GeneratesUnaryLFP G K ↔ lfpUnary G G.start = K := by
  constructor
  · rintro ⟨U, hU, rfl⟩
    rw [isLeastUnarySol_unique (lfpUnary_isLeastUnarySol hconj) hU]
  · intro hK
    exact ⟨lfpUnary G, lfpUnary_isLeastUnarySol hconj, hK⟩

/-- Any global solution of a grammar with a strongly unique solution is the unique global
solution, and hence automatically the least fixed point (`IsLeastUnarySol`). -/
lemma isLeastUnarySol_of_hasStronglyUniqueUnarySol {k : ℕ} {G : BoolGrammar Unit k}
    (huniq : HasStronglyUniqueUnarySol G) {U : Fin k → Set ℕ} (hU : IsUnarySol G U) :
    IsLeastUnarySol G U := by
  refine ⟨hU, fun V hV A n hn => ?_⟩
  obtain ⟨W, _, hW_uniq⟩ := huniq n
  have h1 : truncUnaryVec n U = W := hW_uniq _ (isUnarySolMod_trunc_of_global hU n)
  have h2 : truncUnaryVec n V = W := hW_uniq _ (isUnarySolMod_trunc_of_global hV n)
  have heq : truncUnaryVec n U A = truncUnaryVec n V A := congrFun (h1.trans h2.symm) A
  have hmem : n ∈ truncUnaryVec n U A := ⟨hn, le_rfl⟩
  rw [heq] at hmem
  exact hmem.1

/-- Strongly-unique generation implies standard least-fixed-point generation. -/
theorem generatesUnaryLFP_of_generatesUnary {k : ℕ} {G : BoolGrammar Unit k} {K : Set ℕ}
    (hG : GeneratesUnary G K) : GeneratesUnaryLFP G K := by
  rcases hG with ⟨huniq, U, hU, hS⟩
  exact ⟨U, isLeastUnarySol_of_hasStronglyUniqueUnarySol huniq hU, hS⟩


/-! ## Section 2: Theorem B1 — Unary Restriction Lemma -/

section UnaryRestriction

variable {Alph : Type*} [DecidableEq Alph]

/-- Check whether every terminal symbol in `α` equals `a`. -/
def formOnlyChar (a : Alph) {k : ℕ} : Form Alph k → Bool
  | [] => true
  | Sum.inl b :: rest => decide (b = a) && formOnlyChar a rest
  | Sum.inr _ :: rest => formOnlyChar a rest

/-- Project a form over `Alph` to a unary form over `Unit` by erasing terminal identity. -/
def projectForm {k : ℕ} : Form Alph k → Form Unit k
  | [] => []
  | Sum.inl _ :: rest => Sum.inl () :: projectForm rest
  | Sum.inr A :: rest => Sum.inr A :: projectForm rest

/-- Restrict a `k`-nonterminal Boolean grammar over `Alph` to the unary alphabet `{a}`:
drop any rule that has a positive conjunct containing a symbol `b ≠ a`, and drop any negative
conjunct containing a symbol `b ≠ a` (since it is vacuously false on `{a}*`). -/
def restrictToChar {k : ℕ} (G : BoolGrammar Alph k) (a : Alph) : BoolGrammar Unit k where
  rules := (G.rules.filter (fun r => r.pos.all (formOnlyChar a))).map (fun r =>
    { lhs := r.lhs
      pos := r.pos.map projectForm
      neg := (r.neg.filter (formOnlyChar a)).map projectForm })
  start := G.start

lemma restrictToChar_isConjunctive {k : ℕ} (G : BoolGrammar Alph k) (a : Alph)
    (hconj : G.IsConjunctive) : (restrictToChar G a).IsConjunctive := by
  intro r' hr'
  simp only [restrictToChar, List.mem_map, List.mem_filter] at hr'
  rcases hr' with ⟨r, ⟨hr, _⟩, rfl⟩
  have ⟨hneg, hpos⟩ := hconj r hr
  simp [hneg, hpos]

lemma replicate_eq_append_iff {α : Type*} {a : α} {n : ℕ} {u v : List α} :
    List.replicate n a = u ++ v ↔
      u = List.replicate u.length a ∧ v = List.replicate v.length a ∧ n = u.length + v.length := by
  constructor
  · intro h
    have hlen : n = u.length + v.length := by
      have := congrArg List.length h
      simpa using this
    have hall : ∀ x ∈ u ++ v, x = a := by
      intro x hx
      rw [← h] at hx
      exact List.eq_of_mem_replicate hx
    refine ⟨?_, ?_, hlen⟩
    · apply List.eq_replicate_iff.mpr
      exact ⟨rfl, fun x hx => hall x (List.mem_append_left v hx)⟩
    · apply List.eq_replicate_iff.mpr
      exact ⟨rfl, fun x hx => hall x (List.mem_append_right u hx)⟩
  · rintro ⟨hu, hv, rfl⟩
    conv_rhs => rw [hu, hv]
    rw [← List.replicate_add]

lemma evalForm_replicate_false_of_other_char {k : ℕ} (a : Alph) (L : Fin k → Set (List Alph))
    (α : Form Alph k) (hbad : formOnlyChar a α = false) (n : ℕ) :
    List.replicate n a ∉ evalForm L α := by
  induction α generalizing n with
  | nil => simp [formOnlyChar] at hbad
  | cons s rest ih =>
    cases s with
    | inl b =>
      simp only [formOnlyChar, Bool.and_eq_false_iff, decide_eq_false_iff_not] at hbad
      rintro ⟨v, hv, hrep⟩
      cases n with
      | zero => simp at hrep
      | succ m =>
        simp only [List.replicate_succ, List.cons.injEq] at hrep
        rcases hbad with hne | hrest
        · exact hne hrep.1.symm
        · exact ih hrest m (hrep.2 ▸ hv)
    | inr A =>
      simp only [formOnlyChar] at hbad
      rintro ⟨u, _, v, hv, hrep⟩
      rcases replicate_eq_append_iff.mp hrep with ⟨_, hv_rep, _⟩
      exact ih hbad v.length (hv_rep ▸ hv)

lemma evalForm_replicate_iff {k : ℕ} (a : Alph) (L : Fin k → Set (List Alph))
    (α : Form Alph k) (hgood : formOnlyChar a α = true) (n : ℕ) :
    List.replicate n a ∈ evalForm L α ↔
      n ∈ evalUnaryForm (fun A => { m | List.replicate m a ∈ L A }) (projectForm α) := by
  induction α generalizing n with
  | nil =>
    simp only [projectForm, evalForm, evalUnaryForm, mem_singleton_iff]
    constructor
    · intro h; have := congrArg List.length h; simpa using this
    · rintro rfl; rfl
  | cons s rest ih =>
    cases s with
    | inl b =>
      simp only [formOnlyChar, Bool.and_eq_true, decide_eq_true_eq] at hgood
      rcases hgood with ⟨hb, hrest⟩
      subst hb
      simp only [projectForm, evalForm, evalUnaryForm, mem_ofPred_eq]
      constructor
      · rintro ⟨v, hv, hrep⟩
        cases n with
        | zero => simp at hrep
        | succ m =>
          simp only [List.replicate_succ, List.cons.injEq] at hrep
          exact ⟨m, (ih hrest m).mp (hrep.2 ▸ hv), rfl⟩
      · rintro ⟨m, hm, rfl⟩
        exact ⟨List.replicate m b, (ih hrest m).mpr hm, rfl⟩
    | inr A =>
      simp only [formOnlyChar] at hgood
      simp only [projectForm, evalForm, evalUnaryForm, mem_ofPred_eq]
      constructor
      · rintro ⟨u, hu, v, hv, hrep⟩
        rcases replicate_eq_append_iff.mp hrep with ⟨hu_rep, hv_rep, hlen⟩
        exact ⟨u.length, hu_rep ▸ hu, v.length, (ih hgood v.length).mp (hv_rep ▸ hv), hlen⟩
      · rintro ⟨u, hu, v, hv, rfl⟩
        exact ⟨List.replicate u a, hu, List.replicate v a, (ih hgood v).mpr hv,
          by rw [← List.replicate_add]⟩

lemma evalRHS_replicate_iff {k : ℕ} (G : BoolGrammar Alph k) (a : Alph)
    (L : Fin k → Set (List Alph)) (A : Fin k) (n : ℕ) :
    List.replicate n a ∈ evalRHS G L A ↔
      n ∈ evalUnaryRHS (restrictToChar G a)
        (fun B => { m | List.replicate m a ∈ L B }) A := by
  simp only [evalRHS, evalUnaryRHS, restrictToChar, List.mem_map, List.mem_filter, mem_ofPred_eq]
  constructor
  · rintro ⟨r, hr, hlhs, hp, hn⟩
    have hall : r.pos.all (formOnlyChar a) = true := by
      rw [List.all_eq_true]
      intro α hα
      by_contra hfalse
      have hf : formOnlyChar a α = false := Bool.eq_false_iff.mpr hfalse
      exact evalForm_replicate_false_of_other_char a L α hf n (hp α hα)
    refine ⟨_, ⟨r, ⟨hr, hall⟩, rfl⟩, hlhs, ?_, ?_⟩
    · intro α' hα'
      simp only [List.mem_map] at hα'
      rcases hα' with ⟨α, hα, rfl⟩
      have hgood : formOnlyChar a α = true := (List.all_eq_true.mp hall) α hα
      exact (evalForm_replicate_iff a L α hgood n).mp (hp α hα)
    · intro β' hβ' hmem
      simp only [List.mem_map, List.mem_filter] at hβ'
      rcases hβ' with ⟨β, ⟨hβ, hgood⟩, rfl⟩
      exact hn β hβ ((evalForm_replicate_iff a L β hgood n).mpr hmem)
  · rintro ⟨_, ⟨r, ⟨hr, hall⟩, rfl⟩, hlhs, hp, hn⟩
    refine ⟨r, hr, hlhs, ?_, ?_⟩
    · intro α hα
      have hgood : formOnlyChar a α = true := (List.all_eq_true.mp hall) α hα
      exact (evalForm_replicate_iff a L α hgood n).mpr
        (hp (projectForm α) (List.mem_map.mpr ⟨α, hα, rfl⟩))
    · intro β hβ hmem
      cases hgood : formOnlyChar a β
      · exact evalForm_replicate_false_of_other_char a L β hgood n hmem
      · have hmem' := (evalForm_replicate_iff a L β hgood n).mp hmem
        exact hn (projectForm β)
          (List.mem_map.mpr ⟨β, List.mem_filter.mpr ⟨hβ, hgood⟩, rfl⟩) hmem'

omit [DecidableEq Alph] in
/-- A string `w` of length `ℓ` that is NOT `List.replicate ℓ a` can never depend on membership of
`List.replicate ℓ a` in any `L B`, because any substring of `w` of length `ℓ` must equal `w`. -/
lemma evalForm_congr_ignore_rep {k : ℕ} (a : Alph) (ℓ : ℕ) {L₁ L₂ : Fin k → Set (List Alph)}
    (h : ∀ B u, u.length ≤ ℓ → u ≠ List.replicate ℓ a → (u ∈ L₁ B ↔ u ∈ L₂ B)) :
    ∀ (α : Form Alph k) (w : List Alph), w.length ≤ ℓ → w ≠ List.replicate ℓ a →
      (w ∈ evalForm L₁ α ↔ w ∈ evalForm L₂ α) := by
  intro α
  induction α with
  | nil => intro w _ _; rfl
  | cons s rest ih =>
    intro w hw hne
    cases s with
    | inl b =>
      simp only [evalForm, mem_ofPred_eq]
      constructor <;> rintro ⟨v, hv, rfl⟩ <;> refine ⟨v, ?_, rfl⟩
      · have hv_lt : v.length < ℓ := by simp at hw; omega
        exact (ih v (by omega) (fun heq => by have := congrArg List.length heq; simp at this; omega)).mp hv
      · have hv_lt : v.length < ℓ := by simp at hw; omega
        exact (ih v (by omega) (fun heq => by have := congrArg List.length heq; simp at this; omega)).mpr hv
    | inr A =>
      simp only [evalForm, mem_ofPred_eq]
      constructor <;> rintro ⟨u, hu, v, hv, rfl⟩
      · have hu_le : u.length ≤ ℓ := by simp at hw; omega
        have hv_le : v.length ≤ ℓ := by simp at hw; omega
        have hu_ne : u ≠ List.replicate ℓ a := by
          intro hu_eq
          have hv0 : v.length = 0 := by
            have := congrArg List.length hu_eq; simp at hw this; omega
          rw [List.length_eq_zero_iff.mp hv0, List.append_nil] at hne
          exact hne hu_eq
        have hv_ne : v ≠ List.replicate ℓ a := by
          intro hv_eq
          have hu0 : u.length = 0 := by
            have := congrArg List.length hv_eq; simp at hw this; omega
          rw [List.length_eq_zero_iff.mp hu0, List.nil_append] at hne
          exact hne hv_eq
        exact ⟨u, (h A u hu_le hu_ne).mp hu, v, (ih v hv_le hv_ne).mp hv, rfl⟩
      · have hu_le : u.length ≤ ℓ := by simp at hw; omega
        have hv_le : v.length ≤ ℓ := by simp at hw; omega
        have hu_ne : u ≠ List.replicate ℓ a := by
          intro hu_eq
          have hv0 : v.length = 0 := by
            have := congrArg List.length hu_eq; simp at hw this; omega
          rw [List.length_eq_zero_iff.mp hv0, List.append_nil] at hne
          exact hne hu_eq
        have hv_ne : v ≠ List.replicate ℓ a := by
          intro hv_eq
          have hu0 : u.length = 0 := by
            have := congrArg List.length hv_eq; simp at hw this; omega
          rw [List.length_eq_zero_iff.mp hu0, List.nil_append] at hne
          exact hne hv_eq
        exact ⟨u, (h A u hu_le hu_ne).mpr hu, v, (ih v hv_le hv_ne).mpr hv, rfl⟩

/-- **Theorem B1 (Unary Restriction Lemma):**
If a `k`-nonterminal Boolean grammar `G` over `Alph` generates `K`, then for every `a : Alph`,
the unary slice `{ n : ℕ | List.replicate n a ∈ K }` is generated by the `k`-nonterminal
unary Boolean grammar `restrictToChar G a` (which is conjunctive whenever `G` is conjunctive). -/
theorem unary_restriction_theorem {k : ℕ} (G : BoolGrammar Alph k) (a : Alph) (K : Set (List Alph))
    (hG : Generates G K) :
    GeneratesUnary (restrictToChar G a) { n : ℕ | List.replicate n a ∈ K } := by
  rcases hG with ⟨huniq, L_G, hLG_eq, hLG_start⟩
  let U_G : Fin k → Set ℕ := fun A => { n | List.replicate n a ∈ L_G A }
  have hUG_eq : ∀ A, U_G A = evalUnaryRHS (restrictToChar G a) U_G A := by
    intro A; ext n
    simp only [U_G, mem_ofPred_eq]
    rw [hLG_eq A, evalRHS_replicate_iff]
  refine ⟨?_, U_G, hUG_eq, ?_⟩
  · -- Prove `HasStronglyUniqueUnarySol (restrictToChar G a)` by strong induction on `ℓ`.
    intro ℓ
    induction ℓ using Nat.strong_induction_on with
    | h ℓ ih =>
      refine ⟨truncUnaryVec ℓ U_G, isUnarySolMod_trunc_of_global hUG_eq ℓ, ?_⟩
      intro U hU
      -- Step 1: On lengths `< ℓ`, `U` agrees with `U_G` by the induction hypothesis.
      have hlt : ∀ m < ℓ, ∀ A, m ∈ U A ↔ m ∈ U_G A := by
        intro m hm
        have htrunc : IsUnarySolMod (restrictToChar G a) m (truncUnaryVec m U) := by
          refine ⟨fun A n hn => hn.2, fun A => ?_⟩
          ext n
          simp only [truncUnaryVec, truncNat, mem_ofPred_eq]
          have hcongr : ∀ B j, j ≤ m → (j ∈ truncUnaryVec m U B ↔ j ∈ U B) := by
            intro B j hj; simp [truncUnaryVec, truncNat, hj]
          constructor
          · rintro ⟨hnU, hnm⟩
            have hnR : n ∈ truncNat ℓ (evalUnaryRHS (restrictToChar G a) U A) := hU.2 A ▸ hnU
            exact ⟨(evalUnaryRHS_congr_le _ hcongr A hnm).mpr hnR.1, hnm⟩
          · rintro ⟨hnR, hnm⟩
            have hnle : n ≤ ℓ := by omega
            refine ⟨?_, hnm⟩
            rw [hU.2 A]
            exact ⟨(evalUnaryRHS_congr_le _ hcongr A hnm).mp hnR, hnle⟩
        obtain ⟨U_m, hUm_sol, hUm_uniq⟩ := ih m hm
        have h1 : truncUnaryVec m U = U_m := hUm_uniq _ htrunc
        have h2 : truncUnaryVec m U_G = U_m := hUm_uniq _ (isUnarySolMod_trunc_of_global hUG_eq m)
        intro A
        have heq := congrFun (h1.trans h2.symm) A
        have hmem := Set.ext_iff.mp heq m
        simpa [truncUnaryVec, truncNat] using hmem
      -- Step 2: Patch `truncVec ℓ L_G` at the single string `List.replicate ℓ a` using `U`.
      let L_patch : Fin k → Set (List Alph) := fun A =>
        { w | w.length ≤ ℓ ∧
          ((w = List.replicate ℓ a ∧ ℓ ∈ U A) ∨ (w ≠ List.replicate ℓ a ∧ w ∈ L_G A)) }
      have hpatch_nonrep : ∀ B u, u.length ≤ ℓ → u ≠ List.replicate ℓ a →
          (u ∈ L_patch B ↔ u ∈ L_G B) := by
        intro B u hu hne
        simp [L_patch, hu, hne]
      have hpatch_rep : ∀ B n, n ≤ ℓ → (List.replicate n a ∈ L_patch B ↔ n ∈ U B) := by
        intro B n hn
        simp only [L_patch, List.length_replicate, hn, true_and, mem_ofPred_eq]
        by_cases hne : n = ℓ
        · subst hne; simp
        · have hrep_ne : List.replicate n a ≠ List.replicate ℓ a := fun h =>
            hne (by have := congrArg List.length h; simpa using this)
          simp only [hrep_ne, false_and, false_or]
          exact ⟨fun h => (hlt n (by omega) B).mpr h.2, fun h => ⟨hrep_ne, (hlt n (by omega) B).mp h⟩⟩
      have hpatch_sol : IsSolMod G ℓ L_patch := by
        refine ⟨fun A w hw => hw.1, fun A => ?_⟩
        ext w
        simp only [truncLang, mem_ofPred_eq]
        by_cases hwlen : w.length ≤ ℓ
        · by_cases hwrep : w = List.replicate ℓ a
          · subst hwrep
            simp only [List.length_replicate, le_refl, and_true]
            rw [hpatch_rep A ℓ le_rfl, evalRHS_replicate_iff]
            have hU_rhs : ℓ ∈ U A ↔ ℓ ∈ evalUnaryRHS (restrictToChar G a) U A := by
              have := Set.ext_iff.mp (hU.2 A) ℓ
              simpa [truncNat] using this
            rw [hU_rhs]
            exact evalUnaryRHS_congr_le (restrictToChar G a)
              (fun B m hm => (hpatch_rep B m hm).symm) A le_rfl
          · simp only [hwlen, and_true]
            rw [hpatch_nonrep A w hwlen hwrep, hLG_eq A]
            simp only [evalRHS, evalRule, mem_ofPred_eq]
            constructor
            · rintro ⟨r, hr, hlhs, hp, hn⟩
              refine ⟨r, hr, hlhs, ?_, ?_⟩
              · intro α hα
                exact (evalForm_congr_ignore_rep a ℓ hpatch_nonrep α w hwlen hwrep).mpr (hp α hα)
              · intro β hβ hmem
                exact hn β hβ
                  ((evalForm_congr_ignore_rep a ℓ hpatch_nonrep β w hwlen hwrep).mp hmem)
            · rintro ⟨r, hr, hlhs, hp, hn⟩
              refine ⟨r, hr, hlhs, ?_, ?_⟩
              · intro α hα
                exact (evalForm_congr_ignore_rep a ℓ hpatch_nonrep α w hwlen hwrep).mp (hp α hα)
              · intro β hβ hmem
                exact hn β hβ
                  ((evalForm_congr_ignore_rep a ℓ hpatch_nonrep β w hwlen hwrep).mpr hmem)
        · simp [L_patch, hwlen]
      -- Step 3: By strong uniqueness of `G` mod `ℓ`, `L_patch = truncVec ℓ L_G`.
      obtain ⟨L_ℓ, _, hL_ℓ_uniq⟩ := huniq ℓ
      have h1 : L_patch = L_ℓ := hL_ℓ_uniq _ hpatch_sol
      have h2 : truncVec ℓ L_G = L_ℓ := hL_ℓ_uniq _ (isSolMod_truncVec_of_global hLG_eq ℓ)
      have hpatch_eq : L_patch = truncVec ℓ L_G := h1.trans h2.symm
      funext A; ext n
      simp only [truncUnaryVec, truncNat, mem_ofPred_eq]
      constructor
      · intro hnU
        have hnle := hU.1 A n hnU
        refine ⟨?_, hnle⟩
        have hmem : List.replicate n a ∈ L_patch A := (hpatch_rep A n hnle).mpr hnU
        rw [hpatch_eq] at hmem
        exact hmem.1
      · rintro ⟨hnUG, hnle⟩
        have hmem : List.replicate n a ∈ truncVec ℓ L_G A := ⟨hnUG, by simpa using hnle⟩
        rw [← hpatch_eq] at hmem
        exact (hpatch_rep A n hnle).mp hmem
  · ext n; simp [U_G, restrictToChar, hLG_start]

end UnaryRestriction


/-! ## Section 3: Theorem B2 — Unconditional 1-Nonterminal Lower Bound -/

section OneNTLowerBound

/-- The `e`-fold Minkowski sumset of `S ⊆ ℕ`. -/
def sumset (S : Set ℕ) : ℕ → Set ℕ
  | 0 => {0}
  | e + 1 => { m | ∃ u ∈ S, ∃ v ∈ sumset S e, m = u + v }

lemma sumset_add {S : Set ℕ} {e₁ e₂ m₁ m₂ : ℕ}
    (h₁ : m₁ ∈ sumset S e₁) (h₂ : m₂ ∈ sumset S e₂) :
    m₁ + m₂ ∈ sumset S (e₁ + e₂) := by
  induction e₁ generalizing m₁ with
  | zero =>
    simp only [sumset, mem_singleton_iff] at h₁
    subst h₁; simpa using h₂
  | succ e ih =>
    rcases h₁ with ⟨u, hu, v, hv, rfl⟩
    rw [Nat.succ_add]
    exact ⟨u, hu, v + m₂, ih hv, by omega⟩

lemma evalUnaryForm_one_nt (U : Fin 1 → Set ℕ) (α : Form Unit 1) (n : ℕ) :
    n ∈ evalUnaryForm U α ↔ ∃ m ∈ sumset (U 0) (ntCount α), n = constCount α + m := by
  induction α generalizing n with
  | nil =>
    simp [evalUnaryForm, sumset, constCount, ntCount]
  | cons s rest ih =>
    cases s with
    | inl u =>
      cases u
      simp only [evalUnaryForm, constCount, ntCount, mem_ofPred_eq]
      constructor
      · rintro ⟨m, hm, rfl⟩
        rcases (ih m).mp hm with ⟨k, hk, rfl⟩
        exact ⟨k, hk, by omega⟩
      · rintro ⟨k, hk, rfl⟩
        exact ⟨constCount rest + k, (ih _).mpr ⟨k, hk, rfl⟩, by omega⟩
    | inr A =>
      have hA : A = 0 := Fin.eq_zero A
      subst hA
      simp only [evalUnaryForm, constCount, ntCount, sumset, mem_ofPred_eq]
      constructor
      · rintro ⟨u, hu, v, hv, rfl⟩
        rcases (ih v).mp hv with ⟨k, hk, rfl⟩
        exact ⟨u + k, ⟨u, hu, k, hk, rfl⟩, by omega⟩
      · rintro ⟨m, ⟨u, hu, k, hk, rfl⟩, rfl⟩
        exact ⟨u, hu, constCount rest + k, (ih _).mpr ⟨k, hk, rfl⟩, by omega⟩

/-- Sum of base-`B` digits of `n` (for `B ≥ 2`). -/
def digitSum (B : ℕ) (n : ℕ) : ℕ :=
  if _hB : 2 ≤ B then
    if _hn : n = 0 then 0
    else n % B + digitSum B (n / B)
  else 0
termination_by n
decreasing_by
  exact Nat.div_lt_self (Nat.pos_of_ne_zero _hn) (by omega)

lemma digitSum_zero {B : ℕ} : digitSum B 0 = 0 := by
  rw [digitSum]
  simp

lemma digitSum_eq {B n : ℕ} (hB : 2 ≤ B) (hn : n ≠ 0) :
    digitSum B n = n % B + digitSum B (n / B) := by
  conv_lhs => rw [digitSum]
  simp [hB, hn]

lemma digitSum_mul_add {B q r : ℕ} (hB : 2 ≤ B) (hr : r < B) :
    digitSum B (B * q + r) = r + digitSum B q := by
  by_cases h0 : B * q + r = 0
  · have hq : q = 0 := by nlinarith
    have hr0 : r = 0 := by omega
    subst hq; subst hr0; simp [digitSum_zero]
  · rw [digitSum_eq hB h0]
    have hmod : (B * q + r) % B = r := by
      rw [Nat.mul_add_mod, Nat.mod_eq_of_lt hr]
    have hdiv : (B * q + r) / B = q := by
      rw [Nat.mul_add_div (by omega), Nat.div_eq_of_lt hr, Nat.add_zero]
    rw [hmod, hdiv]

lemma digitSum_of_lt {B r : ℕ} (hB : 2 ≤ B) (hr : r < B) : digitSum B r = r := by
  have := digitSum_mul_add hB hr (q := 0)
  simpa [digitSum_zero] using this

lemma digitSum_mul_pow_add {B a q r : ℕ} (hB : 2 ≤ B) (hr : r < B ^ a) :
    digitSum B (B ^ a * q + r) = digitSum B r + digitSum B q := by
  induction a generalizing r with
  | zero =>
    have hr0 : r = 0 := by simpa using hr
    subst hr0; simp [digitSum_zero]
  | succ a ih =>
    have hdiv : r / B < B ^ a := by
      rw [Nat.div_lt_iff_lt_mul (by omega)]
      simpa [pow_succ] using hr
    have hmod : r % B < B := Nat.mod_lt r (by omega)
    have hsplit : B ^ (a + 1) * q + r = B * (B ^ a * q + r / B) + r % B := by
      have := Nat.div_add_mod r B
      rw [pow_succ']; linarith
    rw [hsplit, digitSum_mul_add hB hmod, ih hdiv]
    have hr_eq : r = B * (r / B) + r % B := (Nat.div_add_mod r B).symm
    conv_rhs => rw [hr_eq, digitSum_mul_add hB hmod]
    omega

lemma digitSum_pow {B k : ℕ} (hB : 2 ≤ B) : digitSum B (B ^ k) = 1 := by
  have := digitSum_mul_pow_add hB (a := k) (q := 1) (r := 0) (by positivity)
  simpa [digitSum_zero, digitSum_of_lt hB (by omega : 1 < B)] using this

lemma digitSum_pow_sub_one {B d : ℕ} (hB : 2 ≤ B) :
    digitSum B (B ^ d - 1) = d * (B - 1) := by
  induction d with
  | zero => simp [digitSum_zero]
  | succ d ih =>
    have hpos : 1 ≤ B ^ d := Nat.one_le_pow d B (by omega)
    have hpos1 : 1 ≤ B * B ^ d := by nlinarith
    have heq : B ^ (d + 1) - 1 = B * (B ^ d - 1) + (B - 1) := by
      rw [pow_succ']
      zify [hpos, hpos1, (by omega : 1 ≤ B)]
      ring
    rw [heq, digitSum_mul_add hB (by omega), ih]
    ring

lemma digitSum_add_le {B : ℕ} (hB : 2 ≤ B) :
    ∀ s u v : ℕ, u + v = s → digitSum B (u + v) ≤ digitSum B u + digitSum B v := by
  intro s
  induction s using Nat.strong_induction_on with
  | h s ih =>
    intro u v huv
    have hu_eq : u = B * (u / B) + u % B := (Nat.div_add_mod u B).symm
    have hv_eq : v = B * (v / B) + v % B := (Nat.div_add_mod v B).symm
    have hur : u % B < B := Nat.mod_lt u (by omega)
    have hvr : v % B < B := Nat.mod_lt v (by omega)
    have hdu : digitSum B u = u % B + digitSum B (u / B) := by
      conv_lhs => rw [hu_eq]
      exact digitSum_mul_add hB hur
    have hdv : digitSum B v = v % B + digitSum B (v / B) := by
      conv_lhs => rw [hv_eq]
      exact digitSum_mul_add hB hvr
    by_cases hsum : u % B + v % B < B
    · have hcomb : u + v = B * (u / B + v / B) + (u % B + v % B) := by
        have h1 := Nat.div_add_mod u B; have h2 := Nat.div_add_mod v B; linarith
      rw [hcomb, digitSum_mul_add hB hsum, hdu, hdv]
      by_cases h0 : u / B + v / B = 0
      · rw [h0, digitSum_zero]; omega
      · have hlt : u / B + v / B < s := by
          have : 2 * (u / B + v / B) ≤ B * (u / B + v / B) := Nat.mul_le_mul_right _ hB
          omega
        have hstep := ih (u / B + v / B) hlt (u / B) (v / B) rfl
        omega
    · have hcarry : u % B + v % B - B < B := by omega
      have hcomb : u + v = B * (u / B + v / B + 1) + (u % B + v % B - B) := by
        have h1 := Nat.div_add_mod u B; have h2 := Nat.div_add_mod v B
        have hge : B ≤ u % B + v % B := by omega
        zify [hge]; linarith
      rw [hcomb, digitSum_mul_add hB hcarry, hdu, hdv]
      have hlt1 : u / B + v / B + 1 < s := by
        have h1 := Nat.div_add_mod u B; have h2 := Nat.div_add_mod v B
        have h3 : 2 * (u / B + v / B) ≤ B * (u / B + v / B) := Nat.mul_le_mul_right _ hB
        have h4 : B * (u / B + v / B) = B * (u / B) + B * (v / B) := Nat.mul_add B _ _
        omega
      have hstep1 := ih (u / B + v / B + 1) hlt1 (u / B + v / B) 1 rfl
      have hlt2 : u / B + v / B < s := by omega
      have hstep2 := ih (u / B + v / B) hlt2 (u / B) (v / B) rfl
      have hd1 : digitSum B 1 = 1 := digitSum_of_lt hB (by omega)
      omega

/-- The power language `{ B ^ k | k : ℕ }`. -/
def powLang (B : ℕ) : Set ℕ := { m | ∃ k : ℕ, m = B ^ k }

lemma digitSum_sumset_powLang_le {B e m : ℕ} (hB : 2 ≤ B)
    (hm : m ∈ sumset (powLang B) e) : digitSum B m ≤ e := by
  induction e generalizing m with
  | zero =>
    simp only [sumset, mem_singleton_iff] at hm
    subst hm; simp [digitSum_zero]
  | succ e ih =>
    rcases hm with ⟨u, ⟨k, rfl⟩, v, hv, rfl⟩
    have h1 := digitSum_add_le hB (B ^ k + v) (B ^ k) v rfl
    have h2 := digitSum_pow (k := k) hB
    have h3 := ih hv
    omega

lemma modEq_sumset_powLang {B e m : ℕ} (hB : 2 ≤ B)
    (hm : m ∈ sumset (powLang B) e) : m ≡ e [MOD B - 1] := by
  induction e generalizing m with
  | zero =>
    simp only [sumset, mem_singleton_iff] at hm
    subst hm; rfl
  | succ e ih =>
    rcases hm with ⟨u, ⟨k, rfl⟩, v, hv, rfl⟩
    have hB1 : B ≡ 1 [MOD B - 1] := by
      have : B = (B - 1) + 1 := by omega
      conv_lhs => rw [this]
      exact Nat.ModEq.add_right 1 (Nat.modEq_zero_iff_dvd.mpr dvd_rfl)
    have hpow : B ^ k ≡ 1 [MOD B - 1] := by simpa using hB1.pow k
    have hadd := hpow.add (ih hv)
    simpa [Nat.add_comm] using hadd

lemma pow_mem_sumset_powLang {B : ℕ} (hB : 2 ≤ B) :
    ∀ t k, t ≤ k → B ^ k ∈ sumset (powLang B) (1 + t * (B - 1)) := by
  intro t
  induction t with
  | zero =>
    intro k _
    simp only [zero_mul, add_zero]
    exact ⟨B ^ k, ⟨k, rfl⟩, 0, rfl, by omega⟩
  | succ t ih =>
    intro k hk
    have hk1 : 1 ≤ k := by omega
    have hbase : B ^ (k - 1) ∈ sumset (powLang B) (1 + t * (B - 1)) := ih (k - 1) (by omega)
    have hcopies : ∀ c, c * B ^ (k - 1) ∈ sumset (powLang B) c := by
      intro c
      induction c with
      | zero => simp [sumset]
      | succ c ihc =>
        refine ⟨B ^ (k - 1), ⟨k - 1, rfl⟩, c * B ^ (k - 1), ihc, ?_⟩
        ring
    have hsum := sumset_add hbase (hcopies (B - 1))
    have hval : B ^ (k - 1) + (B - 1) * B ^ (k - 1) = B ^ k := by
      have hk_eq : k = (k - 1) + 1 := by omega
      conv_rhs => rw [hk_eq, pow_succ']
      have : 1 + (B - 1) = B := by omega
      calc B ^ (k - 1) + (B - 1) * B ^ (k - 1)
          = (1 + (B - 1)) * B ^ (k - 1) := by ring
        _ = B * B ^ (k - 1) := by rw [this]
    have hcnt : 1 + t * (B - 1) + (B - 1) = 1 + (t + 1) * (B - 1) := by ring
    rwa [hval, hcnt] at hsum

/-- Geometric sum `∑_{i < m} B ^ (a + i)` as a simple recursive function. -/
def geomPowSum (B a : ℕ) : ℕ → ℕ
  | 0 => 0
  | m + 1 => geomPowSum B a m + B ^ (a + m)

lemma geomPowSum_lt {B a m : ℕ} (hB : 2 ≤ B) : geomPowSum B a m < B ^ (a + m) := by
  induction m with
  | zero =>
    simp only [geomPowSum, Nat.add_zero]
    exact Nat.pos_of_ne_zero (by positivity)
  | succ m ih =>
    simp only [geomPowSum]
    have h1 : B ^ (a + (m + 1)) = B * B ^ (a + m) := by
      rw [← Nat.add_assoc, pow_succ']
    have h2 : 2 * B ^ (a + m) ≤ B * B ^ (a + m) := Nat.mul_le_mul_right _ hB
    omega

lemma geomPowSum_factor {B a m : ℕ} : geomPowSum B a m = B ^ a * geomPowSum B 0 m := by
  induction m with
  | zero => simp [geomPowSum]
  | succ m ih =>
    simp only [geomPowSum, ih, Nat.zero_add, pow_add]
    ring

lemma geomPowSum_digitSum {B m : ℕ} (hB : 2 ≤ B) :
    ∀ a, digitSum B (geomPowSum B a m) = m := by
  induction m with
  | zero => intro a; simp [geomPowSum, digitSum_zero]
  | succ m ih =>
    intro a
    have hlt : geomPowSum B a m < B ^ (a + m) := geomPowSum_lt hB
    have h := digitSum_mul_pow_add hB (a := a + m) (q := 1) (r := geomPowSum B a m) hlt
    simp only [mul_one] at h
    rw [geomPowSum, add_comm, h, ih a, digitSum_of_lt hB (by omega : 1 < B)]

lemma geomPowSum_mem_sumset {B a m : ℕ} :
    geomPowSum B a m ∈ sumset (powLang B) m := by
  induction m with
  | zero => simp [geomPowSum, sumset]
  | succ m ih =>
    exact ⟨B ^ (a + m), ⟨a + m, rfl⟩, geomPowSum B a m, ih, by simp [geomPowSum, Nat.add_comm]⟩

lemma digitSum_sub_ge_of_mul_pow {B k₀ d q c : ℕ} (hB : 2 ≤ B)
    (hq : 1 ≤ q) (hc1 : 1 ≤ c) (hc2 : c < B ^ k₀) :
    d * (B - 1) ≤ digitSum B (B ^ (k₀ + d) * q - c) := by
  have hpow_ge : B ^ k₀ ≤ B ^ (k₀ + d) := Nat.pow_le_pow_right (by omega) (by omega)
  have hle_mul : B ^ (k₀ + d) ≤ B ^ (k₀ + d) * q := Nat.le_mul_of_pos_right _ (by omega)
  have hdecomp1 : B ^ (k₀ + d) * q - c = B ^ (k₀ + d) * (q - 1) + (B ^ (k₀ + d) - c) := by
    zify [hq, (by omega : c ≤ B ^ (k₀ + d) * q), (by omega : c ≤ B ^ (k₀ + d))]
    ring
  rw [hdecomp1, digitSum_mul_pow_add hB (by omega : B ^ (k₀ + d) - c < B ^ (k₀ + d))]
  have h1 : 1 ≤ B ^ d := Nat.one_le_pow d B (by omega)
  have hc_prod : c ≤ B ^ k₀ * B ^ d := by rw [← pow_add]; omega
  have hdecomp2 : B ^ (k₀ + d) - c = B ^ k₀ * (B ^ d - 1) + (B ^ k₀ - c) := by
    rw [pow_add]
    zify [h1, hc_prod, (by omega : c ≤ B ^ k₀)]
    ring
  rw [hdecomp2, digitSum_mul_pow_add hB (by omega : B ^ k₀ - c < B ^ k₀),
    digitSum_pow_sub_one hB]
  omega

/-- Maximum of a list of natural numbers. -/
def listMax : List ℕ → ℕ
  | [] => 0
  | x :: xs => max x (listMax xs)

lemma le_listMax {x : ℕ} {xs : List ℕ} (hx : x ∈ xs) : x ≤ listMax xs := by
  induction xs with
  | nil => cases hx
  | cons y ys ih =>
    simp only [listMax]
    rcases List.mem_cons.mp hx with rfl | hy
    · exact le_max_left _ _
    · exact le_trans (ih hy) (le_max_right _ _)

/-- Core witness lemma for Theorem B2: for every integer base `B ≥ 2`, every 1-nonterminal unary
Boolean grammar `G` (with arbitrary finite rules, conjunctions, negations, `ε`-rules, and unit
rules), and every global fixed point `U₀` with `U₀ G.start = powLang B`, there exists `n₁ ∈ U₀ 0`
such that `U_flip := fun _ => { m ∈ U₀ 0 | m < n₁ }` is a solution modulo `n₁`. -/
lemma exists_flip_solMod_of_powLang (B : ℕ) (hB : 2 ≤ B) (G : BoolGrammar Unit 1)
    (U₀ : Fin 1 → Set ℕ) (hU₀_eq : IsUnarySol G U₀) (hU₀_start : U₀ G.start = powLang B) :
    ∃ n₁ ∈ U₀ 0, IsUnarySolMod G n₁ (fun _ => { m ∈ U₀ 0 | m < n₁ }) := by
  have hU₀_zero : U₀ 0 = powLang B := by
    have hst : G.start = 0 := Fin.eq_zero G.start
    rwa [← hst]
  have hzero_not_mem : 0 ∉ U₀ 0 := by
    rw [hU₀_zero]
    rintro ⟨k, hk⟩
    have : 1 ≤ B ^ k := Nat.one_le_pow k B (by omega)
    omega
  -- Collect all sentential forms occurring in `G` and bound `constCount`, `ntCount`.
  let allForms : List (Form Unit 1) := G.rules.flatMap (fun r => r.pos ++ r.neg)
  let C_max : ℕ := listMax (allForms.map constCount)
  let E_max : ℕ := listMax (allForms.map ntCount)
  have hC_bound : ∀ r ∈ G.rules, ∀ α ∈ r.pos ++ r.neg, constCount α ≤ C_max := by
    intro r hr α hα
    apply le_listMax
    exact List.mem_map.mpr ⟨α, List.mem_flatMap.mpr ⟨r, hr, hα⟩, rfl⟩
  have hE_bound : ∀ r ∈ G.rules, ∀ α ∈ r.pos ++ r.neg, ntCount α ≤ E_max := by
    intro r hr α hα
    apply le_listMax
    exact List.mem_map.mpr ⟨α, List.mem_flatMap.mpr ⟨r, hr, hα⟩, rfl⟩
  -- Choose `k₀ = C_max + 1`, `d = E_max + 2`, `a_min = k₀ + d`, and compare `n₁` vs `n₂`.
  let k₀ : ℕ := C_max + 1
  let d : ℕ := E_max + 2
  let a_min : ℕ := k₀ + d
  let n₁ : ℕ := B ^ (a_min + (B - 1))
  let n₂ : ℕ := geomPowSum B a_min B
  have hC_lt_pow : C_max < B ^ k₀ := by
    have h1 : k₀ < 2 ^ k₀ := Nat.lt_two_pow_self
    have h2 : 2 ^ k₀ ≤ B ^ k₀ := Nat.pow_le_pow_left hB k₀
    omega
  have hn₁_mem : n₁ ∈ U₀ 0 := by
    rw [hU₀_zero]; exact ⟨a_min + (B - 1), rfl⟩
  have hn₂_not_mem : n₂ ∉ U₀ 0 := by
    rw [hU₀_zero]
    rintro ⟨k, hk⟩
    have hlow : B ^ (a_min + (B - 1)) < n₂ := by
      have hB_eq : B = (B - 1) + 1 := by omega
      have hn₂_step : n₂ = geomPowSum B a_min (B - 1) + B ^ (a_min + (B - 1)) := by
        dsimp only [n₂]
        conv_lhs => arg 3; rw [hB_eq]
        rfl
      have hpos : 1 ≤ geomPowSum B a_min (B - 1) := by
        cases hBm1 : B - 1 with
        | zero => omega
        | succ m =>
          simp only [geomPowSum]
          have : 1 ≤ B ^ (a_min + m) := Nat.one_le_pow _ B (by omega)
          omega
      omega
    have hhigh : n₂ < B ^ (a_min + B) := geomPowSum_lt hB
    have hlt1 : a_min + (B - 1) < k := by
      by_contra hle
      have : B ^ k ≤ B ^ (a_min + (B - 1)) := Nat.pow_le_pow_right (by omega) (by omega)
      omega
    have hlt2 : k < a_min + B := by
      by_contra hle
      have : B ^ (a_min + B) ≤ B ^ k := Nat.pow_le_pow_right (by omega) (by omega)
      omega
    omega
  -- Key lemma: every conjunct `(c, e) ≠ (0, 1)` with `c ≤ C_max, e ≤ E_max` has the EXACT SAME
  -- truth value at `n₁` and `n₂` under `U₀`.
  have hconj_eq : ∀ α : Form Unit 1, constCount α ≤ C_max → ntCount α ≤ E_max →
      ¬(constCount α = 0 ∧ ntCount α = 1) →
      (n₁ ∈ evalUnaryForm U₀ α ↔ n₂ ∈ evalUnaryForm U₀ α) := by
    intro α hc he hne
    rw [evalUnaryForm_one_nt, evalUnaryForm_one_nt, hU₀_zero]
    set c := constCount α
    set e := ntCount α
    by_cases he0 : e = 0
    · -- Case 1: `e = 0` — both false since `n₁, n₂ > C_max ≥ c`.
      have hn₁_gt : c < n₁ := by
        have : B ^ k₀ ≤ n₁ := Nat.pow_le_pow_right (by omega) (by omega)
        omega
      have hn₂_gt : c < n₂ := by
        have hB_eq : B = (B - 1) + 1 := by omega
        have : n₂ = geomPowSum B a_min (B - 1) + n₁ := by
          dsimp only [n₂, n₁]
          conv_lhs => arg 3; rw [hB_eq]
          rfl
        omega
      rw [he0]
      simp only [sumset, mem_singleton_iff, exists_eq_left, add_zero]
      constructor <;> intro h <;> omega
    · by_cases hc0 : c = 0
      · -- Case `c = 0, e ≥ 1`: since `(c, e) ≠ (0, 1)`, we have `e ≥ 2`.
        have he2 : 2 ≤ e := by omega
        rw [hc0]
        simp only [zero_add, exists_eq_right']
        by_cases heB : e < B
        · -- Case 2: `2 ≤ e < B` — both false!
          have hn₁_f : n₁ ∉ sumset (powLang B) e := by
            intro hm
            have hmod := modEq_sumset_powLang hB hm
            have hn₁_mod : n₁ ≡ 1 [MOD B - 1] := by
              have hB1 : B ≡ 1 [MOD B - 1] := by
                have : B = (B - 1) + 1 := by omega
                conv_lhs => rw [this]
                exact Nat.ModEq.add_right 1 (Nat.modEq_zero_iff_dvd.mpr dvd_rfl)
              simpa [n₁] using hB1.pow (a_min + (B - 1))
            have h1e : 1 ≡ e [MOD B - 1] := hn₁_mod.symm.trans hmod
            have hmod1 : 1 % (B - 1) = 1 := Nat.mod_eq_of_lt (by omega)
            have hmode : e % (B - 1) ≠ 1 := by
              by_cases htop : e = B - 1
              · rw [htop, Nat.mod_self]; omega
              · rw [Nat.mod_eq_of_lt (by omega)]; omega
            exact hmode (by have h := h1e.symm; rw [Nat.ModEq] at h; omega)
          have hn₂_f : n₂ ∉ sumset (powLang B) e := by
            intro hm
            have hds := digitSum_sumset_powLang_le hB hm
            have hds2 : digitSum B n₂ = B := geomPowSum_digitSum hB a_min
            omega
          exact ⟨fun h => absurd h hn₁_f, fun h => absurd h hn₂_f⟩
        · -- Case 3: `e ≥ B` — both hold iff `e ≡ 1 [MOD B - 1]`!
          have hn₁_mod : n₁ ≡ 1 [MOD B - 1] := by
            have hB1 : B ≡ 1 [MOD B - 1] := by
              have : B = (B - 1) + 1 := by omega
              conv_lhs => rw [this]
              exact Nat.ModEq.add_right 1 (Nat.modEq_zero_iff_dvd.mpr dvd_rfl)
            simpa [n₁] using hB1.pow (a_min + (B - 1))
          have hn₂_mod : n₂ ≡ 1 [MOD B - 1] := by
            have h1 : n₂ ∈ sumset (powLang B) B := geomPowSum_mem_sumset
            have h2 := modEq_sumset_powLang hB h1
            have hB1 : B ≡ 1 [MOD B - 1] := by
              have : B = (B - 1) + 1 := by omega
              conv_lhs => rw [this]
              exact Nat.ModEq.add_right 1 (Nat.modEq_zero_iff_dvd.mpr dvd_rfl)
            exact h2.trans hB1
          have hdecomp : e ≡ 1 [MOD B - 1] → ∃ t ≥ 1, e = 1 + t * (B - 1) := by
            intro hmod
            have hdvd : (B - 1) ∣ (e - 1) :=
              (Nat.modEq_iff_dvd' (by omega)).mp hmod.symm
            rcases hdvd with ⟨t, ht⟩
            have ht1 : 1 ≤ t := by
              by_contra ht0
              have : t = 0 := by omega
              rw [this] at ht; omega
            refine ⟨t, ht1, ?_⟩
            have : (B - 1) * t = t * (B - 1) := Nat.mul_comm _ _
            omega
          constructor
          · intro hm
            have hmod : e ≡ 1 [MOD B - 1] := (modEq_sumset_powLang hB hm).symm.trans hn₁_mod
            rcases hdecomp hmod with ⟨t, ht1, he_eq⟩
            have ht_le : t - 1 ≤ a_min := by
              have : t * 1 ≤ t * (B - 1) := Nat.mul_le_mul_left t (by omega)
              omega
            -- Split `n₂ = B ^ a_min + geomPowSum B (a_min + 1) (B - 1)`
            have hn₂_split : n₂ = B ^ a_min + geomPowSum B (a_min + 1) (B - 1) := by
              have hshift : ∀ m a, geomPowSum B a (m + 1) = B ^ a + geomPowSum B (a + 1) m := by
                intro m
                induction m with
                | zero => intro a; simp [geomPowSum]
                | succ m ihm =>
                  intro a
                  show geomPowSum B a (m + 1) + B ^ (a + (m + 1)) =
                    B ^ a + (geomPowSum B (a + 1) m + B ^ (a + 1 + m))
                  rw [ihm a]
                  have : a + (m + 1) = a + 1 + m := by omega
                  rw [this]; omega
              have hB_eq : B = (B - 1) + 1 := by omega
              dsimp only [n₂]
              conv_lhs => arg 3; rw [hB_eq]
              exact hshift (B - 1) a_min
            have hpart1 : B ^ a_min ∈ sumset (powLang B) (1 + (t - 1) * (B - 1)) :=
              pow_mem_sumset_powLang hB (t - 1) a_min ht_le
            have hpart2 : geomPowSum B (a_min + 1) (B - 1) ∈ sumset (powLang B) (B - 1) :=
              geomPowSum_mem_sumset
            have hsum := sumset_add hpart1 hpart2
            have hcnt : 1 + (t - 1) * (B - 1) + (B - 1) = e := by
              rw [he_eq]
              have : (t - 1) * (B - 1) + (B - 1) = t * (B - 1) := by
                have ht_eq : t = (t - 1) + 1 := by omega
                conv_rhs => rw [ht_eq]
                ring
              omega
            rw [← hn₂_split, hcnt] at hsum
            exact hsum
          · intro hm
            have hmod : e ≡ 1 [MOD B - 1] := (modEq_sumset_powLang hB hm).symm.trans hn₂_mod
            rcases hdecomp hmod with ⟨t, _, he_eq⟩
            have ht_le : t ≤ a_min + (B - 1) := by
              have : t * 1 ≤ t * (B - 1) := Nat.mul_le_mul_left t (by omega)
              omega
            rw [he_eq]
            exact pow_mem_sumset_powLang hB t (a_min + (B - 1)) ht_le
      · -- Case 4: `c ≥ 1, e ≥ 1` — both false since `digitSum B (n_i - c) ≥ d*(B-1) > E_max ≥ e`!
        have hc1 : 1 ≤ c := by omega
        have hc_lt : c < B ^ k₀ := by omega
        have hds_gt : e < d * (B - 1) := by
          have : d * 1 ≤ d * (B - 1) := Nat.mul_le_mul_left d (by omega)
          omega
        have hn₁_f : ¬ ∃ m ∈ sumset (powLang B) e, n₁ = c + m := by
          rintro ⟨m, hm, heq⟩
          have hm_eq : m = B ^ (k₀ + d) * B ^ (B - 1) - c := by
            have : n₁ = B ^ (k₀ + d) * B ^ (B - 1) := by
              dsimp only [n₁, a_min]; rw [pow_add]
            omega
          have hq : 1 ≤ B ^ (B - 1) := Nat.one_le_pow _ B (by omega)
          have h1 := digitSum_sub_ge_of_mul_pow hB hq hc1 hc_lt (d := d)
          have h2 := digitSum_sumset_powLang_le hB hm
          rw [hm_eq] at h2
          omega
        have hn₂_f : ¬ ∃ m ∈ sumset (powLang B) e, n₂ = c + m := by
          rintro ⟨m, hm, heq⟩
          have hm_eq : m = B ^ (k₀ + d) * geomPowSum B 0 B - c := by
            have : n₂ = B ^ (k₀ + d) * geomPowSum B 0 B := geomPowSum_factor
            omega
          have hq : 1 ≤ geomPowSum B 0 B := by
            have hB_eq : B = (B - 1) + 1 := by omega
            have hstep : geomPowSum B 0 B = geomPowSum B 0 (B - 1) + B ^ (0 + (B - 1)) := by
              conv_lhs => arg 3; rw [hB_eq]
              rfl
            have : 1 ≤ B ^ (0 + (B - 1)) := Nat.one_le_pow _ B (by omega)
            omega
          have h1 := digitSum_sub_ge_of_mul_pow hB hq hc1 hc_lt (d := d)
          have h2 := digitSum_sumset_powLang_le hB hm
          rw [hm_eq] at h2
          omega
        exact ⟨fun h => absurd h hn₁_f, fun h => absurd h hn₂_f⟩
  -- Construct a SECOND solution `U_flip` mod `n₁` by removing `n₁` from `truncUnaryVec n₁ U₀`!
  let U_flip : Fin 1 → Set ℕ := fun _ => { m ∈ U₀ 0 | m < n₁ }
  have hflip_zero : 0 ∉ U_flip 0 := fun h => hzero_not_mem h.1
  have hflip_lt : ∀ A m, m < n₁ → (m ∈ U_flip A ↔ m ∈ U₀ A) := by
    intro A m hm
    have hA : A = 0 := Fin.eq_zero A
    subst hA
    simp [U_flip, hm]
  -- Helper: if `0 ∉ U 0` and `(c, e) ≠ (0, 1)`, then `n₁ ∈ evalUnaryForm U α` only depends on `< n₁`!
  have hform_dep_lt : ∀ α : Form Unit 1, ¬(constCount α = 0 ∧ ntCount α = 1) →
      (n₁ ∈ evalUnaryForm U_flip α ↔ n₁ ∈ evalUnaryForm U₀ α) := by
    intro α hne
    rw [evalUnaryForm_one_nt, evalUnaryForm_one_nt]
    -- Show that whenever `n₁ = c + m` with `m ∈ sumset S e` and `0 ∉ S` and `(c,e) ≠ (0,1)`,
    -- every element of `S` used is `< n₁`.
    have hsum_congr : ∀ {e k : ℕ}, k ≤ n₁ → (k < n₁ ∨ 2 ≤ e) →
        (k ∈ sumset (U_flip 0) e ↔ k ∈ sumset (U₀ 0) e) := by
      intro e
      induction e with
      | zero => intro k _ _; rfl
      | succ e ihe =>
        intro k hk hke
        simp only [sumset, mem_ofPred_eq]
        constructor
        · rintro ⟨u, hu, v, hv, rfl⟩
          have hu_pos : 1 ≤ u := by
            by_contra h0; exact hflip_zero (by rwa [show u = 0 by omega] at hu)
          have hv_lt : v < n₁ := by omega
          exact ⟨u, hu.1, v, (ihe (by omega) (Or.inl hv_lt)).mp hv, rfl⟩
        · rintro ⟨u, hu, v, hv, rfl⟩
          have hu_pos : 1 ≤ u := by
            by_contra h0; exact hzero_not_mem (by rwa [show u = 0 by omega] at hu)
          have hv_lt : v < n₁ := by omega
          have hu_lt : u < n₁ := by
            rcases hke with hlt | hge2
            · omega
            · cases e with
              | zero => omega
              | succ e' =>
                rcases hv with ⟨u', hu', v', _, rfl⟩
                have hu'_pos : 1 ≤ u' := by
                  by_contra h0; exact hzero_not_mem (by rwa [show u' = 0 by omega] at hu')
                omega
          exact ⟨u, ⟨hu, hu_lt⟩, v, (ihe (by omega) (Or.inl hv_lt)).mpr hv, rfl⟩
    constructor
    · rintro ⟨m, hm, heq⟩
      have hcond : m < n₁ ∨ 2 ≤ ntCount α := by
        by_cases hc0 : constCount α = 0
        · by_cases he0 : ntCount α = 0
          · rw [he0] at hm; simp only [sumset, mem_singleton_iff] at hm; subst hm
            left; exact Nat.pos_of_ne_zero (by positivity)
          · right; omega
        · left; omega
      exact ⟨m, (hsum_congr (by omega) hcond).mp hm, heq⟩
    · rintro ⟨m, hm, heq⟩
      have hcond : m < n₁ ∨ 2 ≤ ntCount α := by
        by_cases hc0 : constCount α = 0
        · by_cases he0 : ntCount α = 0
          · rw [he0] at hm; simp only [sumset, mem_singleton_iff] at hm; subst hm
            left; exact Nat.pos_of_ne_zero (by positivity)
          · right; omega
        · left; omega
      exact ⟨m, (hsum_congr (by omega) hcond).mpr hm, heq⟩
  -- Now verify `IsUnarySolMod G n₁ U_flip`!
  have hflip_sol : IsUnarySolMod G n₁ U_flip := by
    refine ⟨fun A m hm => le_of_lt hm.2, fun A => ?_⟩
    have hA : A = 0 := Fin.eq_zero A
    subst hA
    ext m
    simp only [truncNat, mem_ofPred_eq]
    by_cases hmlt : m < n₁
    · have hmle : m ≤ n₁ := le_of_lt hmlt
      simp only [hmle, and_true]
      rw [hflip_lt 0 m hmlt, hU₀_eq 0]
      exact evalUnaryRHS_congr_le G (fun B j hj => (hflip_lt B j (by omega)).symm) 0 le_rfl
    · by_cases hmeq : m = n₁
      · subst hmeq
        simp only [le_refl, and_true]
        have hLHS : n₁ ∉ U_flip 0 := fun h => Nat.lt_irrefl n₁ h.2
        -- Show `n₁ ∈ evalUnaryRHS G U_flip 0 ↔ n₂ ∈ evalUnaryRHS G U₀ 0`!
        have hRHS_iff : n₁ ∈ evalUnaryRHS G U_flip 0 ↔ n₂ ∈ evalUnaryRHS G U₀ 0 := by
          have hform_all : ∀ r ∈ G.rules, ∀ α ∈ r.pos ++ r.neg,
              (n₁ ∈ evalUnaryForm U_flip α ↔ n₂ ∈ evalUnaryForm U₀ α) := by
            intro r hr α hα
            by_cases h01 : constCount α = 0 ∧ ntCount α = 1
            · rw [evalUnaryForm_one_nt, evalUnaryForm_one_nt, h01.1, h01.2]
              have hsum1 : ∀ (S : Set ℕ) (x : ℕ), (∃ m ∈ sumset S 1, x = 0 + m) ↔ x ∈ S := by
                intro S x
                simp only [sumset, mem_ofPred_eq, mem_singleton_iff, zero_add]
                constructor
                · rintro ⟨m, ⟨u, hu, v, rfl, rfl⟩, rfl⟩; simpa using hu
                · intro hx; exact ⟨x, ⟨x, hx, 0, rfl, by omega⟩, rfl⟩
              rw [hsum1, hsum1]
              exact ⟨fun h => absurd h hLHS, fun h => absurd h hn₂_not_mem⟩
            · exact (hform_dep_lt α h01).trans
                (hconj_eq α (hC_bound r hr α hα) (hE_bound r hr α hα) h01)
          simp only [evalUnaryRHS, evalUnaryRule, mem_ofPred_eq]
          constructor
          · rintro ⟨r, hr, hlhs, hp, hneg⟩
            refine ⟨r, hr, hlhs, ?_, ?_⟩
            · intro α hα
              exact (hform_all r hr α (List.mem_append_left _ hα)).mp (hp α hα)
            · intro β hβ hmem
              exact hneg β hβ ((hform_all r hr β (List.mem_append_right _ hβ)).mpr hmem)
          · rintro ⟨r, hr, hlhs, hp, hneg⟩
            refine ⟨r, hr, hlhs, ?_, ?_⟩
            · intro α hα
              exact (hform_all r hr α (List.mem_append_left _ hα)).mpr (hp α hα)
            · intro β hβ hmem
              exact hneg β hβ ((hform_all r hr β (List.mem_append_right _ hβ)).mp hmem)
        rw [hRHS_iff, ← hU₀_eq 0]
        exact ⟨fun h => absurd h hLHS, fun h => absurd h hn₂_not_mem⟩
      · have hgt : ¬ m ≤ n₁ := by omega
        simp only [hgt, and_false, iff_false]
        intro hm; exact hgt (le_of_lt hm.2)
  exact ⟨n₁, hn₁_mem, hflip_sol⟩

/-- **Theorem B2 (Unconditional 1-Nonterminal Lower Bound — Boolean Strongly-Unique Semantics):**
For every integer base `B ≥ 2`, the unary power language `{ B ^ k | k : ℕ }` cannot be generated
by ANY 1-nonterminal unary Boolean grammar (with arbitrary finite rules, conjunctions, and
negations). -/
theorem no_one_nt_pow_language (B : ℕ) (hB : 2 ≤ B) (G : BoolGrammar Unit 1) :
    ¬ GeneratesUnary G (powLang B) := by
  rintro ⟨huniq, U₀, hU₀_eq, hU₀_start⟩
  obtain ⟨n₁, hn₁_mem, hflip_sol⟩ := exists_flip_solMod_of_powLang B hB G U₀ hU₀_eq hU₀_start
  -- Contradict strong uniqueness of `G` at length `n₁`!
  obtain ⟨U_n₁, _, hUn₁_uniq⟩ := huniq n₁
  have h1 : (fun _ : Fin 1 => { m ∈ U₀ 0 | m < n₁ }) = U_n₁ := hUn₁_uniq _ hflip_sol
  have h2 : truncUnaryVec n₁ U₀ = U_n₁ := hUn₁_uniq _ (isUnarySolMod_trunc_of_global hU₀_eq n₁)
  have heq : { m ∈ U₀ 0 | m < n₁ } = truncUnaryVec n₁ U₀ 0 := congrFun (h1.trans h2.symm) 0
  have hmem : n₁ ∈ truncUnaryVec n₁ U₀ 0 := ⟨hn₁_mem, le_rfl⟩
  rw [← heq] at hmem
  exact Nat.lt_irrefl n₁ hmem.2

/-- **Theorem B2-LFP (Unconditional 1-Nonterminal Lower Bound — Standard Conjunctive LFP Semantics):**
For every integer base `B ≥ 2` and EVERY 1-nonterminal unary conjunctive grammar
`G : BoolGrammar Unit 1` (allowing arbitrary finite rules, `ε`-rules, and dummy unit rules such
as `S → S`), `G` cannot generate `{ B ^ k | k : ℕ }` under standard textbook least-fixed-point
(Okhotin 2001 / Jeż 2007) semantics. -/
theorem no_one_nt_pow_language_lfp (B : ℕ) (hB : 2 ≤ B) (G : BoolGrammar Unit 1)
    (hconj : G.IsConjunctive) :
    ¬ GeneratesUnaryLFP G (powLang B) := by
  rintro ⟨U₀, ⟨hU₀_eq, hU₀_least⟩, hU₀_start⟩
  obtain ⟨n₁, hn₁_mem, hflip_sol⟩ := exists_flip_solMod_of_powLang B hB G U₀ hU₀_eq hU₀_start
  -- `W := U₀ \ {n₁}` is a strict subset of `U₀` agreeing with `U_flip` on `≤ n₁`,
  -- hence a strictly smaller global pre-fixed point of the monotone operator `evalUnaryRHS G`.
  let W : Fin 1 → Set ℕ := fun _ => { m ∈ U₀ 0 | m ≠ n₁ }
  have hW_sub : ∀ A, W A ⊆ U₀ A := by
    intro A m hm
    have hA : A = 0 := Fin.eq_zero A
    subst hA
    exact hm.1
  have hW_prefixed : IsUnaryPreFixedPoint G W := by
    intro A m hm
    have hA : A = 0 := Fin.eq_zero A
    subst hA
    have hmU : m ∈ U₀ 0 := by
      rw [hU₀_eq 0]
      exact evalUnaryRHS_mono hconj hW_sub 0 hm
    refine ⟨hmU, ?_⟩
    intro hmeq
    rw [hmeq] at hm
    have hcongr : ∀ C j, j ≤ n₁ →
        (j ∈ W C ↔ j ∈ (fun _ : Fin 1 => { k ∈ U₀ 0 | k < n₁ }) C) := by
      intro C j hj
      simp only [W, mem_ofPred_eq]
      constructor
      · rintro ⟨hjU, hjne⟩; exact ⟨hjU, lt_of_le_of_ne hj hjne⟩
      · rintro ⟨hjU, hjlt⟩; exact ⟨hjU, ne_of_lt hjlt⟩
    have hn₁_flip : n₁ ∈ evalUnaryRHS G (fun _ => { k ∈ U₀ 0 | k < n₁ }) 0 :=
      (evalUnaryRHS_congr_le G hcongr 0 le_rfl).mp hm
    have hn₁_mem_flip : n₁ ∈ ({ k ∈ U₀ 0 | k < n₁ } : Set ℕ) := by
      have := Set.ext_iff.mp (hflip_sol.2 0) n₁
      exact this.mpr ⟨hn₁_flip, le_rfl⟩
    exact Nat.lt_irrefl n₁ hn₁_mem_flip.2
  have hU₀_le_lfp : ∀ A, U₀ A ⊆ lfpUnary G A :=
    hU₀_least (lfpUnary G) (lfpUnary_isUnarySol hconj)
  have hn₁_W : n₁ ∈ W 0 := lfpUnary_le_prefixed hW_prefixed 0 (hU₀_le_lfp 0 hn₁_mem)
  exact hn₁_W.2 rfl

end OneNTLowerBound


/-! ## Section 4: `B_4` Sidon Sets & Theorem B3 (General 2-NT Stretched Collapse) -/

section B4SidonAndCollapse

/-- A valid `B_4` Sidon configuration `(M, r)` for `k` residue classes modulo `M`:
- `1 ≤ r i < M` for all `i`,
- `r i < r p + r q` for all `p, q, i` (guaranteeing strictly positive padding offsets),
- all 4-multisums `(r a + r b + r c + r d) % M` uniquely determine the multiset `{a, b, c, d}`. -/
structure IsValidB4Config {k : ℕ} (M : ℕ) (r : Fin k → ℕ) : Prop where
  pos_r : ∀ i, 1 ≤ r i
  lt_M : ∀ i, r i < M
  pad_pos : ∀ p q i, r i < r p + r q
  b4 : ∀ a b c d a' b' c' d' : Fin k,
    (r a + r b + r c + r d) % M = (r a' + r b' + r c' + r d') % M →
    ({a, b, c, d} : Multiset (Fin k)) = {a', b', c', d'}

lemma multiset_quad_eq_add_pairs {α : Type*} (a b c d : α) :
    ({a, b, c, d} : Multiset α) = {a, b} + {c, d} := by
  simp only [Multiset.insert_eq_cons, Multiset.cons_add, Multiset.singleton_add]

lemma IsValidB4Config.sidon {k M : ℕ} {r : Fin k → ℕ} (h : IsValidB4Config M r)
    {a b c d : Fin k} (heq : (r a + r b) % M = (r c + r d) % M) :
    ({a, b} : Multiset (Fin k)) = {c, d} := by
  have h4 : (r a + r b + r a + r a) % M = (r c + r d + r a + r a) % M := by
    have h1 : (r a + r b) ≡ (r c + r d) [MOD M] := heq
    have h2 := (h1.add_right (r a)).add_right (r a)
    exact h2
  have hm := h.b4 a b a a c d a a h4
  have hcancel : ({a, b} : Multiset (Fin k)) + {a, a} = {c, d} + {a, a} := by
    rw [← multiset_quad_eq_add_pairs, ← multiset_quad_eq_add_pairs]; exact hm
  exact add_right_cancel hcancel

lemma IsValidB4Config.inj {k M : ℕ} {r : Fin k → ℕ} (h : IsValidB4Config M r)
    {a b : Fin k} (heq : r a % M = r b % M) : a = b := by
  have h2 : (r a + r a) % M = (r b + r a) % M := Nat.ModEq.add_right (r a) heq
  have hm := h.sidon h2
  have hcancel : ({a} : Multiset (Fin k)) + {a} = {b} + {a} := by
    simpa [Multiset.insert_eq_cons] using hm
  have hsing : ({a} : Multiset (Fin k)) = {b} := add_right_cancel hcancel
  exact Multiset.singleton_inj.mp hsing

lemma IsValidB4Config.r_inj {k M : ℕ} {r : Fin k → ℕ} (h : IsValidB4Config M r)
    {a b : Fin k} (heq : r a = r b) : a = b :=
  h.inj (by rw [heq])

lemma multiset_count_quad {α : Type*} [DecidableEq α] (x a b c d : α) :
    Multiset.count x ({a, b, c, d} : Multiset α) =
      (if a = x then 1 else 0) + (if b = x then 1 else 0) +
      (if c = x then 1 else 0) + (if d = x then 1 else 0) := by
  simp only [Multiset.insert_eq_cons, Multiset.count_cons, Multiset.count_singleton]
  have h1 : ∀ y : α, (if x = y then (1 : ℕ) else 0) = if y = x then 1 else 0 := by
    intro y; by_cases h : x = y <;> simp [h, eq_comm]
  simp only [h1]
  omega

/-- Disjoint-pair `B_4` cancellation lemma: if `(r p₁ + r q₁ + r c + r d) % M = (r p₂ + r q₂ + r a + r b) % M`
and `{a, b}` is disjoint from `{c, d}`, then `{p₁, q₁} = {a, b}` and `{p₂, q₂} = {c, d}`. -/
lemma IsValidB4Config.cancel_disjoint {k M : ℕ} {r : Fin k → ℕ} (h : IsValidB4Config M r)
    {p₁ q₁ p₂ q₂ a b c d : Fin k}
    (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d)
    (heq : (r p₁ + r q₁ + r c + r d) % M = (r p₂ + r q₂ + r a + r b) % M) :
    ({p₁, q₁} : Multiset (Fin k)) = {a, b} ∧ ({p₂, q₂} : Multiset (Fin k)) = {c, d} := by
  have hm := h.b4 p₁ q₁ c d p₂ q₂ a b heq
  have hcount : ∀ x : Fin k,
      Multiset.count x ({p₁, q₁, c, d} : Multiset (Fin k)) =
      Multiset.count x ({p₂, q₂, a, b} : Multiset (Fin k)) := fun x => by rw [hm]
  have hp1q1 : ({p₁, q₁} : Multiset (Fin k)) = {a, b} := by
    by_cases hab : a = b
    · subst hab
      have hc_a := hcount a
      rw [multiset_count_quad, multiset_count_quad] at hc_a
      simp only [Ne.symm hac, Ne.symm had, ↓reduceIte] at hc_a
      have hp1 : p₁ = a := by by_contra hne; simp [hne] at hc_a; split_ifs at hc_a <;> omega
      have hq1 : q₁ = a := by by_contra hne; simp [hne] at hc_a; split_ifs at hc_a <;> omega
      rw [hp1, hq1]
    · have hc_a := hcount a
      have hc_b := hcount b
      rw [multiset_count_quad, multiset_count_quad] at hc_a hc_b
      simp only [Ne.symm hac, Ne.symm had, Ne.symm hbc, Ne.symm hbd, hab, Ne.symm hab,
        ↓reduceIte] at hc_a hc_b
      have ha_in : p₁ = a ∨ q₁ = a := by
        by_contra hnot
        have h1 : p₁ ≠ a := fun h => hnot (Or.inl h)
        have h2 : q₁ ≠ a := fun h => hnot (Or.inr h)
        simp [h1, h2] at hc_a
      have hb_in : p₁ = b ∨ q₁ = b := by
        by_contra hnot
        have h1 : p₁ ≠ b := fun h => hnot (Or.inl h)
        have h2 : q₁ ≠ b := fun h => hnot (Or.inr h)
        simp [h1, h2] at hc_b
      rcases ha_in with rfl | rfl <;> rcases hb_in with hb | hb
      · exact absurd hb hab
      · rw [hb]
      · rw [hb]; exact Multiset.pair_comm _ _
      · exact absurd hb hab
  refine ⟨hp1q1, ?_⟩
  have h1 : ({p₁, q₁} : Multiset (Fin k)) + {c, d} = {p₂, q₂} + {a, b} := by
    rw [← multiset_quad_eq_add_pairs, ← multiset_quad_eq_add_pairs]; exact hm
  rw [hp1q1, add_comm ({a, b} : Multiset (Fin k)) {c, d}] at h1
  exact (add_right_cancel h1).symm

/-- Uniqueness of base-5 representation with digits `< 5`. -/
lemma base5_digits_unique : ∀ (k : ℕ) (c₁ c₂ : Fin k → ℕ),
    (∀ i, c₁ i < 5) → (∀ i, c₂ i < 5) →
    (Finset.univ.sum (fun i : Fin k => c₁ i * 5 ^ i.val) =
     Finset.univ.sum (fun i : Fin k => c₂ i * 5 ^ i.val)) →
    ∀ i, c₁ i = c₂ i := by
  intro k
  induction k with
  | zero => intro _ _ _ _ _ i; exact Fin.elim0 i
  | succ k ih =>
    intro c₁ c₂ h1 h2 hsum
    rw [Fin.sum_univ_succ, Fin.sum_univ_succ] at hsum
    simp only [Fin.val_zero, pow_zero, mul_one, Fin.val_succ, pow_succ'] at hsum
    have hfactor : ∀ c : Fin (k + 1) → ℕ,
        ∑ i : Fin k, c i.succ * (5 * 5 ^ i.val) =
        5 * ∑ i : Fin k, c i.succ * 5 ^ i.val := by
      intro c
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => by ring
    rw [hfactor c₁, hfactor c₂] at hsum
    have hc0 : c₁ 0 = c₂ 0 := by
      have hmod := congrArg (· % 5) hsum
      have hm1 : (c₁ 0 + 5 * ∑ i : Fin k, c₁ i.succ * 5 ^ i.val) % 5 = c₁ 0 := by
        rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (h1 0)]
      have hm2 : (c₂ 0 + 5 * ∑ i : Fin k, c₂ i.succ * 5 ^ i.val) % 5 = c₂ 0 := by
        rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (h2 0)]
      omega
    have htail : ∑ i : Fin k, c₁ i.succ * 5 ^ i.val = ∑ i : Fin k, c₂ i.succ * 5 ^ i.val := by
      omega
    have hsucc := ih (fun i => c₁ i.succ) (fun i => c₂ i.succ)
      (fun i => h1 i.succ) (fun i => h2 i.succ) htail
    intro i
    refine Fin.cases hc0 hsucc i

/-- Explicit universal `B_4` Sidon configuration for ANY `k : ℕ`:
`M = 5 ^ (k + 1)` and `r i = 5 ^ k + 5 ^ i.val`. -/
theorem base5_isValidB4Config (k : ℕ) :
    IsValidB4Config (5 ^ (k + 1)) (fun i : Fin k => 5 ^ k + 5 ^ i.val) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro i; exact Nat.le_add_right_of_le (Nat.one_le_pow k 5 (by omega))
  · intro i
    have hi : 5 ^ i.val ≤ 5 ^ k := Nat.pow_le_pow_right (by omega) (le_of_lt i.isLt)
    have hM : 5 ^ (k + 1) = 5 * 5 ^ k := by rw [pow_succ']
    have hpos : 1 ≤ 5 ^ k := Nat.one_le_pow k 5 (by omega)
    omega
  · intro p q i
    have hi : 5 ^ i.val ≤ 5 ^ k := Nat.pow_le_pow_right (by omega) (le_of_lt i.isLt)
    have hp : 1 ≤ 5 ^ p.val := Nat.one_le_pow _ 5 (by omega)
    have hq : 1 ≤ 5 ^ q.val := Nat.one_le_pow _ 5 (by omega)
    omega
  · intro a b c d a' b' c' d' hmod
    have hlt_pow : ∀ x : Fin k, 5 ^ x.val ≤ 5 ^ (k - 1) := fun x =>
      Nat.pow_le_pow_right (by omega) (by omega)
    have hk_pos : 1 ≤ k := Nat.pos_of_ne_zero (by intro h0; subst h0; exact Fin.elim0 a)
    have h5k : 5 * 5 ^ (k - 1) = 5 ^ k := by
      have : k = (k - 1) + 1 := by omega
      conv_rhs => rw [this, pow_succ']
    have hsum_lt : ∀ x y z w : Fin k,
        (5 ^ k + 5 ^ x.val) + (5 ^ k + 5 ^ y.val) + (5 ^ k + 5 ^ z.val) + (5 ^ k + 5 ^ w.val) <
        5 ^ (k + 1) := by
      intro x y z w
      have hx := hlt_pow x; have hy := hlt_pow y; have hz := hlt_pow z; have hw := hlt_pow w
      have hpos : 1 ≤ 5 ^ (k - 1) := Nat.one_le_pow _ 5 (by omega)
      have hM : 5 ^ (k + 1) = 5 * 5 ^ k := by rw [pow_succ']
      omega
    have heq_full :
        (5 ^ k + 5 ^ a.val) + (5 ^ k + 5 ^ b.val) + (5 ^ k + 5 ^ c.val) + (5 ^ k + 5 ^ d.val) =
        (5 ^ k + 5 ^ a'.val) + (5 ^ k + 5 ^ b'.val) + (5 ^ k + 5 ^ c'.val) + (5 ^ k + 5 ^ d'.val) := by
      rw [← Nat.mod_eq_of_lt (hsum_lt a b c d), ← Nat.mod_eq_of_lt (hsum_lt a' b' c' d')]
      exact hmod
    have heq : 5 ^ a.val + 5 ^ b.val + 5 ^ c.val + 5 ^ d.val =
               5 ^ a'.val + 5 ^ b'.val + 5 ^ c'.val + 5 ^ d'.val := by omega
    -- Express both sums as `∑ i : Fin k, count i S * 5 ^ i.val`.
    have hsum_count : ∀ x y z w : Fin k,
        Finset.univ.sum (fun i : Fin k => Multiset.count i ({x, y, z, w} : Multiset (Fin k)) * 5 ^ i.val) =
        5 ^ x.val + 5 ^ y.val + 5 ^ z.val + 5 ^ w.val := by
      intro x y z w
      have h1 : ∀ i : Fin k,
          Multiset.count i ({x, y, z, w} : Multiset (Fin k)) * 5 ^ i.val =
          (if x = i then 5 ^ i.val else 0) + (if y = i then 5 ^ i.val else 0) +
          (if z = i then 5 ^ i.val else 0) + (if w = i then 5 ^ i.val else 0) := by
        intro i
        rw [multiset_count_quad]
        split_ifs <;> ring
      simp only [h1, Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
    have hc_lt : ∀ (S : Multiset (Fin k)), S.card = 4 → ∀ i, Multiset.count i S < 5 := by
      intro S hcard i
      have := Multiset.count_le_card i S
      omega
    have hcounts := base5_digits_unique k
      (fun i => Multiset.count i ({a, b, c, d} : Multiset (Fin k)))
      (fun i => Multiset.count i ({a', b', c', d'} : Multiset (Fin k)))
      (hc_lt _ (by simp)) (hc_lt _ (by simp))
      (by rw [hsum_count, hsum_count, heq])
    exact Multiset.ext.mpr hcounts

/-- Helper to build a unary form `a^d X X` (with `X = 1 : Fin 2`). -/
def padXX (d : ℕ) : Form Unit 2 :=
  List.replicate d (Sum.inl ()) ++ [Sum.inr 1, Sum.inr 1]

/-- Helper to build a unary form `a^d X` (with `X = 1 : Fin 2`). -/
def padX (d : ℕ) : Form Unit 2 :=
  List.replicate d (Sum.inl ()) ++ [Sum.inr 1]

/-- Helper to build a pure terminal unary form `a^d`. -/
def padConst {k : ℕ} (d : ℕ) : Form Unit k :=
  List.replicate d (Sum.inl ())

lemma constCount_padConst {k : ℕ} (d : ℕ) : constCount (padConst (k := k) d) = d := by
  induction d with
  | zero => rfl
  | succ d ih => simp only [padConst, List.replicate_succ, constCount] at ih ⊢; omega

lemma constCount_padX (d : ℕ) : constCount (padX d) = d := by
  induction d with
  | zero => simp [padX, constCount]
  | succ d ih => simp only [padX, List.replicate_succ, List.cons_append, constCount] at ih ⊢; omega

lemma constCount_padXX (d : ℕ) : constCount (padXX d) = d := by
  induction d with
  | zero => simp [padXX, constCount]
  | succ d ih => simp only [padXX, List.replicate_succ, List.cons_append, constCount] at ih ⊢; omega

lemma evalUnaryForm_padConst {k : ℕ} (U : Fin k → Set ℕ) (d n : ℕ) :
    n ∈ evalUnaryForm U (padConst d) ↔ n = d := by
  induction d generalizing n with
  | zero => simp [padConst, evalUnaryForm]
  | succ d ih =>
    simp only [padConst, List.replicate_succ, evalUnaryForm, mem_ofPred_eq]
    constructor
    · rintro ⟨m, hm, rfl⟩; rw [(ih m).mp hm]
    · rintro rfl; exact ⟨d, (ih d).mpr rfl, rfl⟩

lemma evalUnaryForm_padX (U : Fin 2 → Set ℕ) (d n : ℕ) :
    n ∈ evalUnaryForm U (padX d) ↔ ∃ x ∈ U 1, n = d + x := by
  induction d generalizing n with
  | zero =>
    simp [padX, evalUnaryForm]
  | succ d ih =>
    simp only [padX, List.replicate_succ, List.cons_append, evalUnaryForm, mem_ofPred_eq] at ih ⊢
    constructor
    · rintro ⟨m, hm, rfl⟩
      rcases (ih m).mp hm with ⟨x, hx, rfl⟩
      exact ⟨x, hx, by omega⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨d + x, (ih (d + x)).mpr ⟨x, hx, rfl⟩, by omega⟩

lemma evalUnaryForm_padXX (U : Fin 2 → Set ℕ) (d n : ℕ) :
    n ∈ evalUnaryForm U (padXX d) ↔ ∃ x ∈ U 1, ∃ y ∈ U 1, n = d + x + y := by
  induction d generalizing n with
  | zero =>
    simp only [padXX, List.replicate_zero, List.nil_append, evalUnaryForm,
      mem_ofPred_eq, mem_singleton_iff, zero_add]
    constructor
    · rintro ⟨x, hx, v, ⟨y, hy, w, hw, rfl⟩, rfl⟩
      rw [hw, add_zero]
      exact ⟨x, hx, y, hy, rfl⟩
    · rintro ⟨x, hx, y, hy, rfl⟩
      exact ⟨x, hx, y, ⟨y, hy, 0, rfl, by omega⟩, rfl⟩
  | succ d ih =>
    simp only [padXX, List.replicate_succ, List.cons_append, evalUnaryForm, mem_ofPred_eq] at ih ⊢
    constructor
    · rintro ⟨m, hm, rfl⟩
      rcases (ih m).mp hm with ⟨x, hx, y, hy, rfl⟩
      exact ⟨x, hx, y, hy, by omega⟩
    · rintro ⟨x, hx, y, hy, rfl⟩
      exact ⟨d + x + y, (ih _).mpr ⟨x, hx, y, hy, rfl⟩, by omega⟩

/-- A unary `m`-nonterminal grammar in Binary Normal Form (BNF):
every rule is either a base terminal rule `A_i → a^c` (`c ≥ 1`), OR a binary rule
`A_i → ⋀ (A_p A_q) ∧ ⋀ ¬(A_u A_v)` with at least one positive conjunct. -/
structure UnaryBNFRule (m : ℕ) where
  lhs : Fin m
  baseLen : Option ℕ -- `some c` (with `c ≥ 1`) for base rule `a^c`; `none` for binary rule
  posPairs : List (Fin m × Fin m)
  negPairs : List (Fin m × Fin m)

/-- A unary grammar in Binary Normal Form. -/
structure UnaryBNFGrammar (m : ℕ) where
  rules : List (UnaryBNFRule m)
  start : Fin m
  wf : ∀ r ∈ rules,
    (∃ c ≥ 1, r.baseLen = some c ∧ r.posPairs = [] ∧ r.negPairs = []) ∨
    (r.baseLen = none ∧ r.posPairs ≠ [])

/-- Convert a `UnaryBNFRule` to a `BoolRule Unit m`. -/
def UnaryBNFRule.toBoolRule {m : ℕ} (r : UnaryBNFRule m) : BoolRule Unit m :=
  match r.baseLen with
  | some c => { lhs := r.lhs, pos := [padConst c], neg := [] }
  | none =>
    { lhs := r.lhs
      pos := r.posPairs.map (fun pq => [Sum.inr pq.1, Sum.inr pq.2])
      neg := r.negPairs.map (fun pq => [Sum.inr pq.1, Sum.inr pq.2]) }

/-- Convert a `UnaryBNFGrammar` to a `BoolGrammar Unit m`. -/
def UnaryBNFGrammar.toBoolGrammar {m : ℕ} (G : UnaryBNFGrammar m) : BoolGrammar Unit m where
  rules := G.rules.map UnaryBNFRule.toBoolRule
  start := G.start

/-- Translate an `m`-NT `UnaryBNFGrammar` into a **2-nonterminal** unary Boolean grammar
generating `M · L(G)` using a valid `B_4` configuration `(M, r)` of size `m + 2`.
Nonterminal `0 : Fin 2` is `S`; nonterminal `1 : Fin 2` is `X`. -/
def stretchedCollapseGrammar {m : ℕ} (G : UnaryBNFGrammar m) (M : ℕ)
    (r : Fin (m + 2) → ℕ) : BoolGrammar Unit 2 :=
  let idx : Fin m → Fin (m + 2) := Fin.castAdd 2
  let reg1 : Fin (m + 2) := ⟨m, by omega⟩
  let reg2 : Fin (m + 2) := ⟨m + 1, by omega⟩
  let ruleS : BoolRule Unit 2 :=
    { lhs := 0, pos := [padX (r (idx G.start)), padX (r reg1)], neg := [] }
  let regBase1 : BoolRule Unit 2 := { lhs := 1, pos := [padConst (M - r reg1)], neg := [] }
  let regBase2 : BoolRule Unit 2 := { lhs := 1, pos := [padConst (M - r reg2)], neg := [] }
  let regInd1 : BoolRule Unit 2 :=
    { lhs := 1, pos := [padXX (r reg1), padXX (2 * r reg2 - r reg1)], neg := [] }
  let regInd2 : BoolRule Unit 2 :=
    { lhs := 1, pos := [padXX (r reg2), padXX (2 * r reg1 - r reg2)], neg := [] }
  let translateRule (rb : UnaryBNFRule m) : BoolRule Unit 2 :=
    match rb.baseLen with
    | some c => { lhs := 1, pos := [padConst (M * c - r (idx rb.lhs))], neg := [] }
    | none =>
      let ri := r (idx rb.lhs)
      let guard := [padXX (2 * r reg1 - ri), padXX (2 * r reg2 - ri)]
      { lhs := 1
        pos := guard ++ rb.posPairs.map (fun pq => padXX (r (idx pq.1) + r (idx pq.2) - ri))
        neg := rb.negPairs.map (fun pq => padXX (r (idx pq.1) + r (idx pq.2) - ri)) }
  { rules := [ruleS, regBase1, regBase2, regInd1, regInd2] ++ G.rules.map translateRule
    start := 0 }

lemma stretchedCollapse_isConjunctive {m : ℕ} (G : UnaryBNFGrammar m) (M : ℕ)
    (r : Fin (m + 2) → ℕ) (hconj : G.toBoolGrammar.IsConjunctive) :
    (stretchedCollapseGrammar G M r).IsConjunctive := by
  intro rl hrl
  simp only [stretchedCollapseGrammar, List.mem_append, List.mem_cons, List.not_mem_nil,
    or_false, List.mem_map] at hrl
  rcases hrl with (rfl | rfl | rfl | rfl | rfl) | ⟨rb, hrb, rfl⟩
  · exact ⟨rfl, by simp⟩
  · exact ⟨rfl, by simp⟩
  · exact ⟨rfl, by simp⟩
  · exact ⟨rfl, by simp⟩
  · exact ⟨rfl, by simp⟩
  · have hrb_conj := hconj rb.toBoolRule (List.mem_map.mpr ⟨rb, hrb, rfl⟩)
    cases hbl : rb.baseLen with
    | some c => simp
    | none =>
      simp only [UnaryBNFRule.toBoolRule, hbl, List.map_eq_nil_iff] at hrb_conj
      simp [hrb_conj.1]

lemma stretchedCollapse_strictlyDecreasing {m : ℕ} (G : UnaryBNFGrammar m) (M : ℕ)
    (r : Fin (m + 2) → ℕ) (hb4 : IsValidB4Config M r) :
    IsStrictlyDecreasing (stretchedCollapseGrammar G M r) := by
  intro rl hrl
  simp only [stretchedCollapseGrammar, List.mem_append, List.mem_cons, List.not_mem_nil,
    or_false, List.mem_map] at hrl
  rcases hrl with (rfl | rfl | rfl | rfl | rfl) | ⟨rb, hrb, rfl⟩
  · refine ⟨?_, by simp⟩
    intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
    rcases hα with rfl | rfl <;> rw [constCount_padX]
    · exact hb4.pos_r _
    · exact hb4.pos_r _
  · refine ⟨?_, by simp⟩
    intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
    subst hα; rw [constCount_padConst]; have := hb4.lt_M ⟨m, by omega⟩; omega
  · refine ⟨?_, by simp⟩
    intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
    subst hα; rw [constCount_padConst]; have := hb4.lt_M ⟨m + 1, by omega⟩; omega
  · refine ⟨?_, by simp⟩
    intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
    rcases hα with rfl | rfl <;> rw [constCount_padXX]
    · exact hb4.pos_r ⟨m, by omega⟩
    · have := hb4.pad_pos ⟨m + 1, by omega⟩ ⟨m + 1, by omega⟩ ⟨m, by omega⟩; omega
  · refine ⟨?_, by simp⟩
    intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
    rcases hα with rfl | rfl <;> rw [constCount_padXX]
    · exact hb4.pos_r ⟨m + 1, by omega⟩
    · have := hb4.pad_pos ⟨m, by omega⟩ ⟨m, by omega⟩ ⟨m + 1, by omega⟩; omega
  · rcases G.wf rb hrb with ⟨c, hc, hbl, _, _⟩ | ⟨hbl, _⟩
    · simp only [hbl]
      refine ⟨?_, by simp⟩
      intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
      subst hα; rw [constCount_padConst]
      have hlt := hb4.lt_M (Fin.castAdd 2 rb.lhs)
      have hMc : M ≤ M * c := Nat.le_mul_of_pos_right M (by omega)
      omega
    · simp only [hbl]
      refine ⟨?_, ?_⟩
      · intro α hα
        simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, List.mem_map] at hα
        rcases hα with (rfl | rfl) | ⟨pq, _, rfl⟩ <;> rw [constCount_padXX]
        · have := hb4.pad_pos ⟨m, by omega⟩ ⟨m, by omega⟩ (Fin.castAdd 2 rb.lhs); omega
        · have := hb4.pad_pos ⟨m + 1, by omega⟩ ⟨m + 1, by omega⟩ (Fin.castAdd 2 rb.lhs); omega
        · have := hb4.pad_pos (Fin.castAdd 2 pq.1) (Fin.castAdd 2 pq.2) (Fin.castAdd 2 rb.lhs); omega
      · intro β hβ
        simp only [List.mem_map] at hβ
        rcases hβ with ⟨pq, _, rfl⟩
        rw [constCount_padXX]
        have := hb4.pad_pos (Fin.castAdd 2 pq.1) (Fin.castAdd 2 pq.2) (Fin.castAdd 2 rb.lhs); omega

/-- **Theorem B3 (General 2-NT Stretched Collapse via `B_4` Sidon Sets):**
For ANY `m`-nonterminal `ε`-free binary-normal-form unary Boolean grammar `G` generating `L`,
and ANY valid `B_4` configuration `(M, r)` of size `m + 2`, the explicit 2-nonterminal grammar
`stretchedCollapseGrammar G M r` generates `M · L = { M * n | n ∈ L }` (and is conjunctive if
`G` is conjunctive). -/
theorem stretched_collapse_2nt {m : ℕ} (G : UnaryBNFGrammar m) (M : ℕ)
    (r : Fin (m + 2) → ℕ) (hb4 : IsValidB4Config M r)
    (A : Fin m → Set ℕ) (hA_eps : ∀ i, 0 ∉ A i)
    (hA_sol : ∀ i, A i = evalUnaryRHS G.toBoolGrammar A i) :
    GeneratesUnary (stretchedCollapseGrammar G M r) { L | ∃ n ∈ A G.start, L = M * n } := by
  let idx : Fin m → Fin (m + 2) := Fin.castAdd 2
  let reg1 : Fin (m + 2) := ⟨m, by omega⟩
  let reg2 : Fin (m + 2) := ⟨m + 1, by omega⟩
  have hreg12 : reg1 ≠ reg2 := by intro h; simp [reg1, reg2] at h
  have hidx_ne_reg1 : ∀ i : Fin m, idx i ≠ reg1 := fun i h => by
    have := congrArg Fin.val h; simp [idx, reg1] at this; omega
  have hidx_ne_reg2 : ∀ i : Fin m, idx i ≠ reg2 := fun i h => by
    have := congrArg Fin.val h; simp [idx, reg2] at this; omega
  -- Helper predicate for membership of `(p, u)` in the interleaved encoding `X_set`.
  let MemIdx : Fin (m + 2) → ℕ → Prop := fun p u =>
    1 ≤ u ∧ ((∃ i : Fin m, p = idx i ∧ u ∈ A i) ∨ p = reg1 ∨ p = reg2)
  let X_set : Set ℕ := { L | ∃ p : Fin (m + 2), ∃ u : ℕ, MemIdx p u ∧ L = M * u - r p }
  let S_set : Set ℕ := { L | ∃ n ∈ A G.start, L = M * n }
  let U : Fin 2 → Set ℕ := fun | 0 => S_set | 1 => X_set
  have hM_pos : 1 ≤ M := by have := hb4.pos_r reg1; have := hb4.lt_M reg1; omega
  -- Helper: evaluate `padXX d` on `U`.
  have hpadXX_iff : ∀ d L, L ∈ evalUnaryForm U (padXX d) ↔
      ∃ p q : Fin (m + 2), ∃ u v : ℕ, MemIdx p u ∧ MemIdx q v ∧
        L + r p + r q = d + M * (u + v) := by
    intro d L
    rw [evalUnaryForm_padXX]
    constructor
    · rintro ⟨x, ⟨p, u, hpu, rfl⟩, y, ⟨q, v, hqv, rfl⟩, rfl⟩
      have hMu : r p ≤ M * u := le_trans (le_of_lt (hb4.lt_M p)) (Nat.le_mul_of_pos_right M hpu.1)
      have hMv : r q ≤ M * v := le_trans (le_of_lt (hb4.lt_M q)) (Nat.le_mul_of_pos_right M hqv.1)
      refine ⟨p, q, u, v, hpu, hqv, ?_⟩
      zify [hMu, hMv]; ring
    · rintro ⟨p, q, u, v, hpu, hqv, heq⟩
      have hMu : r p ≤ M * u := le_trans (le_of_lt (hb4.lt_M p)) (Nat.le_mul_of_pos_right M hpu.1)
      have hMv : r q ≤ M * v := le_trans (le_of_lt (hb4.lt_M q)) (Nat.le_mul_of_pos_right M hqv.1)
      refine ⟨M * u - r p, ⟨p, u, hpu, rfl⟩, M * v - r q, ⟨q, v, hqv, rfl⟩, ?_⟩
      zify [hMu, hMv] at heq ⊢; linarith
  -- Helper: guard `(2*r reg1 - r i) & (2*r reg2 - r i)` characterizes `{ M * n - r i | n ≥ 2 }`.
  have hguard_iff : ∀ (t : Fin (m + 2)) (L : ℕ),
      (L ∈ evalUnaryForm U (padXX (2 * r reg1 - r t)) ∧
       L ∈ evalUnaryForm U (padXX (2 * r reg2 - r t))) ↔
      ∃ n ≥ 2, L = M * n - r t := by
    intro t L
    rw [hpadXX_iff, hpadXX_iff]
    constructor
    · rintro ⟨⟨p₁, q₁, u₁, v₁, hpu₁, hqv₁, heq₁⟩, ⟨p₂, q₂, u₂, v₂, hpu₂, hqv₂, heq₂⟩⟩
      have hp1 : r t < 2 * r reg1 := by have := hb4.pad_pos reg1 reg1 t; omega
      have hp2 : r t < 2 * r reg2 := by have := hb4.pad_pos reg2 reg2 t; omega
      have heq1' : L + r p₁ + r q₁ + r t = 2 * r reg1 + M * (u₁ + v₁) := by
        zify [le_of_lt hp1] at heq₁ ⊢; linarith
      have heq2' : L + r p₂ + r q₂ + r t = 2 * r reg2 + M * (u₂ + v₂) := by
        zify [le_of_lt hp2] at heq₂ ⊢; linarith
      have hcross : (r p₁ + r q₁ + r reg2 + r reg2) + M * (u₂ + v₂) =
                    (r p₂ + r q₂ + r reg1 + r reg1) + M * (u₁ + v₁) := by omega
      have hmod : (r p₁ + r q₁ + r reg2 + r reg2) % M =
                  (r p₂ + r q₂ + r reg1 + r reg1) % M := by
        have h := congrArg (· % M) hcross
        simpa [Nat.add_mul_mod_self_left] using h
      have ⟨hpair1, _⟩ := hb4.cancel_disjoint hreg12 hreg12 hreg12 hreg12 hmod
      have hr_eq : r p₁ + r q₁ = 2 * r reg1 := by
        have hsum := congrArg (Multiset.map r · |>.sum) hpair1
        simpa [two_mul] using hsum
      have hL : L + r t = M * (u₁ + v₁) := by omega
      refine ⟨u₁ + v₁, by have := hpu₁.1; have := hqv₁.1; omega, ?_⟩
      omega
    · rintro ⟨n, hn, rfl⟩
      have hMn : r t ≤ M * n := le_trans (le_of_lt (hb4.lt_M t)) (Nat.le_mul_of_pos_right M (by omega))
      have hp1 : r t < 2 * r reg1 := by have := hb4.pad_pos reg1 reg1 t; omega
      have hp2 : r t < 2 * r reg2 := by have := hb4.pad_pos reg2 reg2 t; omega
      refine ⟨⟨reg1, reg1, 1, n - 1, ⟨le_rfl, Or.inr (Or.inl rfl)⟩,
          ⟨by omega, Or.inr (Or.inl rfl)⟩, ?_⟩,
        ⟨reg2, reg2, 1, n - 1, ⟨le_rfl, Or.inr (Or.inr rfl)⟩,
          ⟨by omega, Or.inr (Or.inr rfl)⟩, ?_⟩⟩
      · have : 1 + (n - 1) = n := by omega
        rw [this]; omega
      · have : 1 + (n - 1) = n := by omega
        rw [this]; omega
  -- Helper: on `L = M * n - r (idx i)` with `n ≥ 2`, `padXX (r (idx p) + r (idx q) - r (idx i))`
  -- matches `L` iff `n ∈ evalUnaryForm A [Sum.inr p, Sum.inr q]`.
  have hbin_iff : ∀ (i p q : Fin m) (n : ℕ), 2 ≤ n →
      (M * n - r (idx i) ∈ evalUnaryForm U (padXX (r (idx p) + r (idx q) - r (idx i))) ↔
       n ∈ evalUnaryForm A [Sum.inr p, Sum.inr q]) := by
    intro i p q n hn
    rw [hpadXX_iff]
    have hMn : r (idx i) ≤ M * n :=
      le_trans (le_of_lt (hb4.lt_M (idx i))) (Nat.le_mul_of_pos_right M (by omega))
    have hpad : r (idx i) < r (idx p) + r (idx q) := hb4.pad_pos (idx p) (idx q) (idx i)
    simp only [evalUnaryForm, mem_ofPred_eq, mem_singleton_iff]
    constructor
    · rintro ⟨p', q', u, v, hpu, hqv, heq⟩
      have heq' : M * n + (r p' + r q') = M * (u + v) + (r (idx p) + r (idx q)) := by omega
      have hmod : (r p' + r q') % M = (r (idx p) + r (idx q)) % M := by
        have h := congrArg (· % M) heq'
        simpa [Nat.mul_add_mod] using h
      have hpair := hb4.sidon hmod
      have hr_eq : r p' + r q' = r (idx p) + r (idx q) := by
        have hsum := congrArg (Multiset.map r · |>.sum) hpair
        simpa using hsum
      have hnuv : n = u + v := by
        have : M * n = M * (u + v) := by omega
        exact Nat.eq_of_mul_eq_mul_left hM_pos this
      have hcases : (p' = idx p ∧ q' = idx q) ∨ (p' = idx q ∧ q' = idx p) := by
        have hmem : p' ∈ ({idx p, idx q} : Multiset (Fin (m + 2))) := by
          rw [← hpair]; simp
        simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hmem
        rcases hmem with rfl | rfl
        · left; refine ⟨rfl, ?_⟩
          have h2 : ({q'} : Multiset (Fin (m + 2))) = {idx q} := by
            have := add_left_cancel (show ({idx p} : Multiset _) + {q'} = {idx p} + {idx q} by
              simpa [Multiset.insert_eq_cons] using hpair)
            exact this
          exact Multiset.singleton_inj.mp h2
        · right; refine ⟨rfl, ?_⟩
          have h2 : ({q'} : Multiset (Fin (m + 2))) = {idx p} := by
            have := add_left_cancel (show ({idx q} : Multiset _) + {q'} = {idx q} + {idx p} by
              simpa [Multiset.insert_eq_cons] using hpair.trans (Multiset.pair_comm (idx p) (idx q)))
            exact this
          exact Multiset.singleton_inj.mp h2
      have hmemA : ∀ (k : Fin m) (w : ℕ), MemIdx (idx k) w → w ∈ A k := by
        intro k w hw
        rcases hw.2 with ⟨j, hj, hAj⟩ | h1 | h2
        · have : j = k := Fin.ext (by simpa [idx] using congrArg Fin.val hj.symm)
          rwa [← this]
        · exact absurd h1 (hidx_ne_reg1 k)
        · exact absurd h2 (hidx_ne_reg2 k)
      rcases hcases with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact ⟨u, hmemA p u hpu, v, ⟨v, hmemA q v hqv, 0, rfl, by omega⟩, hnuv⟩
      · exact ⟨v, hmemA p v hqv, u, ⟨u, hmemA q u hpu, 0, rfl, by omega⟩, by omega⟩
    · rintro ⟨u, hu, w, ⟨v, hv, z, hz, rfl⟩, rfl⟩
      rw [hz, add_zero] at hMn ⊢
      have hu1 : 1 ≤ u := by
        by_contra h0; exact hA_eps p (by rwa [show u = 0 by omega] at hu)
      have hv1 : 1 ≤ v := by
        by_contra h0; exact hA_eps q (by rwa [show v = 0 by omega] at hv)
      refine ⟨idx p, idx q, u, v, ⟨hu1, Or.inl ⟨p, rfl, hu⟩⟩, ⟨hv1, Or.inl ⟨q, rfl, hv⟩⟩, ?_⟩
      zify [hMn, le_of_lt hpad]; ring
  -- Verify `U` is a global solution of `stretchedCollapseGrammar G M r`!
  have hU_sol : ∀ B : Fin 2, U B = evalUnaryRHS (stretchedCollapseGrammar G M r) U B := by
    intro B
    fin_cases B
    · -- Case `B = 0` (`S`): `S → padX (r (idx G.start)) & padX (r reg1)`
      ext L
      simp only [U, S_set, evalUnaryRHS, stretchedCollapseGrammar, evalUnaryRule,
        List.mem_append, List.mem_cons, List.not_mem_nil, or_false, List.mem_map, mem_ofPred_eq]
      constructor
      · rintro ⟨n, hn, rfl⟩
        have hn1 : 1 ≤ n := by
          by_contra h0; exact hA_eps G.start (by rwa [show n = 0 by omega] at hn)
        refine ⟨_, Or.inl (Or.inl rfl), rfl, ?_, by simp⟩
        intro α hα
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
        rcases hα with rfl | rfl <;> rw [evalUnaryForm_padX]
        · have hle : r (idx G.start) ≤ M * n :=
            le_trans (le_of_lt (hb4.lt_M _)) (Nat.le_mul_of_pos_right M hn1)
          refine ⟨M * n - r (idx G.start), ⟨idx G.start, n, ⟨hn1, Or.inl ⟨G.start, rfl, hn⟩⟩, rfl⟩, ?_⟩
          dsimp only [idx] at hle ⊢; omega
        · have hle : r reg1 ≤ M * n :=
            le_trans (le_of_lt (hb4.lt_M _)) (Nat.le_mul_of_pos_right M hn1)
          refine ⟨M * n - r reg1, ⟨reg1, n, ⟨hn1, Or.inr (Or.inl rfl)⟩, rfl⟩, ?_⟩
          dsimp only [reg1] at hle ⊢; omega
      · rintro ⟨rl, hrl, hlhs, hp, _⟩
        have hrl_eq : rl = { lhs := 0, pos := [padX (r (idx G.start)), padX (r reg1)], neg := [] } := by
          rcases hrl with (rfl | rfl | rfl | rfl | rfl) | ⟨rb, _, rfl⟩
          · rfl
          · simp at hlhs
          · simp at hlhs
          · simp at hlhs
          · simp at hlhs
          · cases hbl : rb.baseLen <;> simp [hbl] at hlhs
        subst hrl_eq
        have hp1 := (evalUnaryForm_padX U (r (idx G.start)) L).mp (hp (padX (r (idx G.start))) (by simp))
        have hp2 := (evalUnaryForm_padX U (r reg1) L).mp (hp (padX (r reg1)) (by simp))
        rcases hp1 with ⟨x, ⟨p, u, hpu, rfl⟩, hLx⟩
        rcases hp2 with ⟨y, ⟨q, v, hqv, rfl⟩, hLy⟩
        have hMu : r p ≤ M * u := le_trans (le_of_lt (hb4.lt_M p)) (Nat.le_mul_of_pos_right M hpu.1)
        have hMv : r q ≤ M * v := le_trans (le_of_lt (hb4.lt_M q)) (Nat.le_mul_of_pos_right M hqv.1)
        have heq1 : L + r p = r (idx G.start) + M * u := by zify [hMu] at hLx ⊢; linarith
        have heq2 : L + r q = r reg1 + M * v := by zify [hMv] at hLy ⊢; linarith
        have hcross : (r p + r reg1) + M * v = (r q + r (idx G.start)) + M * u := by omega
        have hmod : (r p + r reg1) % M = (r q + r (idx G.start)) % M := by
          have h := congrArg (· % M) hcross
          simpa [Nat.add_mul_mod_self_left] using h
        have hpair := hb4.sidon hmod
        have hreg1_mem : reg1 ∈ ({q, idx G.start} : Multiset (Fin (m + 2))) := by
          rw [← hpair]; simp
        simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hreg1_mem
        have hq_eq : q = reg1 := by
          rcases hreg1_mem with h1 | h2
          · exact h1.symm
          · exact absurd h2.symm (hidx_ne_reg1 G.start)
        subst hq_eq
        have hp_eq : p = idx G.start := by
          have h1 : ({p} : Multiset (Fin (m + 2))) + {reg1} = {idx G.start} + {reg1} := by
            have hswap : ({reg1, idx G.start} : Multiset (Fin (m + 2))) = {idx G.start, reg1} :=
              Multiset.pair_comm reg1 (idx G.start)
            simpa [Multiset.insert_eq_cons] using hpair.trans hswap
          exact Multiset.singleton_inj.mp (add_right_cancel h1)
        subst hp_eq
        have huA : u ∈ A G.start := by
          rcases hpu.2 with ⟨j, hj, hAj⟩ | h1 | h2
          · have : j = G.start := Fin.ext (by simpa [idx] using congrArg Fin.val hj.symm)
            rwa [← this]
          · exact absurd h1 (hidx_ne_reg1 G.start)
          · exact absurd h2 (hidx_ne_reg2 G.start)
        exact ⟨u, huA, by omega⟩
    · -- Case `B = 1` (`X`): base + reg1/reg2 + translated BNF rules.
      ext L
      simp only [U, X_set, evalUnaryRHS, stretchedCollapseGrammar, evalUnaryRule,
        List.mem_append, List.mem_cons, List.not_mem_nil, or_false, List.mem_map, mem_ofPred_eq]
      constructor
      · rintro ⟨p, u, hpu, rfl⟩
        rcases hpu.2 with ⟨i, rfl, huA⟩ | rfl | rfl
        · -- `u ∈ A i` comes from some rule `rb ∈ G.rules` with `rb.lhs = i`.
          rw [hA_sol i] at huA
          simp only [evalUnaryRHS, UnaryBNFGrammar.toBoolGrammar, List.mem_map, mem_ofPred_eq] at huA
          rcases huA with ⟨_, ⟨rb, hrb, rfl⟩, hlhs, hrule⟩
          have hlhs' : rb.lhs = i := by cases hbl : rb.baseLen <;> simp [UnaryBNFRule.toBoolRule, hbl] at hlhs <;> exact hlhs
          subst hlhs'
          rcases G.wf rb hrb with ⟨c, hc, hbl, _, _⟩ | ⟨hbl, hpos_ne⟩
          · -- Base rule `A_i → a^c`
            simp only [UnaryBNFRule.toBoolRule, hbl, evalUnaryRule, mem_ofPred_eq,
              List.mem_cons, List.not_mem_nil, or_false, forall_eq, evalUnaryForm_padConst] at hrule
            have hu_eq : u = c := hrule.1
            subst hu_eq
            refine ⟨_, Or.inr ⟨rb, hrb, rfl⟩, ?_, ?_, ?_⟩
            · simp [hbl]
            · intro α hα; simp only [hbl, List.mem_cons, List.not_mem_nil, or_false] at hα
              subst hα; exact (evalUnaryForm_padConst U _ _).mpr rfl
            · simp [hbl]
          · -- Binary rule for `A_i`: since `rb.posPairs ≠ []` and `A` is `ε`-free, `u ≥ 2`!
            have hu2 : 2 ≤ u := by
              obtain ⟨pq, hpq⟩ := List.exists_mem_of_ne_nil rb.posPairs hpos_ne
              have hmem := hrule.1 [Sum.inr pq.1, Sum.inr pq.2]
                (by simp only [UnaryBNFRule.toBoolRule, hbl, List.mem_map]; exact ⟨pq, hpq, rfl⟩)
              simp only [evalUnaryForm, mem_ofPred_eq, mem_singleton_iff] at hmem
              rcases hmem with ⟨u₁, hu₁, _, ⟨u₂, hu₂, _, hz, rfl⟩, rfl⟩
              rw [hz, add_zero]
              have h1 : 1 ≤ u₁ := by by_contra h0; exact hA_eps pq.1 (by rwa [show u₁ = 0 by omega] at hu₁)
              have h2 : 1 ≤ u₂ := by by_contra h0; exact hA_eps pq.2 (by rwa [show u₂ = 0 by omega] at hu₂)
              omega
            refine ⟨_, Or.inr ⟨rb, hrb, rfl⟩, by simp [hbl], ?_, ?_⟩
            · intro α hα
              simp only [hbl, List.mem_append, List.mem_cons, List.not_mem_nil, or_false,
                List.mem_map] at hα
              have hgd := (hguard_iff (idx rb.lhs) (M * u - r (idx rb.lhs))).mpr ⟨u, hu2, rfl⟩
              rcases hα with (rfl | rfl) | ⟨pq, hpq, rfl⟩
              · exact hgd.1
              · exact hgd.2
              · rw [hbin_iff rb.lhs pq.1 pq.2 u hu2]
                exact hrule.1 _ (by simp only [UnaryBNFRule.toBoolRule, hbl, List.mem_map]; exact ⟨pq, hpq, rfl⟩)
            · intro β hβ hmem
              simp only [hbl, List.mem_map] at hβ
              rcases hβ with ⟨pq, hpq, rfl⟩
              rw [hbin_iff rb.lhs pq.1 pq.2 u hu2] at hmem
              exact hrule.2 _ (by simp only [UnaryBNFRule.toBoolRule, hbl, List.mem_map]; exact ⟨pq, hpq, rfl⟩) hmem
        · -- `p = reg1`, `u ≥ 1`
          by_cases hu1 : u = 1
          · subst hu1
            refine ⟨_, Or.inl (Or.inr (Or.inl rfl)), rfl, ?_, by simp⟩
            intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
            subst hα; rw [evalUnaryForm_padConst]; simp [reg1]
          · have hu2 : 2 ≤ u := by have := hpu.1; omega
            have hgd := (hguard_iff reg1 (M * u - r reg1)).mpr ⟨u, hu2, rfl⟩
            refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inl rfl)))), rfl, ?_, by simp⟩
            intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
            rcases hα with rfl | rfl
            · have h21 : 2 * r reg1 - r reg1 = r reg1 := by omega
              simpa [h21] using hgd.1
            · exact hgd.2
        · -- `p = reg2`, `u ≥ 1`
          by_cases hu1 : u = 1
          · subst hu1
            refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inl rfl))), rfl, ?_, by simp⟩
            intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
            subst hα; rw [evalUnaryForm_padConst]; simp [reg2]
          · have hu2 : 2 ≤ u := by have := hpu.1; omega
            have hgd := (hguard_iff reg2 (M * u - r reg2)).mpr ⟨u, hu2, rfl⟩
            refine ⟨_, Or.inl (Or.inr (Or.inr (Or.inr (Or.inr rfl)))), rfl, ?_, by simp⟩
            intro α hα; simp only [List.mem_cons, List.not_mem_nil, or_false] at hα
            rcases hα with rfl | rfl
            · have h22 : 2 * r reg2 - r reg2 = r reg2 := by omega
              simpa [h22] using hgd.2
            · exact hgd.1
      · -- Reverse direction: any rule of `X` firing at `L` implies `L ∈ X_set`!
        rintro ⟨rl, hrl, hlhs, hp, hneg⟩
        rcases hrl with (rfl | rfl | rfl | rfl | rfl) | ⟨rb, hrb, rfl⟩
        · simp at hlhs
        · -- `regBase1`
          have hL := (evalUnaryForm_padConst U (M - r reg1) L).mp (hp (padConst (M - r reg1)) (by simp [reg1]))
          exact ⟨reg1, 1, ⟨le_rfl, Or.inr (Or.inl rfl)⟩, by simpa using hL⟩
        · -- `regBase2`
          have hL := (evalUnaryForm_padConst U (M - r reg2) L).mp (hp (padConst (M - r reg2)) (by simp [reg2]))
          exact ⟨reg2, 1, ⟨le_rfl, Or.inr (Or.inr rfl)⟩, by simpa using hL⟩
        · -- `regInd1`
          have hp1 : L ∈ evalUnaryForm U (padXX (2 * r reg1 - r reg1)) := by
            have h21 : 2 * r reg1 - r reg1 = r reg1 := by omega
            rw [h21]; exact hp (padXX (r reg1)) (by simp [reg1])
          have hp2 : L ∈ evalUnaryForm U (padXX (2 * r reg2 - r reg1)) :=
            hp (padXX (2 * r reg2 - r reg1)) (by simp [reg1, reg2])
          rcases (hguard_iff reg1 L).mp ⟨hp1, hp2⟩ with ⟨n, hn, rfl⟩
          exact ⟨reg1, n, ⟨by omega, Or.inr (Or.inl rfl)⟩, rfl⟩
        · -- `regInd2`
          have hp1 : L ∈ evalUnaryForm U (padXX (2 * r reg1 - r reg2)) :=
            hp (padXX (2 * r reg1 - r reg2)) (by simp [reg1, reg2])
          have hp2 : L ∈ evalUnaryForm U (padXX (2 * r reg2 - r reg2)) := by
            have h22 : 2 * r reg2 - r reg2 = r reg2 := by omega
            rw [h22]; exact hp (padXX (r reg2)) (by simp [reg2])
          rcases (hguard_iff reg2 L).mp ⟨hp1, hp2⟩ with ⟨n, hn, rfl⟩
          exact ⟨reg2, n, ⟨by omega, Or.inr (Or.inr rfl)⟩, rfl⟩
        · -- Translated rule from `rb ∈ G.rules`
          rcases G.wf rb hrb with ⟨c, hc, hbl, _, _⟩ | ⟨hbl, _⟩
          · simp only [hbl, List.mem_cons, List.not_mem_nil, or_false, forall_eq,
              evalUnaryForm_padConst] at hp
            have hcA : c ∈ A rb.lhs := by
              rw [hA_sol rb.lhs]
              refine ⟨rb.toBoolRule, List.mem_map.mpr ⟨rb, hrb, rfl⟩, by simp [UnaryBNFRule.toBoolRule, hbl], ?_, ?_⟩
              · simp [UnaryBNFRule.toBoolRule, hbl, evalUnaryForm_padConst]
              · simp [UnaryBNFRule.toBoolRule, hbl]
            exact ⟨idx rb.lhs, c, ⟨hc, Or.inl ⟨rb.lhs, rfl, hcA⟩⟩, hp⟩
          · have hp1 : L ∈ evalUnaryForm U (padXX (2 * r reg1 - r (idx rb.lhs))) :=
              hp (padXX (2 * r reg1 - r (idx rb.lhs))) (by simp [hbl, reg1, idx])
            have hp2 : L ∈ evalUnaryForm U (padXX (2 * r reg2 - r (idx rb.lhs))) :=
              hp (padXX (2 * r reg2 - r (idx rb.lhs))) (by simp [hbl, reg2, idx])
            rcases (hguard_iff (idx rb.lhs) L).mp ⟨hp1, hp2⟩ with ⟨n, hn, rfl⟩
            have hnA : n ∈ A rb.lhs := by
              rw [hA_sol rb.lhs]
              refine ⟨rb.toBoolRule, List.mem_map.mpr ⟨rb, hrb, rfl⟩,
                by simp [UnaryBNFRule.toBoolRule, hbl], ?_, ?_⟩
              · intro α hα
                simp only [UnaryBNFRule.toBoolRule, hbl, List.mem_map] at hα
                rcases hα with ⟨pq, hpq, rfl⟩
                rw [← hbin_iff rb.lhs pq.1 pq.2 n hn]
                exact hp (padXX (r (idx pq.1) + r (idx pq.2) - r (idx rb.lhs)))
                  (by simp only [hbl, List.mem_append, List.mem_cons, List.not_mem_nil, or_false,
                    List.mem_map, idx]; right; exact ⟨pq, hpq, rfl⟩)
              · intro β hβ hmem
                simp only [UnaryBNFRule.toBoolRule, hbl, List.mem_map] at hβ
                rcases hβ with ⟨pq, hpq, rfl⟩
                rw [← hbin_iff rb.lhs pq.1 pq.2 n hn] at hmem
                exact hneg (padXX (r (idx pq.1) + r (idx pq.2) - r (idx rb.lhs)))
                  (by simp only [hbl, List.mem_map, idx]; exact ⟨pq, hpq, rfl⟩) hmem
            exact ⟨idx rb.lhs, n, ⟨by omega, Or.inl ⟨rb.lhs, rfl, hnA⟩⟩, rfl⟩
  exact ⟨strictlyDecreasing_hasStronglyUniqueUnarySol
      (stretchedCollapse_strictlyDecreasing G M r hb4) hU_sol,
    U, hU_sol, rfl⟩

/-- **Corollary of Theorem B3:** For ANY `m`-nonterminal `ε`-free BNF unary Boolean (resp.
conjunctive) grammar `G`, the explicit stretch modulus `M = 5 ^ (m + 3)` admits a 2-nonterminal
unary Boolean (resp. conjunctive) grammar generating `M · L(G)`. -/
theorem exists_stretch_modulus_2nt {m : ℕ} (G : UnaryBNFGrammar m)
    (A : Fin m → Set ℕ) (hA_eps : ∀ i, 0 ∉ A i)
    (hA_sol : ∀ i, A i = evalUnaryRHS G.toBoolGrammar A i) :
    ∃ (M : ℕ) (_ : 1 ≤ M) (G' : BoolGrammar Unit 2),
      (G.toBoolGrammar.IsConjunctive → G'.IsConjunctive) ∧
      GeneratesUnary G' { L | ∃ n ∈ A G.start, L = M * n } := by
  let M := 5 ^ (m + 2 + 1)
  let r : Fin (m + 2) → ℕ := fun i => 5 ^ (m + 2) + 5 ^ i.val
  have hb4 := base5_isValidB4Config (m + 2)
  refine ⟨M, Nat.one_le_pow _ 5 (by omega), stretchedCollapseGrammar G M r,
    stretchedCollapse_isConjunctive G M r,
    stretched_collapse_2nt G M r hb4 A hA_eps hA_sol⟩

end B4SidonAndCollapse


/-! ## Section 5: Theorem B4 — Sharp Optimal 2-NT Complexity of `{4^n}` and `{2^n}` -/

section OptimalTwoNT

/-- The compact `B_4` Sidon offset vector `r = [22, 23, 27, 43]` modulo `M = 256 = 4^4`. -/
def rJez : Fin 4 → ℕ
  | 0 => 22
  | 1 => 23
  | 2 => 27
  | 3 => 43

/-- Proof that `(256, [22, 23, 27, 43])` is a valid `B_4` Sidon configuration mod `256`
(via the mixed-radix structure `[22+0, 22+1, 22+5, 22+21]` with `4*1 < 5`, `4*5 < 21`, `4*43 < 256`). -/
theorem jez_b4_valid : IsValidB4Config 256 rJez := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro i; fin_cases i <;> decide
  · intro i; fin_cases i <;> decide
  · intro p q i; fin_cases p <;> fin_cases q <;> fin_cases i <;> decide
  · intro a b c d a' b' c' d' hmod
    have hr_le : ∀ x : Fin 4, rJez x ≤ 43 := fun x => by fin_cases x <;> decide
    have hlt1 : rJez a + rJez b + rJez c + rJez d < 256 := by
      have := hr_le a; have := hr_le b; have := hr_le c; have := hr_le d; omega
    have hlt2 : rJez a' + rJez b' + rJez c' + rJez d' < 256 := by
      have := hr_le a'; have := hr_le b'; have := hr_le c'; have := hr_le d'; omega
    have heq : rJez a + rJez b + rJez c + rJez d =
               rJez a' + rJez b' + rJez c' + rJez d' := by
      rw [← Nat.mod_eq_of_lt hlt1, ← Nat.mod_eq_of_lt hlt2]; exact hmod
    -- Express `rJez x = 22 + (if x=1 then 1 else 0) + (if x=2 then 5 else 0) + (if x=3 then 21 else 0)`.
    have hsum_eq : ∀ x y z w : Fin 4,
        let S : Multiset (Fin 4) := {x, y, z, w}
        rJez x + rJez y + rJez z + rJez w =
          88 + Multiset.count 1 S + 5 * Multiset.count 2 S + 21 * Multiset.count 3 S ∧
        Multiset.count 0 S + Multiset.count 1 S + Multiset.count 2 S + Multiset.count 3 S = 4 := by
      intro x y z w
      have h1 : ∀ u : Fin 4,
          rJez u = 22 + (if u = (1 : Fin 4) then 1 else 0) +
            5 * (if u = (2 : Fin 4) then 1 else 0) + 21 * (if u = (3 : Fin 4) then 1 else 0) ∧
          (if u = (0 : Fin 4) then 1 else 0) + (if u = (1 : Fin 4) then 1 else 0) +
            (if u = (2 : Fin 4) then 1 else 0) + (if u = (3 : Fin 4) then 1 else 0) = 1 := by
        intro u; fin_cases u <;> decide
      have hx := h1 x; have hy := h1 y; have hz := h1 z; have hw := h1 w
      simp only [multiset_count_quad]
      constructor <;> omega
    have hL := hsum_eq a b c d
    have hR := hsum_eq a' b' c' d'
    have h0 : Multiset.count 0 ({a, b, c, d} : Multiset (Fin 4)) =
              Multiset.count 0 ({a', b', c', d'} : Multiset (Fin 4)) := by omega
    have h1 : Multiset.count 1 ({a, b, c, d} : Multiset (Fin 4)) =
              Multiset.count 1 ({a', b', c', d'} : Multiset (Fin 4)) := by omega
    have h2 : Multiset.count 2 ({a, b, c, d} : Multiset (Fin 4)) =
              Multiset.count 2 ({a', b', c', d'} : Multiset (Fin 4)) := by omega
    have h3 : Multiset.count 3 ({a, b, c, d} : Multiset (Fin 4)) =
              Multiset.count 3 ({a', b', c', d'} : Multiset (Fin 4)) := by omega
    refine Multiset.ext.mpr fun i => ?_
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
    · exact h3

/-- Jeż's 4 languages: `{4^k}`, `{2*4^k}`, `{3*4^k}`, `{6*4^k}`. -/
def jezLang : Fin 4 → Set ℕ
  | 0 => { n | ∃ k : ℕ, n = 4 ^ k }
  | 1 => { n | ∃ k : ℕ, n = 2 * 4 ^ k }
  | 2 => { n | ∃ k : ℕ, n = 3 * 4 ^ k }
  | 3 => { n | ∃ k : ℕ, n = 6 * 4 ^ k }

lemma jezLang_pos (i : Fin 4) {n : ℕ} (hn : n ∈ jezLang i) : 1 ≤ n := by
  fin_cases i <;> rcases hn with ⟨k, rfl⟩ <;>
    have : 1 ≤ 4 ^ k := Nat.one_le_pow k 4 (by omega) <;> omega

lemma pow4_mod4 {k : ℕ} (hk : 1 ≤ k) : 4 ^ k % 4 = 0 := by
  have : k = (k - 1) + 1 := by omega
  rw [this, pow_succ']; simp

/-- Jeż Equation 1 (ALL `n : ℕ`): `(A1 + A3) ∩ (A2 + A2) = { 4^(k+1) | k : ℕ }`. -/
lemma jez_A1_iff (n : ℕ) :
    ((∃ u ∈ jezLang 0, ∃ v ∈ jezLang 2, n = u + v) ∧
     (∃ u ∈ jezLang 1, ∃ v ∈ jezLang 1, n = u + v)) ↔
    ∃ k : ℕ, n = 4 ^ (k + 1) := by
  constructor
  · rintro ⟨⟨_, ⟨a, rfl⟩, _, ⟨b, rfl⟩, rfl⟩, ⟨_, ⟨c, rfl⟩, _, ⟨d, rfl⟩, heq⟩⟩
    -- Factor out `4^m` where `m = min (min a b) (min c d)`.
    let m := min (min a b) (min c d)
    have ha : m ≤ a := le_trans (min_le_left _ _) (min_le_left _ _)
    have hb : m ≤ b := le_trans (min_le_left _ _) (min_le_right _ _)
    have hc : m ≤ c := le_trans (min_le_right _ _) (min_le_left _ _)
    have hd : m ≤ d := le_trans (min_le_right _ _) (min_le_right _ _)
    set a' := a - m; set b' := b - m; set c' := c - m; set d' := d - m
    have hred : 4 ^ a' + 3 * 4 ^ b' = 2 * 4 ^ c' + 2 * 4 ^ d' := by
      have hm_pos : 0 < 4 ^ m := by positivity
      apply Nat.eq_of_mul_eq_mul_left hm_pos
      have h1 : 4 ^ m * (4 ^ a' + 3 * 4 ^ b') = 4 ^ a + 3 * 4 ^ b := by
        rw [mul_add, ← pow_add, show m + a' = a by omega]
        have : 4 ^ m * (3 * 4 ^ b') = 3 * (4 ^ m * 4 ^ b') := by ring
        rw [this, ← pow_add, show m + b' = b by omega]
      have h2 : 4 ^ m * (2 * 4 ^ c' + 2 * 4 ^ d') = 2 * 4 ^ c + 2 * 4 ^ d := by
        have : 4 ^ m * (2 * 4 ^ c' + 2 * 4 ^ d') =
               2 * (4 ^ m * 4 ^ c') + 2 * (4 ^ m * 4 ^ d') := by ring
        rw [this, ← pow_add, ← pow_add, show m + c' = c by omega, show m + d' = d by omega]
      omega
    have hmin0 : a' = 0 ∨ b' = 0 ∨ c' = 0 ∨ d' = 0 := by omega
    have hab0 : a' = 0 ∧ b' = 0 := by
      by_cases ha0 : a' = 0
      · by_cases hb0 : b' = 0
        · exact ⟨ha0, hb0⟩
        · exfalso
          have hb_mod := pow4_mod4 (k := b') (by omega)
          rw [ha0] at hred; omega
      · by_cases hb0 : b' = 0
        · exfalso
          have ha_mod := pow4_mod4 (k := a') (by omega)
          rw [hb0] at hred; omega
        · exfalso
          have ha_mod := pow4_mod4 (k := a') (by omega)
          have hb_mod := pow4_mod4 (k := b') (by omega)
          rcases hmin0 with h | h | hc0 | hd0
          · exact ha0 h
          · exact hb0 h
          · by_cases hd0 : d' = 0
            · rw [hc0, hd0] at hred
              have ha4 : 4 ≤ 4 ^ a' := by
                calc 4 = 4 ^ 1 := by norm_num
                  _ ≤ 4 ^ a' := Nat.pow_le_pow_right (by omega) (by omega)
              have hb4 : 4 ≤ 4 ^ b' := by
                calc 4 = 4 ^ 1 := by norm_num
                  _ ≤ 4 ^ b' := Nat.pow_le_pow_right (by omega) (by omega)
              omega
            · have hd_mod := pow4_mod4 (k := d') (by omega)
              rw [hc0] at hred; omega
          · by_cases hc0 : c' = 0
            · rw [hc0, hd0] at hred
              have ha4 : 4 ≤ 4 ^ a' := by
                calc 4 = 4 ^ 1 := by norm_num
                  _ ≤ 4 ^ a' := Nat.pow_le_pow_right (by omega) (by omega)
              have hb4 : 4 ≤ 4 ^ b' := by
                calc 4 = 4 ^ 1 := by norm_num
                  _ ≤ 4 ^ b' := Nat.pow_le_pow_right (by omega) (by omega)
              omega
            · have hc_mod := pow4_mod4 (k := c') (by omega)
              rw [hd0] at hred; omega
    have ha_eq : a = m := by omega
    have hb_eq : b = m := by omega
    refine ⟨m, ?_⟩
    rw [ha_eq, hb_eq, pow_succ']; ring
  · rintro ⟨k, rfl⟩
    refine ⟨⟨4 ^ k, ⟨k, rfl⟩, 3 * 4 ^ k, ⟨k, rfl⟩, ?_⟩,
            ⟨2 * 4 ^ k, ⟨k, rfl⟩, 2 * 4 ^ k, ⟨k, rfl⟩, ?_⟩⟩
    · rw [pow_succ']; ring
    · rw [pow_succ']; ring

/-- Jeż Equation 2 (ALL `n : ℕ`): `(A1 + A1) ∩ (A6 + A2) = { 2 * 4^(k+1) | k : ℕ }`. -/
lemma jez_A2_iff (n : ℕ) :
    ((∃ u ∈ jezLang 0, ∃ v ∈ jezLang 0, n = u + v) ∧
     (∃ u ∈ jezLang 3, ∃ v ∈ jezLang 1, n = u + v)) ↔
    ∃ k : ℕ, n = 2 * 4 ^ (k + 1) := by
  constructor
  · rintro ⟨⟨_, ⟨a, rfl⟩, _, ⟨b, rfl⟩, rfl⟩, ⟨_, ⟨c, rfl⟩, _, ⟨d, rfl⟩, heq⟩⟩
    let m := min (min a b) (min c d)
    have ha : m ≤ a := le_trans (min_le_left _ _) (min_le_left _ _)
    have hb : m ≤ b := le_trans (min_le_left _ _) (min_le_right _ _)
    have hc : m ≤ c := le_trans (min_le_right _ _) (min_le_left _ _)
    have hd : m ≤ d := le_trans (min_le_right _ _) (min_le_right _ _)
    set a' := a - m; set b' := b - m; set c' := c - m; set d' := d - m
    have hred : 4 ^ a' + 4 ^ b' = 6 * 4 ^ c' + 2 * 4 ^ d' := by
      have hm_pos : 0 < 4 ^ m := by positivity
      apply Nat.eq_of_mul_eq_mul_left hm_pos
      have h1 : 4 ^ m * (4 ^ a' + 4 ^ b') = 4 ^ a + 4 ^ b := by
        rw [mul_add, ← pow_add, ← pow_add, show m + a' = a by omega, show m + b' = b by omega]
      have h2 : 4 ^ m * (6 * 4 ^ c' + 2 * 4 ^ d') = 6 * 4 ^ c + 2 * 4 ^ d := by
        have : 4 ^ m * (6 * 4 ^ c' + 2 * 4 ^ d') =
               6 * (4 ^ m * 4 ^ c') + 2 * (4 ^ m * 4 ^ d') := by ring
        rw [this, ← pow_add, ← pow_add, show m + c' = c by omega, show m + d' = d by omega]
      omega
    have hmin0 : a' = 0 ∨ b' = 0 ∨ c' = 0 ∨ d' = 0 := by omega
    have hcd0 : c' = 0 ∧ d' = 0 := by
      have ha_ne0 : a' ≠ 0 := by
        intro ha0
        by_cases hb0 : b' = 0
        · rw [ha0, hb0] at hred
          have hc1 : 1 ≤ 4 ^ c' := Nat.one_le_pow _ 4 (by omega)
          have hd1 : 1 ≤ 4 ^ d' := Nat.one_le_pow _ 4 (by omega)
          omega
        · have hb_mod := pow4_mod4 (k := b') (by omega)
          rw [ha0] at hred; omega
      have hb_ne0 : b' ≠ 0 := by
        intro hb0
        have ha_mod := pow4_mod4 (k := a') (by omega)
        rw [hb0] at hred; omega
      have ha_mod := pow4_mod4 (k := a') (by omega)
      have hb_mod := pow4_mod4 (k := b') (by omega)
      rcases hmin0 with h | h | hc0 | hd0
      · exact absurd h ha_ne0
      · exact absurd h hb_ne0
      · by_cases hd0 : d' = 0
        · exact ⟨hc0, hd0⟩
        · exfalso; have hd_mod := pow4_mod4 (k := d') (by omega); rw [hc0] at hred; omega
      · by_cases hc0 : c' = 0
        · exact ⟨hc0, hd0⟩
        · exfalso; have hc_mod := pow4_mod4 (k := c') (by omega); rw [hd0] at hred; omega
    have hc_eq : c = m := by omega
    have hd_eq : d = m := by omega
    refine ⟨m, ?_⟩
    rw [heq, hc_eq, hd_eq, pow_succ']; ring
  · rintro ⟨k, rfl⟩
    refine ⟨⟨4 ^ (k + 1), ⟨k + 1, rfl⟩, 4 ^ (k + 1), ⟨k + 1, rfl⟩, by ring⟩,
            ⟨6 * 4 ^ k, ⟨k, rfl⟩, 2 * 4 ^ k, ⟨k, rfl⟩, by rw [pow_succ']; ring⟩⟩

/-- Jeż Equation 3 (ALL `n : ℕ`): `(A1 + A2) ∩ (A6 + A6) = { 3 * 4^(k+1) | k : ℕ }`. -/
lemma jez_A3_iff (n : ℕ) :
    ((∃ u ∈ jezLang 0, ∃ v ∈ jezLang 1, n = u + v) ∧
     (∃ u ∈ jezLang 3, ∃ v ∈ jezLang 3, n = u + v)) ↔
    ∃ k : ℕ, n = 3 * 4 ^ (k + 1) := by
  constructor
  · rintro ⟨⟨_, ⟨a, rfl⟩, _, ⟨b, rfl⟩, rfl⟩, ⟨_, ⟨c, rfl⟩, _, ⟨d, rfl⟩, heq⟩⟩
    let m := min (min a b) (min c d)
    have ha : m ≤ a := le_trans (min_le_left _ _) (min_le_left _ _)
    have hb : m ≤ b := le_trans (min_le_left _ _) (min_le_right _ _)
    have hc : m ≤ c := le_trans (min_le_right _ _) (min_le_left _ _)
    have hd : m ≤ d := le_trans (min_le_right _ _) (min_le_right _ _)
    set a' := a - m; set b' := b - m; set c' := c - m; set d' := d - m
    have hred : 4 ^ a' + 2 * 4 ^ b' = 6 * 4 ^ c' + 6 * 4 ^ d' := by
      have hm_pos : 0 < 4 ^ m := by positivity
      apply Nat.eq_of_mul_eq_mul_left hm_pos
      have h1 : 4 ^ m * (4 ^ a' + 2 * 4 ^ b') = 4 ^ a + 2 * 4 ^ b := by
        have : 4 ^ m * (4 ^ a' + 2 * 4 ^ b') = 4 ^ m * 4 ^ a' + 2 * (4 ^ m * 4 ^ b') := by ring
        rw [this, ← pow_add, ← pow_add, show m + a' = a by omega, show m + b' = b by omega]
      have h2 : 4 ^ m * (6 * 4 ^ c' + 6 * 4 ^ d') = 6 * 4 ^ c + 6 * 4 ^ d := by
        have : 4 ^ m * (6 * 4 ^ c' + 6 * 4 ^ d') =
               6 * (4 ^ m * 4 ^ c') + 6 * (4 ^ m * 4 ^ d') := by ring
        rw [this, ← pow_add, ← pow_add, show m + c' = c by omega, show m + d' = d by omega]
      omega
    have hmin0 : a' = 0 ∨ b' = 0 ∨ c' = 0 ∨ d' = 0 := by omega
    have ha_ne0 : a' ≠ 0 := by
      intro ha0; rw [ha0] at hred; omega
    have hb_ne0 : b' ≠ 0 := by
      intro hb0
      have ha_mod := pow4_mod4 (k := a') (by omega)
      -- `4^a' + 2 = 6*4^c' + 6*4^d'`, so mod 4 forces exactly one of `c', d'` to be 0.
      have hodd_pair : (c' = 0 ∧ 1 ≤ d') ∨ (1 ≤ c' ∧ d' = 0) := by
        by_cases hc0 : c' = 0 <;> by_cases hd0 : d' = 0
        · rw [hb0, hc0, hd0] at hred; omega
        · left; exact ⟨hc0, by omega⟩
        · right; exact ⟨by omega, hd0⟩
        · exfalso
          have hc_mod := pow4_mod4 (k := c') (by omega)
          have hd_mod := pow4_mod4 (k := d') (by omega)
          rw [hb0] at hred; omega
      -- WLOG `4^a' + 2 = 6 + 6*4^e` with `e ≥ 1`, so `4^(a'-1) = 1 + 6*4^(e-1)`, impossible!
      have hno : ∀ e ≥ 1, 4 ^ a' + 2 ≠ 6 + 6 * 4 ^ e := by
        intro e he hbad
        have hdiv : 4 ^ (a' - 1) = 1 + 6 * 4 ^ (e - 1) := by
          have h1 : 4 * 4 ^ (a' - 1) = 4 ^ a' := by
            have : a' = (a' - 1) + 1 := by omega
            conv_rhs => rw [this, pow_succ']
          have h2 : 4 * 4 ^ (e - 1) = 4 ^ e := by
            have : e = (e - 1) + 1 := by omega
            conv_rhs => rw [this, pow_succ']
          omega
        cases ha1 : a' - 1 with
        | zero =>
          rw [ha1] at hdiv
          have : 1 ≤ 4 ^ (e - 1) := Nat.one_le_pow _ 4 (by omega)
          omega
        | succ a2 =>
          rw [ha1, pow_succ'] at hdiv
          cases he1 : e - 1 with
          | zero => rw [he1] at hdiv; omega
          | succ e2 => rw [he1, pow_succ'] at hdiv; omega
      rcases hodd_pair with ⟨hc0, hd1⟩ | ⟨hc1, hd0⟩
      · exact hno d' hd1 (by rw [hb0, hc0] at hred; simpa using hred)
      · exact hno c' hc1 (by rw [hb0, hd0] at hred; linarith)
    have hcd0 : c' = 0 ∧ d' = 0 := by
      have ha_mod := pow4_mod4 (k := a') (by omega)
      have hb_mod := pow4_mod4 (k := b') (by omega)
      rcases hmin0 with h | h | hc0 | hd0
      · exact absurd h ha_ne0
      · exact absurd h hb_ne0
      · by_cases hd0 : d' = 0
        · exact ⟨hc0, hd0⟩
        · exfalso; have hd_mod := pow4_mod4 (k := d') (by omega); rw [hc0] at hred; omega
      · by_cases hc0 : c' = 0
        · exact ⟨hc0, hd0⟩
        · exfalso; have hc_mod := pow4_mod4 (k := c') (by omega); rw [hd0] at hred; omega
    have hc_eq : c = m := by omega
    have hd_eq : d = m := by omega
    refine ⟨m, ?_⟩
    rw [heq, hc_eq, hd_eq, pow_succ']; ring
  · rintro ⟨k, rfl⟩
    refine ⟨⟨4 ^ (k + 1), ⟨k + 1, rfl⟩, 2 * 4 ^ (k + 1), ⟨k + 1, rfl⟩, by ring⟩,
            ⟨6 * 4 ^ k, ⟨k, rfl⟩, 6 * 4 ^ k, ⟨k, rfl⟩, by rw [pow_succ']; ring⟩⟩

/-- Jeż Equation 4 (ALL `n : ℕ`): `(A3 + A3) ∩ (A2 + A1) = { 6 * 4^k | k : ℕ }`. -/
lemma jez_A6_iff (n : ℕ) :
    ((∃ u ∈ jezLang 2, ∃ v ∈ jezLang 2, n = u + v) ∧
     (∃ u ∈ jezLang 1, ∃ v ∈ jezLang 0, n = u + v)) ↔
    ∃ k : ℕ, n = 6 * 4 ^ k := by
  constructor
  · rintro ⟨⟨_, ⟨a, rfl⟩, _, ⟨b, rfl⟩, rfl⟩, ⟨_, ⟨c, rfl⟩, _, ⟨d, rfl⟩, heq⟩⟩
    let m := min (min a b) (min c d)
    have ha : m ≤ a := le_trans (min_le_left _ _) (min_le_left _ _)
    have hb : m ≤ b := le_trans (min_le_left _ _) (min_le_right _ _)
    have hc : m ≤ c := le_trans (min_le_right _ _) (min_le_left _ _)
    have hd : m ≤ d := le_trans (min_le_right _ _) (min_le_right _ _)
    set a' := a - m; set b' := b - m; set c' := c - m; set d' := d - m
    have hred : 3 * 4 ^ a' + 3 * 4 ^ b' = 2 * 4 ^ c' + 4 ^ d' := by
      have hm_pos : 0 < 4 ^ m := by positivity
      apply Nat.eq_of_mul_eq_mul_left hm_pos
      have h1 : 4 ^ m * (3 * 4 ^ a' + 3 * 4 ^ b') = 3 * 4 ^ a + 3 * 4 ^ b := by
        have : 4 ^ m * (3 * 4 ^ a' + 3 * 4 ^ b') =
               3 * (4 ^ m * 4 ^ a') + 3 * (4 ^ m * 4 ^ b') := by ring
        rw [this, ← pow_add, ← pow_add, show m + a' = a by omega, show m + b' = b by omega]
      have h2 : 4 ^ m * (2 * 4 ^ c' + 4 ^ d') = 2 * 4 ^ c + 4 ^ d := by
        have : 4 ^ m * (2 * 4 ^ c' + 4 ^ d') = 2 * (4 ^ m * 4 ^ c') + 4 ^ m * 4 ^ d' := by ring
        rw [this, ← pow_add, ← pow_add, show m + c' = c by omega, show m + d' = d by omega]
      omega
    have hmin0 : a' = 0 ∨ b' = 0 ∨ c' = 0 ∨ d' = 0 := by omega
    have hd_ne0 : d' ≠ 0 := by
      intro hd0
      -- `RHS = 2*4^c' + 1` is odd, so exactly one of `a', b'` is 0.
      have hodd : (a' = 0 ∧ 1 ≤ b') ∨ (1 ≤ a' ∧ b' = 0) := by
        by_cases ha0 : a' = 0 <;> by_cases hb0 : b' = 0
        · rw [ha0, hb0, hd0] at hred; omega
        · left; exact ⟨ha0, by omega⟩
        · right; exact ⟨by omega, hb0⟩
        · exfalso
          have ha_mod := pow4_mod4 (k := a') (by omega)
          have hb_mod := pow4_mod4 (k := b') (by omega)
          rw [hd0] at hred; omega
      have hno : ∀ e ≥ 1, 3 + 3 * 4 ^ e ≠ 2 * 4 ^ c' + 1 := by
        intro e he hbad
        have he_mod := pow4_mod4 (k := e) he
        by_cases hc0 : c' = 0
        · rw [hc0] at hbad; have : 1 ≤ 4 ^ e := Nat.one_le_pow _ 4 (by omega); omega
        · have hc_mod := pow4_mod4 (k := c') (by omega); omega
      rcases hodd with ⟨ha0, hb1⟩ | ⟨ha1, hb0⟩
      · exact hno b' hb1 (by rw [ha0, hd0] at hred; simpa using hred)
      · exact hno a' ha1 (by rw [hb0, hd0] at hred; linarith)
    have hd_mod := pow4_mod4 (k := d') (by omega)
    have hab0 : a' = 0 ∧ b' = 0 := by
      by_cases ha0 : a' = 0
      · by_cases hb0 : b' = 0
        · exact ⟨ha0, hb0⟩
        · exfalso; have hb_mod := pow4_mod4 (k := b') (by omega); rw [ha0] at hred; omega
      · by_cases hb0 : b' = 0
        · exfalso; have ha_mod := pow4_mod4 (k := a') (by omega); rw [hb0] at hred; omega
        · exfalso
          have ha_mod := pow4_mod4 (k := a') (by omega)
          have hb_mod := pow4_mod4 (k := b') (by omega)
          rcases hmin0 with h | h | hc0 | h
          · exact ha0 h
          · exact hb0 h
          · rw [hc0] at hred; omega
          · exact hd_ne0 h
    have ha_eq : a = m := by omega
    have hb_eq : b = m := by omega
    refine ⟨m, ?_⟩
    rw [ha_eq, hb_eq]; ring
  · rintro ⟨k, rfl⟩
    refine ⟨⟨3 * 4 ^ k, ⟨k, rfl⟩, 3 * 4 ^ k, ⟨k, rfl⟩, by ring⟩,
            ⟨2 * 4 ^ k, ⟨k, rfl⟩, 4 ^ (k + 1), ⟨k + 1, rfl⟩, by rw [pow_succ']; ring⟩⟩

/-- Shared rules for the auxiliary nonterminal `X` (`1 : Fin 2`) encoding all 4 Jeż languages
with `M = 256` and `r = [22, 23, 27, 43]`. -/
def jezXRules : List (BoolRule Unit 2) :=
  [ { lhs := 1, pos := [padConst (256 * 1 - rJez 0)], neg := [] }
  , { lhs := 1, pos := [padConst (256 * 2 - rJez 1)], neg := [] }
  , { lhs := 1, pos := [padConst (256 * 3 - rJez 2)], neg := [] }
  , { lhs := 1, pos := [padConst (256 * 6 - rJez 3)], neg := [] }
  , { lhs := 1, pos := [padXX (rJez 0 + rJez 2 - rJez 0), padXX (rJez 1 + rJez 1 - rJez 0)], neg := [] }
  , { lhs := 1, pos := [padXX (rJez 0 + rJez 0 - rJez 1), padXX (rJez 3 + rJez 1 - rJez 1)], neg := [] }
  , { lhs := 1, pos := [padXX (rJez 0 + rJez 1 - rJez 2), padXX (rJez 3 + rJez 3 - rJez 2)], neg := [] }
  , { lhs := 1, pos := [padXX (rJez 2 + rJez 2 - rJez 3), padXX (rJez 1 + rJez 0 - rJez 3)], neg := [] }
  ]

/-- Explicit **2-nonterminal unary conjunctive grammar** generating `{4^n : n ∈ ℕ}`! -/
def grammarFourPow : BoolGrammar Unit 2 where
  rules :=
    [ { lhs := 0, pos := [padConst 1], neg := [] }
    , { lhs := 0, pos := [padConst 4], neg := [] }
    , { lhs := 0, pos := [padConst 16], neg := [] }
    , { lhs := 0, pos := [padConst 64], neg := [] }
    , { lhs := 0, pos := [padConst 256], neg := [] }
    , { lhs := 0, pos := [padXX (rJez 0 + rJez 2), padXX (rJez 1 + rJez 1)], neg := [] }
    ] ++ jezXRules
  start := 0

/-- Explicit **2-nonterminal unary conjunctive grammar** generating `{2^n : n ∈ ℕ}`! -/
def grammarTwoPow : BoolGrammar Unit 2 where
